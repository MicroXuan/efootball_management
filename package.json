{
  "name": "efootball-management",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @efm/api test:e2e",
    "dev:db": "docker compose up -d mysql",
    "dev:db:stop": "docker compose down"
  }
}
