{
  "name": "efootball-management",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @efm/api test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "db:generate": "pnpm --filter @efm/api prisma:generate",
    "db:migrate": "pnpm --filter @efm/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @efm/api exec prisma migrate dev",
    "db:status": "pnpm --filter @efm/api exec prisma migrate status",
    "start:api": "pnpm --filter @efm/api start:dev",
    "player-import:validate": "pnpm --filter @efm/api player-import -- validate",
    "player-import:publish": "pnpm --filter @efm/api player-import -- publish",
    "sync:pesdata": "pnpm --filter @efm/api sync:pesdata --",
    "dev:db": "docker compose up -d mysql",
    "dev:db:stop": "docker compose down"
  }
}
