<view class="page-shell">
  <loading-state wx:if="{{state === 'loading'}}" label="正在加载球队资产" />

  <view wx:elif="{{state === 'error'}}" class="panel error-panel">
    <text>{{errorMessage}}</text>
    <button class="efm-retry-button" bindtap="loadPage">重新加载</button>
  </view>

  <block wx:else>
    <view class="hero">
      <view class="identity-marks">
        <image wx:if="{{assets.teamBadgeUrl}}" class="team-badge" src="{{assets.teamBadgeUrl}}" mode="aspectFit" />
        <view wx:else class="team-badge badge-placeholder">{{assets.teamBadgeText}}</view>
        <image wx:if="{{assets.ownerAvatarUrl}}" class="owner-avatar" src="{{assets.ownerAvatarUrl}}" mode="aspectFill" />
      </view>
      <view class="hero-copy">
        <text class="kicker">球队资产</text>
        <text class="title">{{assets.teamName}}</text>
        <text class="identity">{{assets.identityCopy}}</text>
        <text wx:if="{{assets.divisionCopy}}" class="division">{{assets.divisionCopy}}</text>
        <text wx:if="{{assets.isOwner}}" class="owner-number">微信用户编号 {{assets.ownerPublicUserNo}}</text>
      </view>
    </view>

    <view class="metrics">
      <view class="metric metric--salary {{assets.overCap ? 'metric--over-cap' : ''}}"><text>{{assets.salaryCopy}}</text><label>工资 / 工资帽</label><text wx:if="{{assets.overCap}}" class="metric-warning">已超帽</text></view>
      <view class="metric"><text>{{assets.activePlayerCount}}<text class="metric-suffix">/25</text></text><label>一线人数</label></view>
      <view class="metric"><text>{{assets.playerValueCopy}}</text><label>球员总身价</label></view>
      <view class="metric"><text>{{assets.shellCopy}}</text><label>队壳价值</label></view>
    </view>
    <button wx:if="{{assets.viewerTeamId && assets.seasonId}}" class="transfer-list-link" bindtap="openTransferList">查看我的协商转会 →</button>
    <view wx:if="{{errorMessage}}" class="release-error">{{errorMessage}}</view>

    <view class="roster-head">
      <view>
        <text class="section-index">球员资产</text>
        <text class="section-title">阵容档案</text>
      </view>
      <text class="roster-count">{{rosterPlayers.length}} 人</text>
    </view>

    <view class="roster-tabs efm-equal-tabs">
      <button
        wx:for="{{assets.tabs}}"
        wx:key="key"
        class="roster-tab {{selectedStatus === item.key ? 'is-active' : ''}}"
        data-status="{{item.key}}"
        bindtap="switchRoster"
      >{{item.label}} <text>{{item.count}}</text></button>
    </view>

    <view wx:if="{{!rosterPlayers.length}}" class="panel empty-panel">
      <text class="empty-title">当前分类暂无球员</text>
      <text class="muted">球员状态发生变化后会自动归入对应档案。</text>
    </view>

    <view wx:else class="player-list">
      <view class="player-card" wx:for="{{rosterPlayers}}" wx:key="playerId">
        <view class="player-main">
          <image wx:if="{{item.cardImageUrl}}" class="player-image" src="{{item.cardImageUrl}}" mode="aspectFit" />
          <view wx:else class="player-image image-placeholder">{{item.position || '—'}}</view>
          <view class="player-copy">
            <text class="player-name">{{item.playerName}}</text>
            <text wx:if="{{item.forcedTransferLabel}}" class="forced-transfer-badge">本赛季强报</text>
            <text class="card-copy">{{item.positionCopy}}</text>
            <text class="origin-copy">{{item.originCopy}}</text>
          </view>
          <view class="value-block">
            <text class="value-label">身价</text>
            <text class="value-number">{{item.valueCopy}}</text>
            <text class="value-time">{{item.valuationCopy}}</text>
          </view>
        </view>

        <view class="player-facts">
          <view><label>加入</label><text>{{item.joinedCopy}}</text></view>
          <view><label>年龄</label><text>{{item.ageCopy}}</text></view>
          <view><label>身高</label><text>{{item.heightCopy}}</text></view>
          <view><label>惯用脚</label><text>{{item.footCopy}}</text></view>
          <view><label>AT</label><text>{{item.atCopy}}</text></view>
          <view><label>工资</label><text>{{item.salaryCopy}}</text></view>
        </view>
        <view wx:if="{{assets.isOwner && selectedStatus === 'ACTIVE'}}" class="release-row">
          <text>{{item.releaseEnabled ? '下放后立即释放 1 个阵容名额' : item.releaseDisabledCopy}}</text>
          <button class="release-button" data-ownership-id="{{item.ownershipId}}" data-player-name="{{item.playerName}}" bindtap="confirmRelease" loading="{{releasingOwnershipId === item.ownershipId}}" disabled="{{!item.releaseEnabled || !!releasingOwnershipId}}">下放</button>
        </view>
        <view wx:if="{{assets.isOwner && selectedStatus === 'ACTIVE'}}" class="asset-actions">
          <button class="asset-action" data-ownership-id="{{item.ownershipId}}" data-player-name="{{item.playerName}}" bindtap="confirmDisappearance" disabled="{{!item.disappearanceEnabled || submittingRequest}}">{{item.pendingDisappearance ? '消失申请待审核' : '申请标记消失'}}</button>
          <button class="asset-action" data-player-id="{{item.playerId}}" data-player-name="{{item.playerName}}" bindtap="openTransfer" disabled="{{!item.transferVisible || submittingRequest}}">发起转会</button>
        </view>
        <view wx:if="{{!assets.isOwner && selectedStatus === 'ACTIVE' && item.transferVisible}}" class="asset-actions">
          <button class="asset-action" data-player-id="{{item.playerId}}" data-player-name="{{item.playerName}}" bindtap="openTransfer" disabled="{{submittingRequest}}">协商转会</button>
          <button wx:if="{{item.forcedVisible}}" class="asset-action asset-action--strong" data-player-id="{{item.playerId}}" bindtap="openForcedOffer">发起强报</button>
        </view>
      </view>
    </view>
    <view wx:if="{{transferCandidate}}" class="transfer-shade">
      <view class="transfer-composer">
        <text class="transfer-title">协商转会 · {{transferPlayerName}}</text>
        <text class="transfer-hint">双方确认后仍需管理员终审；申请阶段不会转移球员或扣除资金。</text>
        <text class="transfer-label">转入球队</text>
        <picker range="{{transferTargets}}" range-key="teamName" value="{{transferTargetIndex}}" bindchange="onTransferTargetChange"><view class="transfer-field">{{transferTargets[transferTargetIndex].teamName}} ⌄</view></picker>
        <text class="transfer-label">本次协商报价</text>
        <input class="transfer-field" type="number" value="{{transferAmount}}" placeholder="输入报价" bindinput="onTransferAmountInput" />
        <text class="transfer-label">备注（选填）</text>
        <input class="transfer-field" value="{{transferReason}}" maxlength="512" placeholder="补充协商说明" bindinput="onTransferReasonInput" />
        <view class="transfer-buttons"><button bindtap="closeTransfer" disabled="{{submittingRequest}}">取消</button><button class="transfer-submit" bindtap="submitTransfer" loading="{{submittingRequest}}" disabled="{{!transferAmount || submittingRequest}}">发送给对方确认</button></view>
      </view>
    </view>
  </block>
</view>
