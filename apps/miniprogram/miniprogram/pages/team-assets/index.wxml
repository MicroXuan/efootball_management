<view class="page-shell"><loading-state wx:if="{{state === 'loading'}}" label="正在加载球队资产"/><view wx:elif="{{state === 'error'}}" class="panel"><text>{{errorMessage}}</text><button bindtap="loadPage">重新加载</button></view><block wx:else><view class="hero"><image wx:if="{{assets.ownerAvatarUrl}}" src="{{assets.ownerAvatarUrl}}"/><text class="kicker">球队资产</text><text class="title">{{assets.identity}}</text><text class="muted">{{assets.ownerCopy}}</text></view><view class="metrics"><view><text>{{assets.activePlayerCount}}/25</text><label>一线人数</label></view><view><text>{{assets.shellValueMinor}}</text><label>队壳</label></view><view><text>{{assets.activeSalaryMinor}}</text><label>工资</label></view><view><text>{{assets.totalCopy}}</text><label>总资产</label></view></view><view class="panel"><text>{{assets.completenessCopy}}</text></view><view class="section"><text class="section-title">一线球员</text><view class="row" wx:for="{{assets.active}}" wx:key="playerId"><view><text>{{item.playerName}}</text><text class="muted">{{item.position || '位置缺失'}} · {{item.club || '俱乐部缺失'}} · 工资 {{item.salaryMinor}}</text></view><text>{{item.currentValueMinor === null ? '身价缺失' : item.currentValueMinor}}</text></view></view><view class="section"><text class="section-title">已消失</text><view class="row" wx:for="{{assets.disappeared}}" wx:key="playerId"><text>{{item.playerName}}</text><text class="muted">不计入当前球员总身价</text></view></view><view class="section"><text class="section-title">已退役</text><view class="row" wx:for="{{assets.retired}}" wx:key="playerId"><text>{{item.playerName}}</text><text class="muted">保留历史档案</text></view></view></block></view>
