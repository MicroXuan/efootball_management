page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;padding:54rpx 28rpx 110rpx;background:#0e1417;box-sizing:border-box}.kicker,.muted,label{display:block;color:#9eaaaf;font-size:21rpx}.title{display:block;margin:12rpx 0;font-size:44rpx;font-weight:850}.hero image{width:76rpx;height:76rpx;border-radius:18rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin:28rpx 0}.metrics view,.panel,.row{padding:24rpx;border:1rpx solid #344047;border-radius:20rpx;background:#151d21}.metrics text{font-size:32rpx;font-weight:850}.section{margin-top:38rpx}.section-title{display:block;margin-bottom:14rpx;font-size:29rpx;font-weight:800}.row{display:flex;justify-content:space-between;gap:18rpx;margin-top:10rpx}.panel button{margin-top:18rpx;border-radius:16rpx;background:#b6f13a;color:#111}
