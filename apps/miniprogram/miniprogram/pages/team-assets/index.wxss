page { background: #0e1417; color: #f4f7f8; }
.page-shell { min-height: 100vh; padding: 26rpx 28rpx 120rpx; background: #0e1417; }
.hero { display: flex; align-items: center; padding: 18rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, .2); }
.identity-marks { position: relative; width: 124rpx; height: 124rpx; flex: none; }
.team-badge { width: 112rpx; height: 112rpx; border: 2rpx solid #607741; border-radius: 23rpx; background: #0b1114; box-shadow: 0 0 0 6rpx rgba(182, 241, 58, .06), 0 16rpx 34rpx rgba(0, 0, 0, .3); }
.badge-placeholder { display: flex; align-items: center; justify-content: center; color: #b6f13a; font-size: 42rpx; font-weight: 850; }
.owner-avatar { position: absolute; right: 0; bottom: 0; width: 46rpx; height: 46rpx; box-sizing: border-box; border: 4rpx solid #151d21; border-radius: 15rpx; background: #1c262b; box-shadow: 0 0 0 2rpx #b6f13a; }
.hero-copy { min-width: 0; margin-left: 16rpx; flex: 1; }
.hero-topline { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.hero-name-row { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 5rpx 12rpx; margin-top: 5rpx; }
.kicker { display: block; color: #b6f13a; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }
.title { display: block; min-width: 130rpx; flex: 1 1 130rpx; font-size: 38rpx; font-weight: 850; line-height: 1.18; overflow-wrap: anywhere; }
.identity { display: block; margin-top: 7rpx; color: #dce4e7; font-size: 20rpx; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; white-space: normal; }
.team-directory-link { display: flex; align-items: center; justify-content: center; width: fit-content; min-width: 0; min-height: 42rpx; box-sizing: border-box; margin: 8rpx 0 0; padding: 0 12rpx; border: 1rpx solid #465b35; border-radius: 9rpx; color: #d4ff83; background: #202d1d; font-size: 17rpx; font-weight: 750; line-height: 1.2; }
.team-directory-link::after { border: 0; }
.division { display: inline-block; flex: none; padding: 3rpx 9rpx; border: 1rpx solid #344047; border-radius: 9rpx; color: #aab5ba; background: #11181c; font-size: 16rpx; white-space: nowrap; }
.owner-number { display: block; flex: none; color: #7e8b91; font-size: 16rpx; white-space: nowrap; }
.metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 12rpx; }
.release-error { margin-top: 16rpx; padding: 18rpx 22rpx; border: 2rpx solid #70423f; border-radius: 16rpx; color: #ffaaa3; background: #2b1d1c; font-size: 19rpx; }
.metric { min-width: 0; min-height: 84rpx; box-sizing: border-box; padding: 11rpx 16rpx; border: 2rpx solid #2d393f; border-radius: 16rpx; background: #151d21; }
.metric > text { display: block; font-size: 28rpx; font-weight: 850; line-height: 1.1; overflow-wrap: anywhere; }
.metric--salary { border-color: #546b32; background: #1b281c; }
.metric--salary > text:first-child { color: #d4ff83; font-size: 27rpx; }
.metric--over-cap { border-color: #a45b4f; background: #2a1d1b; }
.metric--over-cap > text:first-child { color: #ffaaa3; }
.metric .metric-warning { margin-top: 8rpx; color: #ffaaa3; font-size: 17rpx; font-weight: 750; }
.metric-suffix { display: inline; margin-left: 4rpx; color: #7e8b91; font-size: 20rpx; }
.metric label { display: block; margin-top: 4rpx; color: #8f9ca2; font-size: 17rpx; }
.roster-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14rpx; margin-top: 28rpx; }
.roster-heading { min-width: 0; flex: 1; }
.roster-title-line { display: flex; align-items: baseline; gap: 12rpx; margin-top: 5rpx; }
.section-index { display: block; color: #b6f13a; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 850; white-space: nowrap; }
.roster-count { color: #8f9ca2; font-size: 18rpx; white-space: nowrap; }
.roster-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-top: 22rpx; padding: 7rpx; border: 2rpx solid #2d393f; border-radius: 20rpx; background: #11181c; }
.roster-tab { border-radius: 14rpx; color: #8f9ca2; background: transparent; font-size: 20rpx; font-weight: 750; }
.roster-tab::after { border: 0; }
.roster-tab text { margin-left: 5rpx; color: #647177; font-size: 18rpx; }
.roster-tab.is-active { color: #111810; background: #b6f13a; }
.roster-tab.is-active text { color: #39451c; }
.player-list { margin-top: 16rpx; }
.player-card { margin-top: 14rpx; overflow: hidden; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, .16); }
.player-main { display: flex; align-items: center; min-height: 158rpx; padding: 22rpx; }
.player-image { width: 100rpx; height: 116rpx; flex: none; border: 2rpx solid #2d393f; border-radius: 17rpx; background: #0b1114; }
.image-placeholder { display: flex; align-items: center; justify-content: center; color: #b6f13a; font-size: 25rpx; font-weight: 850; }
.player-copy { min-width: 0; margin-left: 20rpx; flex: 1; }
.player-name { display: block; overflow: hidden; font-size: 28rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.player-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.player-tag { display: inline-flex; align-items: center; padding: 4rpx 10rpx; border-radius: 8rpx; color: #d8ffd7; background: #167d39; font-size: 18rpx; font-weight: 800; line-height: 1.3; }
.forced-transfer-badge { display: inline-block; margin-top: 8rpx; padding: 5rpx 9rpx; border-radius: 8rpx; color: #f7d84d; background: #423b12; font-size: 16rpx; font-weight: 850; }
.card-copy { display: block; margin-top: 9rpx; overflow: hidden; color: #c0c9cd; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.origin-copy { display: block; margin-top: 7rpx; overflow: hidden; color: #7e8b91; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.value-block { width: 138rpx; margin-left: 14rpx; text-align: right; }
.value-label { display: block; color: #7e8b91; font-size: 17rpx; }
.value-number { display: block; margin-top: 4rpx; color: #b6f13a; font-size: 30rpx; font-weight: 850; }
.value-time { display: block; margin-top: 7rpx; color: #647177; font-size: 15rpx; line-height: 1.35; }
.player-facts { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2rpx solid #2d393f; background: #11181c; }
.player-facts view { min-width: 0; padding: 17rpx 18rpx; border-right: 2rpx solid #273238; border-bottom: 2rpx solid #273238; }
.player-facts view:nth-child(3n) { border-right: 0; }
.player-facts view:nth-last-child(-n+3) { border-bottom: 0; }
.player-facts label { display: block; color: #647177; font-size: 16rpx; }
.player-facts text { display: block; margin-top: 5rpx; overflow: hidden; color: #dce4e7; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.release-disabled { display: block; padding: 0 20rpx 15rpx; color: #829097; background: #151d21; font-size: 17rpx; }
.transfer-list-link { flex: none; min-height: 0; margin: 0 0 2rpx; padding: 4rpx 0; border: 0; color: #c9f381; background: transparent; font-size: 18rpx; font-weight: 750; line-height: 1.3; }
.transfer-list-link::after { border: 0; }
.asset-actions { display: flex; gap: 10rpx; padding: 15rpx 18rpx 18rpx; border-top: 2rpx solid #2d393f; }
.asset-action { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 66rpx; box-sizing: border-box; margin: 0; padding: 0 8rpx; border: 2rpx solid #526c36; border-radius: 13rpx; color: #cfff8b; background: #202d1d; font-size: 19rpx; font-weight: 750; line-height: 1.2; }
.asset-action--release { border-color: #85504c; color: #ffaaa3; background: #30201f; }
.asset-action--strong { border-color: #8b6942; color: #ffd191; background: #30271d; }
.asset-action[disabled] { opacity: .45; }
.disappearance-shade { position: fixed; z-index: 30; inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 36rpx; background: rgba(0,0,0,.76); }
.disappearance-dialog { width: 100%; max-width: 610rpx; box-sizing: border-box; padding: 30rpx; border: 2rpx solid #465b35; border-radius: 24rpx; background: #182126; box-shadow: 0 24rpx 70rpx rgba(0,0,0,.42); }
.disappearance-kicker { display: block; color: #b6f13a; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }
.disappearance-title { display: block; margin-top: 8rpx; color: #f4f7f8; font-size: 30rpx; font-weight: 850; }
.disappearance-player { display: block; margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 12rpx; color: #d4ff83; background: #202d1d; font-size: 23rpx; font-weight: 750; overflow-wrap: anywhere; }
.disappearance-copy { display: block; margin-top: 18rpx; color: #b5c0c4; font-size: 20rpx; line-height: 1.5; }
.disappearance-buttons { display: flex; gap: 12rpx; margin-top: 28rpx; }
.disappearance-buttons button { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 70rpx; box-sizing: border-box; margin: 0; padding: 0 12rpx; border-radius: 12rpx; color: #dce4e7; background: #2c383e; font-size: 20rpx; line-height: 1.2; }
.disappearance-buttons button::after { border: 0; }
.disappearance-buttons .disappearance-submit { color: #172009; background: #b6f13a; font-weight: 800; }
.transfer-shade { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.72); }
.transfer-composer { width: 100%; padding: 34rpx 30rpx 70rpx; border-top: 2rpx solid #50603d; border-radius: 28rpx 28rpx 0 0; background: #151d21; box-sizing: border-box; }
.transfer-title { display: block; color: #dfffad; font-size: 30rpx; font-weight: 850; }
.transfer-player { display: block; margin-top: 12rpx; color: #f4f7f8; font-size: 22rpx; font-weight: 750; overflow-wrap: anywhere; }
.transfer-hint { display: block; margin: 12rpx 0 28rpx; color: #9ba7aa; font-size: 19rpx; line-height: 1.5; }
.transfer-label { display: block; margin: 16rpx 0 9rpx; color: #b6c0c4; font-size: 20rpx; }
.transfer-field { display: block; height: 76rpx; padding: 0 18rpx; border: 2rpx solid #3a484e; border-radius: 14rpx; color: #f4f7f8; background: #0e1417; font-size: 22rpx; line-height: 76rpx; }
.transfer-field--fixed { box-sizing: border-box; height: auto; min-height: 76rpx; line-height: 1.35; padding-top: 22rpx; padding-bottom: 22rpx; color: #d4ff83; overflow-wrap: anywhere; }
.transfer-error { display: block; margin-top: 18rpx; color: #ffaaa3; font-size: 19rpx; line-height: 1.4; }
.transfer-buttons { display: flex; gap: 16rpx; margin-top: 30rpx; }
.transfer-buttons button { display: flex; align-items: center; justify-content: center; flex: 1 1 0; min-width: 0; min-height: 70rpx; box-sizing: border-box; margin: 0; padding: 0 12rpx; color: #dce4e7; background: #2c383e; font-size: 21rpx; line-height: 1.2; }
.transfer-buttons .transfer-submit { color: #172009; background: #b6f13a; font-weight: 800; }
.transfer-buttons .transfer-submit[disabled] { color: #e0e9ed; background: #35434a; opacity: 1; }
.panel { padding: 28rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; }
.empty-panel { margin-top: 16rpx; text-align: center; }
.empty-title { display: block; font-size: 25rpx; font-weight: 800; }
.muted { display: block; margin-top: 8rpx; color: #8f9ca2; font-size: 20rpx; line-height: 1.55; }
.error-panel { margin-top: 22vh; }
.panel button { min-height: 76rpx; margin-top: 18rpx; border-radius: 16rpx; color: #111810; background: #b6f13a; font-size: 22rpx; font-weight: 800; }
