page { background: #0e1417; color: #f4f7f8; }
.page-shell { min-height: 100vh; padding: 42rpx 28rpx 120rpx; background: #0e1417; }
.hero { display: flex; align-items: center; padding: 30rpx; border: 2rpx solid #344047; border-radius: 28rpx; background: #151d21; box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, .2); }
.identity-marks { position: relative; width: 142rpx; height: 142rpx; flex: none; }
.team-badge { width: 118rpx; height: 118rpx; border: 2rpx solid #46545b; border-radius: 28rpx; background: #0b1114; }
.badge-placeholder { display: flex; align-items: center; justify-content: center; color: #b6f13a; font-size: 42rpx; font-weight: 850; }
.owner-avatar { position: absolute; right: 0; bottom: 0; width: 58rpx; height: 58rpx; box-sizing: border-box; border: 5rpx solid #151d21; border-radius: 18rpx; background: #1c262b; box-shadow: 0 0 0 2rpx #b6f13a; }
.owner-avatar-placeholder { display: flex; align-items: center; justify-content: center; color: #111810; background: #b6f13a; font-size: 22rpx; font-weight: 850; }
.hero-copy { min-width: 0; margin-left: 22rpx; flex: 1; }
.kicker { display: block; color: #b6f13a; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }
.title { display: block; margin-top: 10rpx; overflow: hidden; font-size: 42rpx; font-weight: 850; line-height: 1.18; text-overflow: ellipsis; white-space: nowrap; }
.identity { display: block; margin-top: 13rpx; overflow: hidden; color: #dce4e7; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.division { display: inline-block; margin-top: 9rpx; padding: 5rpx 10rpx; border: 1rpx solid #344047; border-radius: 10rpx; color: #aab5ba; background: #11181c; font-size: 17rpx; }
.owner-number { display: block; margin-top: 5rpx; color: #7e8b91; font-size: 19rpx; }
.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }
.metric { min-height: 122rpx; padding: 23rpx 24rpx; border: 2rpx solid #2d393f; border-radius: 22rpx; background: #151d21; }
.metric-primary { border-color: rgba(182, 241, 58, .52); background: #18221d; }
.metric-wide { grid-column: 1 / -1; min-height: 132rpx; }
.metric-wide text { color: #b6f13a; font-size: 42rpx; }
.metric text { display: block; font-size: 33rpx; font-weight: 850; line-height: 1.1; }
.metric-suffix { margin-left: 4rpx; color: #7e8b91; font-size: 20rpx; }
.metric label { display: block; margin-top: 12rpx; color: #8f9ca2; font-size: 19rpx; }
.valuation-status { display: flex; align-items: center; margin-top: 14rpx; padding: 21rpx 24rpx; border: 2rpx solid rgba(232, 189, 101, .28); border-radius: 20rpx; background: rgba(232, 189, 101, .06); }
.valuation-status.is-complete { border-color: rgba(182, 241, 58, .26); background: rgba(182, 241, 58, .05); }
.status-mark { width: 12rpx; height: 12rpx; margin-right: 18rpx; flex: none; border-radius: 50%; background: #e8bd65; }
.is-complete .status-mark { background: #b6f13a; }
.status-title { display: block; font-size: 22rpx; font-weight: 800; }
.status-copy { display: block; margin-top: 5rpx; color: #8f9ca2; font-size: 18rpx; }
.roster-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 52rpx; }
.section-index { display: block; color: #b6f13a; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }
.section-title { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 850; }
.roster-count { padding-bottom: 4rpx; color: #8f9ca2; font-size: 21rpx; }
.roster-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-top: 22rpx; padding: 7rpx; border: 2rpx solid #2d393f; border-radius: 20rpx; background: #11181c; }
.roster-tab { border-radius: 14rpx; color: #8f9ca2; background: transparent; font-size: 20rpx; font-weight: 750; }
.roster-tab::after { border: 0; }
.roster-tab text { margin-left: 5rpx; color: #647177; font-size: 18rpx; }
.roster-tab.is-active { color: #111810; background: #b6f13a; }
.roster-tab.is-active text { color: #39451c; }
.player-list { margin-top: 16rpx; }
.player-card { margin-top: 14rpx; overflow: hidden; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, .16); }
.player-main { display: flex; align-items: center; min-height: 158rpx; padding: 22rpx; }
.player-image { width: 100rpx; height: 116rpx; flex: none; border: 2rpx solid #2d393f; border-radius: 17rpx; background: #0b1114; }
.image-placeholder { display: flex; align-items: center; justify-content: center; color: #b6f13a; font-size: 25rpx; font-weight: 850; }
.player-copy { min-width: 0; margin-left: 20rpx; flex: 1; }
.player-name { display: block; overflow: hidden; font-size: 28rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.card-copy { display: block; margin-top: 9rpx; overflow: hidden; color: #c0c9cd; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.origin-copy { display: block; margin-top: 7rpx; overflow: hidden; color: #7e8b91; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.value-block { width: 138rpx; margin-left: 14rpx; text-align: right; }
.value-label { display: block; color: #7e8b91; font-size: 17rpx; }
.value-number { display: block; margin-top: 4rpx; color: #b6f13a; font-size: 30rpx; font-weight: 850; }
.value-time { display: block; margin-top: 7rpx; color: #647177; font-size: 15rpx; line-height: 1.35; }
.player-facts { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 2rpx solid #2d393f; background: #11181c; }
.player-facts view { min-width: 0; padding: 17rpx 18rpx; border-right: 2rpx solid #273238; border-bottom: 2rpx solid #273238; }
.player-facts view:nth-child(3n) { border-right: 0; }
.player-facts view:nth-last-child(-n+3) { border-bottom: 0; }
.player-facts label { display: block; color: #647177; font-size: 16rpx; }
.player-facts text { display: block; margin-top: 5rpx; overflow: hidden; color: #dce4e7; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.panel { padding: 28rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; }
.empty-panel { margin-top: 16rpx; text-align: center; }
.empty-title { display: block; font-size: 25rpx; font-weight: 800; }
.muted { display: block; margin-top: 8rpx; color: #8f9ca2; font-size: 20rpx; line-height: 1.55; }
.error-panel { margin-top: 22vh; }
.panel button { min-height: 76rpx; margin-top: 18rpx; border-radius: 16rpx; color: #111810; background: #b6f13a; font-size: 22rpx; font-weight: 800; }
