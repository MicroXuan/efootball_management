page { height: 100%; overflow: hidden; background: #091014; color: #f4f7f8; }
.panorama-page { height: 100vh; position: relative; overflow: hidden; background: radial-gradient(circle at 50% 30%, rgba(182,241,58,.07), transparent 34%), #091014; }
.panorama-toolbar { height: 154rpx; box-sizing: border-box; padding: 20rpx 26rpx; position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 22rpx; border-bottom: 1rpx solid #2f3d43; background: rgba(9,16,20,.97); }
.panorama-heading { min-width: 0; }
.panorama-heading text { display: block; }
.panorama-heading__eyebrow { color: #b6f13a; font-size: 16rpx; font-weight: 800; letter-spacing: 3rpx; }
.panorama-heading__title { max-width: 260rpx; margin-top: 7rpx; overflow: hidden; color: #f4f7f8; font-size: 29rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.view-switch { flex: none; display: flex; align-items: center; padding: 5rpx; border: 1rpx solid #344047; border-radius: 14rpx; background: #11191d; }
.view-switch button { height: 58rpx; margin: 0; padding: 0 18rpx; border: 0; border-radius: 10rpx; background: transparent; color: #7e8b91; font-size: 18rpx; font-weight: 800; line-height: 58rpx; }
.view-switch button::after { border: 0; }
.view-switch button.is-active { background: #27341b; color: #c9f66c; box-shadow: inset 0 0 0 1rpx #5f7d2a; }
.route-shell { height: calc(100vh - 154rpx); }
.route-tools { height: 104rpx; box-sizing: border-box; padding: 16rpx 26rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #263339; background: #0d1519; }
.route-tools > view text { display: block; }
.route-tools > view text:first-child { color: #dfe6e8; font-size: 20rpx; font-weight: 800; }
.route-tools > view text:last-child { margin-top: 4rpx; color: #718087; font-size: 15rpx; }
.mine-toggle { height: 58rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #46545b; border-radius: 30rpx; background: transparent; color: #aab5ba; font-size: 17rpx; line-height: 56rpx; }
.mine-toggle::after { border: 0; }
.mine-toggle.is-active { border-color: #b6f13a; color: #b6f13a; background: rgba(182,241,58,.08); }
.route-viewport { height: calc(100% - 104rpx); }
.route-content { padding: 28rpx 24rpx 0; }
.route-section { position: relative; margin-bottom: 34rpx; padding: 25rpx 22rpx 26rpx; overflow: hidden; border: 1rpx solid #334149; border-radius: 24rpx; background: #121b20; box-shadow: 0 16rpx 42rpx rgba(0,0,0,.18); }
.route-section::before { width: 5rpx; height: 100%; position: absolute; top: 0; left: 0; content: ''; background: #35d9ff; }
.route-section--lower::before { background: #ff9d38; }
.route-section--final { border-color: #536b2b; background: radial-gradient(circle at 100% 0%, rgba(182,241,58,.12), transparent 36%), #151e18; }
.route-section--final::before { background: #b6f13a; }
.route-section__head { display: flex; align-items: center; gap: 16rpx; }
.route-section__badge { width: 52rpx; height: 52rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(53,217,255,.5); border-radius: 50%; color: #72e7ff; background: rgba(53,217,255,.08); font-size: 20rpx; font-weight: 900; }
.route-section--lower .route-section__badge { border-color: rgba(255,157,56,.5); color: #ffb76f; background: rgba(255,157,56,.08); }
.route-section--final .route-section__badge { border-color: #6c8b34; color: #c9f66c; background: rgba(182,241,58,.09); }
.route-section__title text { display: block; }
.route-section__title text:first-child { color: #f4f7f8; font-size: 25rpx; font-weight: 900; }
.route-section__title text:last-child { margin-top: 3rpx; color: #7e8b91; font-size: 15rpx; }
.route-round { margin-top: 24rpx; }
.route-round__head { padding: 0 2rpx 11rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #344047; }
.route-round__head text:first-child { color: #dfe6e8; font-size: 20rpx; font-weight: 800; }
.route-round__head text:last-child { color: #829097; font-size: 15rpx; }
.route-pairings { margin-top: 14rpx; display: flex; flex-direction: column; gap: 14rpx; }
.route-pairing { overflow: hidden; border: 1rpx solid #3b4950; border-radius: 17rpx; background: #192329; }
.route-pairing.is-my-match { border-color: #7ba62d; box-shadow: 0 0 0 1rpx rgba(182,241,58,.12), 0 12rpx 28rpx rgba(0,0,0,.2); }
.route-pairing__meta { height: 40rpx; padding: 0 15rpx; display: flex; align-items: center; justify-content: space-between; color: #718087; background: #141d22; font-size: 14rpx; }
.route-pairing__meta text:last-child { color: #98a5aa; }
.route-team { min-height: 68rpx; box-sizing: border-box; padding: 8rpx 14rpx; display: grid; grid-template-columns: 46rpx minmax(0,1fr) 42rpx; align-items: center; gap: 12rpx; border-top: 1rpx solid #2e3b41; color: #aab5ba; }
.route-team.is-winner { color: #f4f7f8; background: linear-gradient(90deg, rgba(182,241,58,.12), transparent 68%); }
.route-team.is-mine { box-shadow: inset 4rpx 0 #b6f13a; }
.route-team image, .route-team__crest { width: 42rpx; height: 42rpx; border-radius: 10rpx; background: #0e1417; }
.route-team__crest { display: flex; align-items: center; justify-content: center; color: #7e8b91; font-size: 16rpx; }
.route-team__identity { min-width: 0; }
.route-team__identity text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.route-team__identity text:first-child { color: inherit; font-size: 20rpx; font-weight: 800; }
.route-team__identity text:last-child { margin-top: 2rpx; color: #75838a; font-size: 14rpx; }
.route-team__score { color: #f4f7f8; font-size: 24rpx; font-weight: 900; text-align: right; }
.route-team.is-winner .route-team__score { color: #b6f13a; }
.route-advance { height: 64rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #66757b; font-size: 13rpx; }
.route-advance view { width: 1rpx; height: 18rpx; margin-top: 5rpx; background: #526169; }
.route-bottom-space { height: 80rpx; }
.board-shell { height: calc(100vh - 154rpx); }
.board-tools { height: 86rpx; box-sizing: border-box; padding: 10rpx 24rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #263339; background: #0d1519; }
.board-tools > text { color: #7e8b91; font-size: 17rpx; }
.zoom-controls { flex: none; display: flex; align-items: center; overflow: hidden; border: 1rpx solid #46545b; border-radius: 36rpx; background: #151d21; }
.zoom-controls button { min-width: 58rpx; height: 56rpx; margin: 0; padding: 0 14rpx; border-radius: 0; border-left: 1rpx solid #344047; background: transparent; color: #f4f7f8; font-size: 24rpx; font-weight: 800; line-height: 56rpx; }
.zoom-controls button:first-child { border-left: 0; }
.zoom-controls button::after { border: 0; }
.zoom-controls .zoom-controls__reset { min-width: 94rpx; color: #b6f13a; font-size: 17rpx; }
.panorama-viewport { width: 100%; height: calc(100% - 86rpx); overflow: hidden; }
.panorama-mover { position: relative; }
.panorama-board { box-sizing: border-box; padding: 70rpx 80rpx; display: flex; align-items: flex-start; gap: 130rpx; background-image: linear-gradient(rgba(182,241,58,.025) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(182,241,58,.025) 1rpx, transparent 1rpx); background-size: 56rpx 56rpx; }
.board-glow { width: 380rpx; height: 380rpx; position: absolute; top: 210rpx; border-radius: 50%; filter: blur(50rpx); opacity: .12; pointer-events: none; }
.board-glow--left { left: 0; background: #35d9ff; }
.board-glow--right { right: 0; background: #ff9d38; }
.panorama-round { width: 410rpx; flex: none; position: relative; z-index: 1; opacity: .74; }
.panorama-round.is-current { opacity: 1; }
.panorama-round__head { height: 70rpx; box-sizing: border-box; padding: 0 6rpx 16rpx; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 2rpx solid #344047; }
.panorama-round__head text:first-child { font-size: 25rpx; font-weight: 900; }
.panorama-round__head text:last-child { color: #7e8b91; font-size: 17rpx; }
.panorama-round.is-current .panorama-round__head { border-color: #b6f13a; }
.panorama-round.is-current .panorama-round__head text:last-child { color: #b6f13a; }
.panorama-round__pairings { display: flex; flex-direction: column; }
.panorama-pairing { height: 132rpx; position: relative; box-sizing: border-box; border: 1rpx solid #46545b; border-radius: 16rpx; background: rgba(24,34,39,.96); box-shadow: 0 14rpx 34rpx rgba(0,0,0,.28); }
.panorama-pairing.is-my-match { border-color: #b6f13a; }
.panorama-team { height: 65rpx; box-sizing: border-box; padding: 0 14rpx; display: grid; grid-template-columns: 46rpx minmax(0,1fr) 34rpx; align-items: center; gap: 11rpx; border-bottom: 1rpx solid #344047; color: #aab5ba; }
.panorama-team:last-child { border-bottom: 0; }
.panorama-team.is-winner { background: linear-gradient(90deg, rgba(182,241,58,.14), transparent); color: #f4f7f8; }
.panorama-team image, .panorama-team__crest { width: 42rpx; height: 42rpx; border-radius: 10rpx; background: #0e1417; }
.panorama-team__crest { display: flex; align-items: center; justify-content: center; color: #7e8b91; font-size: 16rpx; }
.panorama-team__identity { min-width: 0; }
.panorama-team__identity text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.panorama-team__identity text:first-child { color: inherit; font-size: 19rpx; font-weight: 800; }
.panorama-team__identity text:last-child { margin-top: 2rpx; color: #7e8b91; font-size: 14rpx; }
.panorama-team__score { color: #f4f7f8; font-size: 22rpx; font-weight: 900; text-align: right; }
.panorama-team.is-winner .panorama-team__score { color: #b6f13a; }
.bracket-connector { width: 130rpx; height: 1rpx; position: absolute; top: 65rpx; right: -130rpx; }
.bracket-connector__lead, .bracket-connector__tail { width: 65rpx; height: 2rpx; position: absolute; background: #526169; }
.bracket-connector__lead { left: 0; top: 0; }
.bracket-connector__branch { width: 2rpx; position: absolute; left: 65rpx; background: #526169; }
.bracket-connector__tail { left: 65rpx; }
.panorama-state { height: 100%; padding: 70rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
.panorama-state__code { color: #b6f13a; font-size: 17rpx; letter-spacing: 5rpx; }
.panorama-state__title { margin-top: 18rpx; font-size: 36rpx; font-weight: 900; }
.panorama-state__copy { margin-top: 16rpx; color: #aab5ba; font-size: 22rpx; line-height: 1.6; }
.panorama-state__button { width: 250rpx; margin: 34rpx 0 0; border: 2rpx solid #b6f13a; background: transparent; color: #b6f13a; font-size: 22rpx; }
.panorama-state__button::after { border: 0; }
