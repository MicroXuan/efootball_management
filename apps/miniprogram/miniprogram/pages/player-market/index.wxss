rection:column;align-items:center;justify-content:center;height:86rpx;border:2rpx solid #4f6725;border-radius:16rpx;background:#1b3020;color:#b6f13a;font-size:17rpx;font-weight:800}.rating{font-size:29rpx}.player-main{min-width:0}.name-row{display:flex;align-items:center;gap:10rpx}.player-name,.notice-player{display:block;overflow:hidden;font-size:26rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.forced-badge,.notice-kind{padding:5rpx 9rpx;border-radius:8rpx;background:#453e12;color:#f6d446;font-size:16rpx;font-weight:900}.player-meta,.price{margin-top:8rpx;font-size:18rpx}.price{display:block;color:#b6f13a;font-weight:850}.action-block{display:flex;align-items:center;align-self:center;gap:8rpx;color:#8d9aa0}.action-label{max-width:112rpx;font-size:18rpx;font-weight:800;text-align:right}.action-label.is-ready,.arrow{color:#b6f13a}.arrow{font-size:38rpx}.owner-row{grid-column:1/-1;display:flex;align-items:center;gap:13rpx;padding-top:18rpx;border-top:2rpx solid #29353a}.crest{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;overflow:hidden;border-radius:14rpx;background:#233036;color:#b6f13a;font-weight:900}.crest image{width:100%;height:100%}.owner-copy{min-width:0}.owner-copy text{display:block;max-width:470rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18rpx}.owner-row--free{color:#89979e;font-size:18rpx}.application-head{display:flex;justify-content:space-between;gap:18rpx}.application-head>view{min-width:0}.application-status,.notice-price{display:block;color:#b6f13a;font-size:20rpx;font-weight:900;text-align:right}.team-line{display:block;margin-top:16rpx;color:#b8c2c7;font-size:19rpx}.timeline{margin-top:18rpx;padding-left:18rpx;border-left:3rpx solid #4c5e66}.timeline-row{display:flex;justify-content:space-between;gap:20rpx;padding:9rpx 0;color:#95a3aa;font-size:17rpx}.notice-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12rpx}.notice-kind{display:inline-block;margin-botto