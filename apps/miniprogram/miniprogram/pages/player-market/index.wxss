page {
  background: #0e1417;
  color: #f4f7f8;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 24rpx 120rpx;
  background: radial-gradient(circle at 90% 0, rgba(182, 241, 58, 0.1), transparent 30%), #0e1417;
}

.market-head {
  padding: 20rpx 22rpx;
  border: 2rpx solid #35434a;
  border-radius: 20rpx;
  background: #151d21;
}

.eyebrow,
.page-copy,
.player-meta,
.owner-copy text + text,
.notice-message,
.notice-time,
.state-copy {
  display: block;
  color: #95a3aa;
}

.eyebrow { font-size: 16rpx; font-weight: 800; letter-spacing: 4rpx; }
.page-title { display: block; margin-top: 7rpx; font-size: 38rpx; font-weight: 950; }
.page-copy { margin-top: 8rpx; font-size: 18rpx; }

.view-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  width: 100%;
  box-sizing: border-box;
  gap: 4rpx;
  margin: 14rpx 0;
  padding: 5rpx;
  overflow: hidden;
  border: 2rpx solid #303d43;
  border-radius: 18rpx;
  background: #11191d;
}

.view-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 60rpx;
  box-sizing: border-box;
  justify-self: stretch;
  margin: 0;
  padding: 0 2rpx;
  overflow: hidden;
  border: 0;
  border-radius: 12rpx;
  color: #89979e;
  background: transparent;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.view-tab.is-active { color: #efffcf; background: #1d2922; box-shadow: inset 0 0 0 2rpx #8fbd35; }

.filters,
.state-card {
  padding: 16rpx;
  border: 2rpx solid #303d43;
  border-radius: 18rpx;
  background: #151d21;
}

.search-row { display: grid; grid-template-columns: minmax(0, 1fr) 132rpx; gap: 10rpx; }
.search-row input {
  min-width: 0;
  height: 64rpx;
  box-sizing: border-box;
  flex: 1;
  padding: 0 18rpx;
  border: 2rpx solid #3a484f;
  border-radius: 16rpx;
  background: #10171a;
  color: #f4f7f8;
  font-size: 18rpx;
  line-height: 1.2;
}
.search-placeholder { color: #6f7d83; font-size: 18rpx; }

.search-button,
.outline-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #b6f13a;
  color: #0e1417;
  font-size: 18rpx;
  font-weight: 900;
}
.search-button { height: 64rpx; }

.picker-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 10rpx; }
.filter-picker { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; padding: 0 16rpx; border: 2rpx solid #303d43; border-radius: 14rpx; color: #aab5ba; font-size: 18rpx; }
.card-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 14rpx; }
.result-summary { display: flex; align-items: center; justify-content: space-between; padding: 0 6rpx; color: #819097; font-size: 17rpx; }

.player-card,
.application-card,
.notice-card {
  position: relative;
  padding: 24rpx;
  border: 2rpx solid #344047;
  border-radius: 22rpx;
  background: #151d21;
}

.player-card { display: grid; grid-template-columns: 92rpx minmax(0, 1fr) auto; gap: 18rpx; }
.player-artwork { position: relative; width: 92rpx; align-self: start; overflow: hidden; border-radius: 16rpx; }
.player-artwork entity-artwork { width: 100%; }
.artwork-rating { position: absolute; right: 0; bottom: 0; left: 0; display: flex; align-items: baseline; justify-content: center; gap: 5rpx; padding: 13rpx 4rpx 7rpx; color: #efffcf; background: linear-gradient(transparent, rgba(8, 13, 15, 0.94)); font-size: 14rpx; font-weight: 850; }
.rating { font-size: 23rpx; }
.player-main { min-width: 0; }
.name-row { display: flex; align-items: center; gap: 10rpx; }
.player-name,
.notice-player { display: block; overflow: hidden; font-size: 26rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.forced-badge,
.notice-kind { padding: 5rpx 9rpx; border-radius: 8rpx; background: #453e12; color: #f6d446; font-size: 16rpx; font-weight: 900; }
.player-meta,
.price { margin-top: 8rpx; font-size: 18rpx; }
.price { display: block; color: #b6f13a; font-weight: 850; }
.action-block { display: flex; align-items: center; align-self: center; gap: 8rpx; color: #8d9aa0; }
.action-label { max-width: 112rpx; font-size: 18rpx; font-weight: 800; text-align: right; }
.action-label.is-ready,
.arrow { color: #b6f13a; }
.arrow { font-size: 38rpx; }

.profile-facts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8rpx 14rpx; min-width: 0; }
.profile-fact { padding: 6rpx 10rpx; border-radius: 8rpx; color: #b7c3c7; background: #202b2f; font-size: 17rpx; line-height: 1.4; white-space: nowrap; }

.owner-row { grid-column: 1 / -1; display: flex; align-items: center; gap: 13rpx; padding-top: 18rpx; border-top: 2rpx solid #29353a; }
.crest { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; overflow: hidden; border-radius: 14rpx; background: #233036; color: #b6f13a; font-weight: 900; }
.crest image { width: 100%; height: 100%; }
.owner-copy { min-width: 0; }
.owner-copy text { display: block; max-width: 470rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18rpx; }
.owner-row--free { color: #89979e; font-size: 18rpx; }
.application-head { display: flex; justify-content: space-between; gap: 18rpx; }
.application-head > view { min-width: 0; }
.application-status,
.notice-price { display: block; color: #b6f13a; font-size: 20rpx; font-weight: 900; text-align: right; }
.team-line { display: block; margin-top: 16rpx; color: #b8c2c7; font-size: 19rpx; }
.timeline { margin-top: 18rpx; padding-left: 18rpx; border-left: 3rpx solid #4c5e66; }
.timeline-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 9rpx 0; color: #95a3aa; font-size: 17rpx; }
.notice-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12rpx; }
.notice-heading { min-width: 0; }
.notice-kind { display: inline-block; margin-bottom: 9rpx; }
.notice-teams { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) 30rpx minmax(0, 1fr); align-items: center; gap: 8rpx; padding: 16rpx 0; border-top: 2rpx solid #29353a; border-bottom: 2rpx solid #29353a; }
.notice-team { display: flex; align-items: center; min-width: 0; gap: 9rpx; }
.notice-crest { display: flex; flex: none; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; overflow: hidden; border-radius: 12rpx; background: #233036; color: #b6f13a; font-size: 20rpx; font-weight: 900; }
.notice-crest image { width: 100%; height: 100%; }
.notice-team-copy { display: flex; flex-direction: column; min-width: 0; }
.notice-team-copy text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice-team-number { color: #b6f13a; font-size: 16rpx; font-weight: 900; }
.notice-team-name { color: #f4f7f8; font-size: 18rpx; font-weight: 850; }
.notice-owner { color: #95a3aa; font-size: 16rpx; }
.notice-arrow { color: #b6f13a; font-size: 25rpx; font-weight: 900; text-align: center; }
.notice-message,
.notice-time { grid-column: 1 / -1; font-size: 18rpx; }
.state-card { margin-top: 24rpx; text-align: center; }
.state-title { display: block; font-size: 28rpx; font-weight: 900; }
.state-copy { margin: 12rpx 0 22rpx; font-size: 20rpx; }
.outline-button { width: 100%; height: 72rpx; }
.market-list-footer { padding: 16rpx 0 4rpx; color: #819097; font-size: 18rpx; text-align: center; }
.back-to-top { position: fixed; right: 28rpx; bottom: calc(38rpx + env(safe-area-inset-bottom)); z-index: 20; display: flex; align-items: center; justify-content: center; gap: 7rpx; min-width: 112rpx; height: 66rpx; padding: 0 18rpx; box-sizing: border-box; border: 2rpx solid #8fbd35; border-radius: 34rpx; color: #efffcf; background: rgba(24, 35, 30, 0.96); box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.34); font-size: 18rpx; font-weight: 900; }
.back-to-top-arrow { color: #b6f13a; font-size: 26rpx; line-height: 1; }
