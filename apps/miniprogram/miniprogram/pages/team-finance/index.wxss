page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;padding:54rpx 28rpx 110rpx;background:#0e1417;box-sizing:border-box}.kicker,.muted,label{display:block;color:#9eaaaf;font-size:21rpx}.title{display:block;margin:12rpx 0;font-size:44rpx;font-weight:850}.notice{display:block;color:#b6f13a}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:28rpx 0}.metrics view,.panel,.entry{padding:23rpx;border:1rpx solid #344047;border-radius:20rpx;background:#151d21}.metrics text{font-size:27rpx;font-weight:850}.section-title{margin:38rpx 0 14rpx;font-size:29rpx;font-weight:800}.entry{display:flex;justify-content:space-between;margin-top:10rpx}.amount{color:#b6f13a;font-weight:800}.debit{color:#ff9c8e}.panel button{margin-top:18rpx;border-radius:16rpx;background:#b6f13a;color:#111}
