<view class="page-shell"><loading-state wx:if="{{state === 'loading'}}" label="正在加载球队财务"/><view wx:elif="{{state === 'error'}}" class="panel"><text>{{errorMessage}}</text><button bindtap="loadPage">重新加载</button></view><block wx:else><view class="hero"><text class="kicker">球队财务</text><text class="title">实时收支</text><text class="notice">{{finance.notice}}</text></view><view class="metrics"><view><text>+{{finance.creditTotalMinor}}</text><label>收入</label></view><view><text>-{{finance.debitTotalMinor}}</text><label>支出</label></view><view><text>{{finance.balanceCopy}}</text><label>实时余额</label></view></view><view wx:if="{{finance.seasonId === null}}" class="panel">历史未归档 · {{finance.uncategorizedEntryCount}} 条</view><view class="section-title">结算明细</view><view wx:if="{{!finance.entries.length}}" class="panel">暂无财务明细</view><view class="entry" wx:for="{{finance.entries}}" wx:key="id"><view><text>{{item.typeLabel}}</text><text class="muted">{{item.note}}</text></view><text class="amount {{item.direction === 'DEBIT' ? 'debit' : ''}}">{{item.amountCopy}}</text></view></block></view>
