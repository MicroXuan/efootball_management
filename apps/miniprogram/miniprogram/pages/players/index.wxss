page { background: #0e1417; color: #f4f7f8; }

.catalog-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 12rpx) 26rpx calc(env(safe-area-inset-bottom) + 44rpx);
  background:
    radial-gradient(circle at 8% 0%, rgba(182, 241, 58, 0.12), transparent 28%),
    #0e1417;
}

.catalog-controls {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) 112rpx;
  gap: 12rpx;
}

.search-box {
  grid-column: 1 / -1;
  height: 78rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border: 2rpx solid #344047;
  border-radius: 16rpx;
  background: #151d21;
}
.search-icon { padding: 0 16rpx 2rpx 20rpx; color: #b6f13a; font-size: 36rpx; }
.search-box input { height: 76rpx; min-width: 0; flex: 1; color: #f4f7f8; font-size: 25rpx; }
.search-placeholder { color: #7e8b91; }

.filter-selector {
  height: 68rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  overflow: hidden;
  border: 2rpx solid #3d4a50;
  border-radius: 16rpx;
  background: #1c262b;
  color: #f4f7f8;
  font-size: 21rpx;
  font-weight: 700;
}
.filter-selector > text:first-child,
.selector-value { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selector-chevron { margin-left: 8rpx; flex: none; color: #b6f13a; font-size: 26rpx; }
.reset-filter {
  width: 100%;
  height: 68rpx;
  min-height: 68rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 2rpx solid #5c7425;
  border-radius: 16rpx;
  background: #202b20;
  color: #b6f13a;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}
.reset-filter::after { border: 0; }
.pack-error { display: block; margin-top: 10rpx; color: #d9ba79; font-size: 20rpx; }

.group-list { margin-top: 24rpx; }
.card-group { margin-top: 44rpx; }
.card-group:first-child { margin-top: 0; }
.group-head { margin-bottom: 22rpx; padding-bottom: 14rpx; display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2rpx solid #344047; }
.group-title { font-size: 31rpx; font-weight: 800; }
.group-count { color: #7e8b91; font-family:inherit; font-size: 17rpx; letter-spacing: 2rpx; }
.card-grid { display: grid; grid-template-columns: repeat(3, 218rpx); gap: 30rpx 20rpx; justify-content: space-between; }
.card-cell { position: relative; width: 218rpx; }

.catalog-state { min-height: 520rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
.state-code { color: #aab5ba; font-size: 17rpx; letter-spacing: 4rpx; }
.state-title { margin-top: 20rpx; font-size: 34rpx; font-weight: 800; }
.state-copy, .inline-error { margin-top: 16rpx; color: #aab5ba; font-size: 23rpx; line-height: 1.65; }
.retry-button { min-height: 88rpx; margin: 30rpx 0 0; padding: 0 32rpx; border: 2rpx solid #344047; border-radius: 16rpx; background: #1c262b; color: #f4f7f8; font-size: 24rpx; }
.retry-button::after, .retry-link::after { border: 0; }
.retry-link { margin: 8rpx 0 0; padding: 0; background: transparent; color: #b6f13a; font-size: 23rpx; text-align: left; }
.list-end { display: block; padding: 48rpx 0 20rpx; color: #536159; font-size: 20rpx; text-align: center; }
