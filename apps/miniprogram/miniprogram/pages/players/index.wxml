<view class="catalog-page">
  <view wx:if="{{!authenticated}}" class="catalog-state">
    <text class="state-code">登录后可见</text>
    <text class="state-title">登录后查看球员卡</text>
    <text class="state-copy">球员库只对已登录用户开放。</text>
    <button class="retry-button efm-retry-button" bindtap="goToLogin">去登录</button>
  </view>

  <block wx:else>
  <view class="catalog-controls">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input
        value="{{keyword}}"
        placeholder="搜索中文名、英文名或卡片"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
      />
    </view>
    <picker mode="selector" range="{{positionOptions}}" range-key="label" value="{{positionIndex}}" bindchange="onPositionChange">
      <view class="filter-selector"><text>{{positionOptions[positionIndex].label}}</text><text class="selector-chevron">⌄</text></view>
    </picker>
    <picker mode="selector" range="{{packOptions}}" range-key="label" value="{{packIndex}}" bindchange="onPackChange">
      <view class="filter-selector"><text class="selector-value">{{packOptions[packIndex].label}}</text><text class="selector-chevron">⌄</text></view>
    </picker>
    <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="filter-selector"><text class="selector-value">{{typeOptions[typeIndex].label}}</text><text class="selector-chevron">⌄</text></view>
    </picker>
    <view class="reset-filter" role="button" aria-label="重置筛选" bindtap="resetFilters"><text>重置</text></view>
  </view>
  <text wx:if="{{packErrorMessage}}" class="pack-error">{{packErrorMessage}}</text>

  <loading-state wx:if="{{loading && cards.length === 0}}" label="正在检索球员档案" />

  <view wx:elif="{{errorMessage && cards.length === 0}}" class="catalog-state">
    <text class="state-code">离线 · 可重试</text>
    <text class="state-title">暂时无法读取球员库</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="retry-button efm-retry-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{!loading && cards.length === 0}}" class="catalog-state">
    <text class="state-code">无匹配结果</text>
    <text class="state-title">没有找到符合条件的球员</text>
    <text class="state-copy">调整名称或筛选条件后再试。</text>
  </view>

  <view wx:else class="group-list">
    <view wx:for="{{groups}}" wx:key="id" class="card-group">
      <view class="group-head">
        <text class="group-title">{{item.title}}</text>
        <text class="group-count">{{item.cards.length}} 张卡片</text>
      </view>
      <view class="card-grid">
        <view wx:for="{{item.cards}}" wx:for-item="card" wx:key="id" class="card-cell">
          <player-card card="{{card}}" bind:cardtap="onCardTap" />
        </view>
      </view>
    </view>
    <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}} · 点击重试</text>
    <button wx:if="{{errorMessage}}" class="retry-link efm-retry-button" bindtap="retry">重新加载</button>
    <loading-state wx:if="{{loadingMore}}" label="继续加载" />
    <text wx:elif="{{!hasMore}}" class="list-end">— 已显示全部球员卡 —</text>
  </view>
  </block>
</view>
