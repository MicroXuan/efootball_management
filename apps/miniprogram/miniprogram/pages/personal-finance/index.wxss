page { background:#0e1417; color:#f4f7f8; }
.page-shell { min-height:100vh; padding:42rpx 28rpx 120rpx; box-sizing:border-box; background:#0e1417; }
.section-index { display:block; color:#b6f13a; font-size:17rpx; font-weight:750; letter-spacing:2rpx; }
.section-title { display:block; margin-top:8rpx; font-size:34rpx; font-weight:850; }
.personal-card { margin-top: 0; padding: 26rpx; border: 2rpx solid #516737; border-radius: 24rpx; background: #17211d; }
.personal-hint, .personal-empty, .personal-entry-note { display: block; margin-top: 12rpx; color: #9eada7; font-size: 19rpx; line-height: 1.45; }
.personal-summary { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; color: #d4e6d0; font-size: 19rpx; }
.personal-summary text { padding: 10rpx 13rpx; border-radius: 10rpx; background: #25332a; }
.personal-form { margin-top: 24rpx; }
.personal-tabs { display: flex; gap: 10rpx; }
.personal-tab { display: flex; flex: 1 1 0; min-width: 0; align-items: center; justify-content: center; height: 64rpx; border: 2rpx solid #425449; border-radius: 12rpx; box-sizing: border-box; color: #bac9be; font-size: 22rpx; }
.personal-tab.is-active { border-color: #b6f13a; background: #b6f13a; color: #111810; font-weight: 800; }
.personal-form input, .personal-date { box-sizing: border-box; width: 100%; min-height: 70rpx; margin-top: 12rpx; padding: 16rpx; border: 2rpx solid #3c4f45; border-radius: 12rpx; background: #101a16; color: #f4f7f8; font-size: 21rpx; }
.personal-actions { display: flex; gap: 10rpx; margin-top: 14rpx; }
.personal-save, .personal-cancel { display: flex; min-width: 0; min-height: 68rpx; align-items: center; justify-content: center; flex: 1 1 0; border-radius: 12rpx; background: #b6f13a; color: #111810; font-size: 21rpx; font-weight: 800; }
.personal-cancel { border: 2rpx solid #5c7060; background: transparent; color: #d1dfd1; }
.personal-save.is-disabled { opacity: .58; }
.personal-entry { margin-top: 14rpx; padding: 18rpx; border: 2rpx solid #344b3b; border-radius: 14rpx; background: #111a16; }
.personal-entry-main { display: flex; justify-content: space-between; gap: 12rpx; font-size: 23rpx; font-weight: 800; }
.personal-entry-main text:first-child { min-width: 0; overflow-wrap: anywhere; }
.personal-entry-main text:last-child { flex: none; color: #b6f13a; }
.personal-entry-main text.is-debit { color: #ff9c8e; }
.personal-entry-actions { display: flex; justify-content: flex-end; gap: 28rpx; margin-top: 12rpx; color: #b6f13a; font-size: 19rpx; }
.personal-error { margin-top: 18rpx; color: #ff9c8e; }
.personal-error view { display: inline-block; margin-left: 18rpx; color: #b6f13a; }
.personal-date { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.personal-date__value { min-width:0; flex:1; }
.personal-date__chevron { width:12rpx; height:12rpx; flex:none; margin-right:4rpx; border-right:3rpx solid #b6f13a; border-bottom:3rpx solid #b6f13a; box-sizing:border-box; transform:rotate(45deg) translateY(-3rpx); }
