page{background:#0a0a0a;color:#f7f8f5}.manage-page{min-height:100vh;box-sizing:border-box;padding:38rpx 28rpx 100rpx;background:linear-gradient(165deg,#0a0a0a,#0d2117 58%,#101611)}.header,.card-head,.league-line,.picker{display:flex;align-items:center;justify-content:space-between}.header{padding:18rpx 0 28rpx;border-bottom:2rpx solid rgba(176,255,0,.24)}.kicker,.terminal-code{display:block;color:#d9e342;font-size:17rpx;letter-spacing:4rpx}.title{display:block;margin-top:9rpx;font-family:inherit;font-size:48rpx;font-weight:800}.text-button,.close-button{margin:0;padding:0;background:transparent;color:#b0ff00;font-size:21rpx}.text-button::after,.close-button::after{border:0}.close-button{font-size:42rpx}.league-line{margin-top:20rpx;padding:20rpx;border-left:6rpx solid #b0ff00;background:rgba(31,65,44,.55);font-size:22rpx}.league-line>text:first-child{color:#b0ff00;font-weight:800}.authority{color:#d9e342;font:700 16rpx inherit;letter-spacing:3rpx}
.form-card,.season-card,.queue-card,.state-card{margin-top:22rpx;padding:27rpx;border:2rpx solid rgba(176,255,0,.2);background:#171917}.section-title,.state-title{display:block;margin-top:8rpx;font-size:31rpx;font-weight:800}.hint,.terminal>text:last-child{display:block;margin-top:12rpx;color:#a0a69d;font-size:20rpx;line-height:1.6}.field{display:block;margin-top:22rpx}.field>text,.capacity-grid text{display:block;margin-bottom:9rpx;color:#a0a69d;font-size:19rpx}.field input,.capacity-grid input,.picker{width:100%;box-sizing:border-box;padding:18rpx;border:2rpx solid rgba(176,255,0,.17);background:#0a0a0a;color:#f7f8f5;font-size:22rpx}.capacity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11rpx;margin-top:20rpx}.capacity-grid input{text-align:center;color:#b0ff00;font-size:28rpx;font-weight:800}.timeline-grid{margin-top:25rpx;padding-top:3rpx;border-top:2rpx dashed rgba(217,227,66,.2)}.primary,.outline{border-radius:20rpx;font-weight:800}.primary::after,.outline::after{border:0}.primary{margin-top:27rpx;background:#b0ff00;color:#0a0a0a}.primary.warning{background:#d9e342}.primary[disabled]{background:#294536;color:#82978a}.outline{border:2rpx solid rgba(176,255,0,.38);background:transparent;color:#b0ff00}.picker{margin-top:20rpx;color:#a0a69d}.picker text{color:#f7f8f5;font-weight:700}.status{padding:10rpx 15rpx;border:2rpx solid rgba(217,227,66,.4);color:#d9e342;font-size:18rpx}.tally{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:20rpx}.tally view{padding:18rpx 10rpx;background:rgba(31,65,44,.62)}.tally text{display:block}.tally text:first-child{color:#b0ff00;font:800 34rpx inherit}.tally text:last-child{margin-top:5rpx;color:#a0a69d;font-size:17rpx}.terminal{margin-top:24rpx;padding:24rpx;border-left:6rpx solid #d9e342;background:#182319}.terminal-title{display:block;margin-top:10rpx;font-size:30rpx;font-weight:800}
.queue-count{color:#b0ff00;font:800 34rpx inherit}.filters{margin-top:20rpx;white-space:nowrap}.filter{display:inline-block;margin-right:10rpx;padding:0 20rpx;border:2rpx solid rgba(176,255,0,.16);border-radius:20rpx;background:#0a0a0a;color:#a0a69d;font-size:19rpx;line-height:62rpx}.filter::after{border:0}.filter.active{border-color:#b0ff00;color:#b0ff00}.entry-row{display:flex;align-items:center;margin-top:14rpx;padding:18rpx 0;border-top:2rpx solid rgba(142,164,151,.12)}.team-mark{width:72rpx;height:72rpx;display:flex;flex:none;align-items:center;justify-content:center;margin-right:16rpx;background:#0a0a0a;color:#b0ff00;font-size:16rpx}.team-mark image{width:58rpx;height:58rpx}.entry-main{min-width:0;flex:1}.team-name,.entry-meta,.decision{display:block}.team-name{font-size:23rpx;font-weight:800}.entry-meta{margin-top:6rpx;color:#a0a69d;font-size:18rpx}.decision{margin-top:6rpx;color:#d9e342;font-size:18rpx}.entry-actions{margin-left:10rpx}.entry-actions button{margin:4rpx 0;padding:0 16rpx;border-radius:20rpx;background:#b0ff00;color:#0a0a0a;font-size:18rpx;line-height:50rpx}.entry-actions button::after{border:0}.entry-actions .reject{background:#42241f;color:#ff9c8e}.empty{padding:60rpx 10rpx;text-align:center;color:#a0a69d;font-size:21rpx}.error{display:block;margin-top:20rpx;color:#ff9c8e;font-size:21rpx;line-height:1.5}.add-season{margin-top:23rpx}.global-error{padding:18rpx;background:#351d1a}.state-card{min-height:300rpx;display:flex;flex-direction:column;justify-content:center}.state-card .outline{margin:22rpx 0 0}
