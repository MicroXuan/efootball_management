page { background:#0e1417; color:#f4f7f8; }.manage-page { min-height:100vh; padding:32rpx 26rpx 100rpx; box-sizing:border-box; background:radial-gradient(circle at 90% 0%,rgba(240,184,75,.13),transparent 26%),#0e1417; }
.hero,.panel-head,.registration,.actions,.score-form { display:flex; align-items:center; justify-content:space-between; }.hero { padding:28rpx; border:2rpx solid #344047; border-radius:24rpx; background:#1c262b; }.kicker { display:block; color:#aab5ba; font-size:17rpx; letter-spacing:4rpx; }.title { display:block; margin:8rpx 0; font-family:inherit; font-size:42rpx; font-weight:800; }.meta,.entry-meta,.empty { display:block; color:#aab5ba; font-size:20rpx; }.edit { min-height:72rpx; margin:0; border:2rpx solid #46545b; border-radius:14rpx; background:#151d21; color:#f4f7f8; font-size:21rpx; }.edit::after,.primary::after,.gold::after,.danger::after,.actions button::after,.match-option::after { border:0; }
.error { display:block; margin-top:20rpx; padding:18rpx; border-radius:12rpx; background:rgba(255,127,120,.08); color:#ffaaa5; font-size:21rpx; }.panel { margin-top:22rpx; padding:26rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; }.panel-title { display:block; margin-top:8rpx; font-size:30rpx; font-weight:800; }.metric { color:#f4f7f8; font-family:inherit; font-size:34rpx; }.primary,.gold { min-height:88rpx; margin-top:24rpx; border-radius: 16rpx; background:#b6f13a; color:#111810; font-size:23rpx; font-weight:800; }.gold { border:2rpx solid #46545b; background:#1c262b; color:#f4f7f8; }.empty { margin-top:22rpx; line-height:1.6; }
.reason { min-height:88rpx; margin-top:22rpx; padding:19rpx; border:2rpx solid #46545b; border-radius:16rpx; background:#1c262b; color:#f4f7f8; font-size:21rpx; }.registration { margin-top:14rpx; padding:18rpx 0; border-top:1rpx solid #2d393f; }.entry-name { display:block; font-size:23rpx; }.entry-meta { max-width:300rpx; margin-top:5rpx; overflow:hidden; text-overflow:ellipsis; }.actions { gap:8rpx; }.actions button { min-height:68rpx; margin:0; padding:0 18rpx; border-radius:14rpx; background:#1c262b; color:#f4f7f8; font-size:19rpx; }.actions .reject { background:rgba(255,127,120,.08); color:#ffaaa5; }
.cancel-reason { margin-top:30rpx; border-color:rgba(255,127,120,.42); }.danger { min-height:88rpx; margin-top:12rpx; border:2rpx solid rgba(255,127,120,.42); border-radius:16rpx; background:rgba(255,127,120,.08); color:#ffaaa5; font-size:22rpx; font-weight:700; }
.round { margin-top:22rpx; }.round-title { color:#aab5ba; font-size:18rpx; letter-spacing:3rpx; }.fixture { display:grid; grid-template-columns:1fr 60rpx 1fr; gap:10rpx; padding:16rpx 0; border-bottom:1rpx solid #2d393f; font-size:20rpx; }.fixture text:last-child { text-align:right; }.versus { color:#7e8b91; text-align:center; }.published { display:block; margin-top:22rpx; color:#b6f13a; text-align:center; }
.match-strip { margin-top:20rpx; white-space:nowrap; }.match-options { display:inline-flex; gap:12rpx; }.match-option { width:230rpx; margin:0; padding:16rpx; border:2rpx solid #344047; border-radius:16rpx; background:#1c262b; color:#aab5ba; font-size:18rpx; text-align:left; white-space:normal; }.match-option text { display:block; margin-top:8rpx; color:#f4f7f8; }.match-option.selected { border-color:#b6f13a; color:#f4f7f8; }.score-form { justify-content:center; gap:18rpx; margin-top:24rpx; }.score-form input { width:150rpx; min-height:88rpx; padding:20rpx; border:2rpx solid #46545b; border-radius:16rpx; background:#1c262b; color:#fff; font-size:28rpx; text-align:center; }.score-form text { color:#aab5ba; font-size:34rpx; }.correction { width:100%; height:120rpx; box-sizing:border-box; }
