page { background:#09100d; color:#f4f7f5; }.manage-page { min-height:100vh; padding:32rpx 26rpx 100rpx; box-sizing:border-box; background:radial-gradient(circle at 90% 0%,rgba(240,184,75,.13),transparent 26%),#09100d; }
.hero,.panel-head,.registration,.actions,.score-form { display:flex; align-items:center; justify-content:space-between; }.hero { padding:28rpx; border:2rpx solid #365744; background:#142219; }.kicker { display:block; color:#66f05a; font-size:17rpx; letter-spacing:4rpx; }.title { display:block; margin:8rpx 0; font-family:STKaiti,KaiTi,serif; font-size:42rpx; font-weight:700; }.meta,.entry-meta,.empty { display:block; color:#829188; font-size:20rpx; }.edit { margin:0; border:1rpx solid #f0b84b; background:transparent; color:#f0b84b; font-size:21rpx; }.edit::after,.primary::after,.gold::after,.danger::after,.actions button::after,.match-option::after { border:0; }
.error { display:block; margin-top:20rpx; padding:18rpx; background:#312719; color:#f0b84b; font-size:21rpx; }.panel { margin-top:22rpx; padding:26rpx; border:2rpx solid #263f32; background:#121a16; }.panel-title { display:block; margin-top:8rpx; font-size:30rpx; font-weight:800; }.metric { color:#f0b84b; font-family:"DIN Alternate",sans-serif; font-size:34rpx; }.primary,.gold { margin-top:24rpx; border-radius:5rpx; background:#66f05a; color:#07110d; font-size:23rpx; font-weight:800; }.gold { background:#f0b84b; }.empty { margin-top:22rpx; line-height:1.6; }
.reason { margin-top:22rpx; padding:19rpx; border:1rpx solid #365744; background:#09100d; color:#f4f7f5; font-size:21rpx; }.registration { margin-top:14rpx; padding:18rpx 0; border-top:1rpx solid #263f32; }.entry-name { display:block; font-size:23rpx; }.entry-meta { max-width:300rpx; margin-top:5rpx; overflow:hidden; text-overflow:ellipsis; }.actions { gap:8rpx; }.actions button { margin:0; padding:0 18rpx; background:#284a34; color:#66f05a; font-size:19rpx; }.actions .reject { background:#392b1b; color:#f0b84b; }
.cancel-reason { margin-top:30rpx; border-color:#59342e; }.danger { margin-top:12rpx; border:1rpx solid #d96656; border-radius:5rpx; background:transparent; color:#ef8b7c; font-size:22rpx; font-weight:700; }
.round { margin-top:22rpx; }.round-title { color:#f0b84b; font-size:18rpx; letter-spacing:3rpx; }.fixture { display:grid; grid-template-columns:1fr 60rpx 1fr; gap:10rpx; padding:16rpx 0; border-bottom:1rpx solid #263f32; font-size:20rpx; }.fixture text:last-child { text-align:right; }.versus { color:#718078; text-align:center; }.published { display:block; margin-top:22rpx; color:#66f05a; text-align:center; }
.match-strip { margin-top:20rpx; white-space:nowrap; }.match-options { display:inline-flex; gap:12rpx; }.match-option { width:230rpx; margin:0; padding:16rpx; border:1rpx solid #294c3a; background:#0c130f; color:#8fa096; font-size:18rpx; text-align:left; white-space:normal; }.match-option text { display:block; margin-top:8rpx; color:#f4f7f5; }.match-option.selected { border-color:#66f05a; color:#66f05a; }.score-form { justify-content:center; gap:18rpx; margin-top:24rpx; }.score-form input { width:150rpx; padding:20rpx; border:1rpx solid #365744; background:#09100d; color:#fff; font-size:28rpx; text-align:center; }.score-form text { color:#f0b84b; font-size:34rpx; }.correction { width:100%; height:120rpx; box-sizing:border-box; }
