page { background: #0e1417; color: #f4f7f8; }
.page-shell { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 28rpx) 28rpx 100rpx; background: radial-gradient(circle at 92% 2%, rgba(182,241,58,.08), transparent 30%), #0e1417; }
.page-head,.league-group,.state-card { margin-top: 22rpx; padding: 30rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; }
.page-head { margin-top: 0; }
.page-kicker,.state-kicker { display:block;color:#aab5ba;font-size:18rpx;font-weight:750;letter-spacing:4rpx; }
.page-title,.state-title { display:block;margin-top:12rpx;font-size:42rpx;font-weight:900; }
.page-copy,.state-copy { display:block;margin-top:14rpx;color:#aab5ba;font-size:21rpx;line-height:1.6; }
.group-head,.auction-card__top { display:flex;align-items:center;justify-content:space-between;gap:16rpx; }
.group-name { font-size:30rpx;font-weight:850; }
.group-count { color:#aab5ba;font-size:18rpx; }
.auction-card { position:relative;min-height:150rpx;margin-top:18rpx;padding:24rpx;border:2rpx solid #2d393f;border-radius:18rpx;background:#1c262b; }
.auction-name { font-size:27rpx;font-weight:850; }
.auction-status { color:#b6f13a;font-size:18rpx;font-weight:800; }
.auction-team,.auction-player,.auction-arrow { display:block;margin-top:12rpx; }
.auction-team { color:#aab5ba;font-size:19rpx; }.auction-player { font-size:23rpx;font-weight:800; }.auction-arrow { color:#b6f13a;font-size:19rpx;font-weight:800;text-align:right; }
.outline-button { min-height:80rpx;margin:24rpx 0 0;border:2rpx solid #344047;border-radius:16rpx;color:#f4f7f8;background:#1c262b;font-size:22rpx; }
