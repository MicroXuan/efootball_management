page { background:#0e1417; color:#f4f7f8; }.matches-page{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 30rpx) 26rpx calc(env(safe-area-inset-bottom) + 48rpx);background:radial-gradient(circle at 85% 0%,rgba(182, 241, 58,.06),transparent 25%),#0e1417}.page-head,.match-head,.versus{display:flex;align-items:center;justify-content:space-between}.kicker{display:block;color:#aab5ba;font-size:17rpx;letter-spacing:5rpx}.title{display:block;margin-top:8rpx;font-family:inherit;font-size:52rpx;font-weight:800}.mark{color:#7e8b91;font-size:17rpx;letter-spacing:2rpx}.match-list{margin-top:34rpx}.match-card{margin-bottom:22rpx;padding:28rpx;border:2rpx solid #344047;border-radius:24rpx;background:#151d21;box-shadow:0 16rpx 44rpx rgba(0,0,0,.18)}.match-head{color:#aab5ba;font-size:20rpx}.planned{display:block;margin-top:12rpx;color:#aab5ba;font-size:19rpx}.versus{margin-top:26rpx;gap:16rpx;font-size:25rpx;font-weight:800}.vs{color:#7e8b91;font-size:17rpx}.score{display:block;margin-top:16rpx;color:#f4f7f8;font-size:36rpx;text-align:center}.action{min-height:84rpx;margin-top:24rpx;border-radius:16rpx;background:#b6f13a;color:#111810;font-size:23rpx;font-weight:800}.action::after{border:0}.action.is-disabled{background:#263238;color:#7e8b91}.state{min-height:520rpx;display:flex;flex-direction:column;justify-content:center;gap:16rpx;color:#aab5ba;font-size:23rpx}.state text:first-child{color:#f4f7f8;font-size:32rpx;font-weight:800}
