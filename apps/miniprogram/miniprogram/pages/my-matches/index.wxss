page { background:#0a0a0a; color:#f7f8f5; }.matches-page{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 30rpx) 26rpx calc(env(safe-area-inset-bottom) + 48rpx);background:radial-gradient(circle at 85% 0%,rgba(176,255,0,.1),transparent 25%),#0a0a0a}.page-head,.match-head,.versus{display:flex;align-items:center;justify-content:space-between}.kicker{display:block;color:#b0ff00;font-size:17rpx;letter-spacing:5rpx}.title{display:block;margin-top:8rpx;font-family:inherit;font-size:52rpx;font-weight:700}.mark{color:#8f968c;font-size:17rpx;letter-spacing:2rpx}.match-list{margin-top:34rpx}.match-card{margin-bottom:22rpx;padding:26rpx;border:2rpx solid #294c3a;border-radius:14rpx;background:#171917}.match-head{color:#a0a69d;font-size:20rpx}.planned{display:block;margin-top:12rpx;color:#d9e342;font-size:19rpx}.versus{margin-top:26rpx;gap:16rpx;font-size:25rpx;font-weight:800}.vs{color:#8f968c;font-size:17rpx}.score{display:block;margin-top:16rpx;color:#b0ff00;font-size:36rpx;text-align:center}.action{margin-top:24rpx;background:#b0ff00;color:#0a0a0a;font-size:23rpx;font-weight:800}.action::after{border:0}.action.is-disabled{background:#24352c;color:#8f968c}.state{min-height:520rpx;display:flex;flex-direction:column;justify-content:center;gap:16rpx;color:#a0a69d;font-size:23rpx}.state text:first-child{color:#f7f8f5;font-size:32rpx;font-weight:800}
