page { background:#0b100e; color:#f5f7f6; }.matches-page{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 30rpx) 26rpx calc(env(safe-area-inset-bottom) + 48rpx);background:radial-gradient(circle at 85% 0%,rgba(102,240,90,.1),transparent 25%),#0b100e}.page-head,.match-head,.versus{display:flex;align-items:center;justify-content:space-between}.kicker{display:block;color:#66f05a;font-size:17rpx;letter-spacing:5rpx}.title{display:block;margin-top:8rpx;font-family:STKaiti,KaiTi,serif;font-size:52rpx;font-weight:700}.mark{color:#718078;font-size:17rpx;letter-spacing:2rpx}.match-list{margin-top:34rpx}.match-card{margin-bottom:22rpx;padding:26rpx;border:2rpx solid #294c3a;border-radius:14rpx;background:#141c18}.match-head{color:#98a69f;font-size:20rpx}.planned{display:block;margin-top:12rpx;color:#f0b84b;font-size:19rpx}.versus{margin-top:26rpx;gap:16rpx;font-size:25rpx;font-weight:800}.vs{color:#718078;font-size:17rpx}.score{display:block;margin-top:16rpx;color:#66f05a;font-size:36rpx;text-align:center}.action{margin-top:24rpx;background:#66f05a;color:#07110d;font-size:23rpx;font-weight:800}.action::after{border:0}.action.is-disabled{background:#24352c;color:#718078}.state{min-height:520rpx;display:flex;flex-direction:column;justify-content:center;gap:16rpx;color:#98a69f;font-size:23rpx}.state text:first-child{color:#f5f7f6;font-size:32rpx;font-weight:800}
