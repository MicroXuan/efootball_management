page { background:#0e1417; color:#f4f7f8; }
.matches-page { min-height:100vh; box-sizing:border-box; padding:calc(env(safe-area-inset-top) + 30rpx) 26rpx calc(env(safe-area-inset-bottom) + 48rpx); background:radial-gradient(circle at 85% 0%,rgba(182,241,58,.06),transparent 25%),#0e1417; }
.page-head,.match-head,.match-meta,.season-picker-row { display:flex; align-items:center; justify-content:space-between; }
.kicker { display:block; color:#aab5ba; font-size:17rpx; letter-spacing:5rpx; }
.title { display:block; margin-top:8rpx; font-size:52rpx; font-weight:800; }
.mark { color:#7e8b91; font-size:17rpx; letter-spacing:2rpx; }
.fixture-filters { margin-top:28rpx; padding:20rpx; overflow:hidden; border:2rpx solid #344047; border-radius:22rpx; background:#151d21; }
.season-picker { display:block; }
.season-picker-row { min-height:82rpx; padding:0 22rpx; border:2rpx solid #344047; border-radius:16rpx; background:#1c262b; color:#aab5ba; font-size:20rpx; }
.season-picker-row text:last-child { color:#f4f7f8; font-size:24rpx; font-weight:750; }
.team-search { width:100%;display:grid;grid-template-columns:minmax(0,1fr) 116rpx;gap:12rpx;margin-top:14rpx; }
.team-search input { box-sizing:border-box; height:78rpx; padding:0 22rpx; border:2rpx solid #344047; border-radius:16rpx; color:#f4f7f8; background:#0e1417; font-size:21rpx; }
.team-search button { width:100%;min-width:0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;height:78rpx;margin:0;padding:0;border:0;border-radius:16rpx;color:#10160f;background:#b6f13a;font-size:21rpx;font-weight:800;line-height:1; }
.team-search button::after,.status-filter::after,.load-more::after,.pagination-error button::after { border:0; }
.status-filter-bar { width:100%;box-sizing:border-box;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6rpx;margin-top:14rpx;padding:6rpx;border:2rpx solid #344047;border-radius:18rpx;background:#0e1417; }
.status-filter { width:100%;min-width:0;box-sizing:border-box;height:62rpx;margin:0;padding:0;border:0;border-radius:13rpx;color:#aab5ba;background:transparent;font-size:19rpx;line-height:62rpx; }
.status-filter-active { color:#111810;background:#b6f13a;font-weight:850; }
.match-list { margin-top:26rpx; }
.match-card { margin-bottom:22rpx; padding:26rpx 22rpx 30rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; box-shadow:0 16rpx 44rpx rgba(0,0,0,.18); }
.match-head { color:#aab5ba; font-size:20rpx; }
.match-head>text:first-child { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.state-tag { flex:none; margin-left:16rpx; color:#b6f13a; font-size:18rpx; font-weight:750; }
.match-meta { margin-top:12rpx; color:#7e8b91; font-size:18rpx; }
.match-meta text:first-child { color:#b6f13a; font-weight:750; }
.fixture-grid { display:grid; grid-template-columns:minmax(0,1fr) 112rpx minmax(0,1fr); align-items:center; margin-top:28rpx; }
.fixture-team { min-width:0; display:flex; flex-direction:column; align-items:center; text-align:center; }
.team-badge { width:82rpx; height:82rpx; border-radius:16rpx; }
.team-identity { width:100%; margin-top:14rpx; overflow:hidden; font-size:23rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.team-owner { width:100%; margin-top:7rpx; overflow:hidden; color:#aab5ba; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }
.fixture-center { height:100%; display:flex; align-items:center; justify-content:center; color:#f4f7f8; font-size:31rpx; font-weight:900; font-variant-numeric:tabular-nums; text-align:center; }
.archived { margin-top:7rpx; color:#ff9c8e; font-size:17rpx; }
.pagination-error { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin:8rpx 0 20rpx; padding:18rpx 20rpx; border:2rpx solid rgba(255,156,142,.4); border-radius:16rpx; color:#ffb5aa; background:rgba(255,156,142,.08); font-size:19rpx; }
.pagination-error button { flex:none; margin:0; padding:0 20rpx; border:0; color:#b6f13a; background:transparent; font-size:19rpx; font-weight:800; line-height:56rpx; }
.load-more { height:76rpx; margin:10rpx 0 0; padding:0; border:2rpx solid #4c5c63; border-radius:18rpx; color:#f4f7f8; background:#1c262b; font-size:21rpx; font-weight:750; line-height:72rpx; }
.outline-button { min-height:80rpx;margin:24rpx 0 0;padding:0 28rpx;border:2rpx solid #344047;border-radius:16rpx;color:#f4f7f8;background:#1c262b;font-size:22rpx; }
@media (max-width:340px) { .team-search { grid-template-columns:minmax(0,1fr) 104rpx; } .fixture-grid { grid-template-columns:minmax(0,1fr) 86rpx minmax(0,1fr); } .team-badge { width:70rpx; height:70rpx; } .team-identity { font-size:20rpx; } .fixture-center { font-size:26rpx; } }
