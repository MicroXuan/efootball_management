<view class="page-shell">
  <view class="directory-head"><text class="kicker">联赛球队</text><text class="title">看看其他球队的阵容</text><text class="subtitle">球队资产公开展示；操作仅限球队负责人。</text></view>
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取联赛球队" />
  <view wx:elif="{{state === 'error'}}" class="state-card"><text>{{errorMessage}}</text><button bindtap="loadPage">重新加载</button></view>
  <block wx:else>
    <input class="team-search" placeholder="搜索编号、球队或负责人" value="{{keyword}}" bindinput="search" />
    <view wx:if="{{!rows.length}}" class="state-card"><text>{{keyword ? '没有符合条件的球队' : '当前联赛暂无现役球队'}}</text></view>
    <view wx:else class="team-list">
      <view wx:for="{{rows}}" wx:key="teamId" class="team-row" data-team-id="{{item.teamId}}" bindtap="openTeam" role="button">
        <image wx:if="{{item.teamLogoUrl}}" class="crest" src="{{item.teamLogoUrl}}" mode="aspectFit" />
        <view wx:else class="crest crest--fallback">{{item.crestFallback}}</view>
        <view class="team-copy"><text class="team-name">{{item.identity}}</text><text class="manager-name">{{item.ownerAlias}}</text></view>
        <view class="team-action"><text>{{item.activePlayerCount}} 人</text><text class="arrow">›</text></view>
      </view>
    </view>
  </block>
</view>
