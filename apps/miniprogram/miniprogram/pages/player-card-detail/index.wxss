page { background: #0e1417; color: #f4f7f8; }
.detail-page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 28rpx calc(env(safe-area-inset-bottom) + 54rpx); background: radial-gradient(circle at 100% 0%, rgba(240, 184, 75, 0.1), transparent 30%), #0e1417; }
.hero { padding: 24rpx 4rpx 42rpx; display: flex; align-items: center; border-bottom: 2rpx solid #344047; }
.hero-card { width: 218rpx; flex: none; transform: scale(1.08); transform-origin: left center; }
.hero-copy { min-width: 0; margin-left: 42rpx; display: flex; flex: 1; flex-direction: column; }
.hero-kicker { color: #b6f13a; font-size: 16rpx; letter-spacing: 4rpx; }
.hero-name { margin-top: 18rpx; font-family:inherit; font-size: 45rpx; font-weight: 700; line-height: 1.18; }
.hero-card-name { margin-top: 10rpx; color: #aab5ba; font-size: 24rpx; font-weight: 700; }
.hero-rule { width: 64rpx; height: 4rpx; margin: 24rpx 0 12rpx; background: #b6f13a; }
.hero-meta { margin-top: 7rpx; color: #aab5ba; font-size: 22rpx; }
.pack-badge { align-self: flex-start; margin-top: 18rpx; padding: 8rpx 12rpx; border: 2rpx solid #6f5730; color: #aab5ba; font-size: 18rpx; }
.favorite-action { min-height:72rpx; margin:22rpx 0 0; padding:0 20rpx; border:2rpx solid #46545b; border-radius:16rpx; background:#1c262b; color:#f4f7f8; font-size:21rpx; font-weight:800; }
.favorite-action::after { border:0; }
.favorite-action.is-active { border-color:#b6f13a; color:#b6f13a; }
.detail-section { margin-top: 44rpx; padding: 28rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; box-shadow: 0 16rpx 44rpx rgba(0,0,0,.18); }
.section-head { display: flex; align-items: baseline; }
.section-index { color: #b6f13a; font-family:inherit; font-size: 20rpx; }
.section-title { margin-left: 16rpx; font-size: 29rpx; font-weight: 800; }
.attribute-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22rpx 30rpx; }
.attribute-row { min-width: 0; }
.attribute-label { color: #aab5ba; font-size: 20rpx; }
.attribute-value { float: right; font-family:inherit; color: #f4f7f8; font-size: 25rpx; font-weight: 700; }
.attribute-track { height: 5rpx; margin-top: 10rpx; overflow: hidden; background: #27332d; }
.attribute-fill { height: 100%; max-width: 100%; background: linear-gradient(90deg, #3b9b4d, #b6f13a); }
.skill-list { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.skill-chip { padding: 11rpx 16rpx; border: 2rpx solid #46545b; border-radius: 10rpx; color: #dce6e0; font-size: 21rpx; }
.empty-copy, .state-copy { display: block; margin-top: 20rpx; color: #aab5ba; font-size: 23rpx; }
.sibling-row { min-height: 86rpx; display: flex; align-items: center; border-bottom: 2rpx solid #26352e; }
.sibling-row:last-child { border-bottom: 0; }
.sibling-rating { width: 74rpx; font-family:inherit; color: #aab5ba; font-size: 34rpx; font-weight: 800; }
.sibling-title { flex: 1; font-size: 24rpx; }
.sibling-arrow { color: #b6f13a; font-size: 40rpx; }
.detail-state { min-height: 70vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
.state-code { color: #aab5ba; font-size: 17rpx; letter-spacing: 4rpx; }
.state-title { margin-top: 20rpx; font-size: 36rpx; font-weight: 800; }
.state-copy { line-height: 1.65; }
.back-button { min-height: 88rpx; margin: 30rpx 0 0; padding: 0 30rpx; border: 2rpx solid #344047; border-radius: 16rpx; background: #1c262b; color: #f4f7f8; font-size: 24rpx; }
.back-button::after { border: 0; }
