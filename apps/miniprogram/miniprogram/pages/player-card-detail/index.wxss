page { background: #0e1417; color: #f4f7f8; }
.detail-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 28rpx calc(env(safe-area-inset-bottom) + 54rpx); background: #0e1417; }

.hero { position: relative; display: flex; align-items: center; overflow: hidden; padding: 30rpx 24rpx; border: 2rpx solid #344047; border-radius: 28rpx; background: #151d21; box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.24); }
.hero::before { position: absolute; top: 0; right: 0; width: 126rpx; height: 8rpx; border-radius: 0 28rpx 0 8rpx; background: #b6f13a; content: ''; }
.hero-card { width: 218rpx; flex: none; transform: scale(1.04); transform-origin: left center; }
.hero-copy { min-width: 0; margin-left: 34rpx; display: flex; flex: 1; flex-direction: column; }
.hero-kicker, .section-kicker { color: #b6f13a; font-size: 16rpx; font-weight: 750; letter-spacing: 3rpx; }
.hero-scoreline { display: flex; align-items: flex-end; margin-top: 15rpx; }
.hero-score { font-size: 76rpx; font-weight: 900; line-height: 0.92; letter-spacing: -4rpx; }
.hero-position { display: flex; flex-direction: column; margin: 0 0 4rpx 17rpx; }
.hero-position-code { color: #b6f13a; font-size: 25rpx; font-weight: 850; }
.hero-position-label { margin-top: 2rpx; color: #7e8b91; font-size: 18rpx; }
.hero-name { display: block; overflow: hidden; margin-top: 22rpx; font-size: 36rpx; font-weight: 850; line-height: 1.18; text-overflow: ellipsis; white-space: nowrap; }
.hero-card-name { display: block; overflow: hidden; margin-top: 8rpx; color: #aab5ba; font-size: 21rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.favorite-action { width: 100%; min-height: 72rpx; margin: 24rpx 0 0; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #46545b; border-radius: 16rpx; background: #1c262b; color: #f4f7f8; font-size: 21rpx; font-weight: 800; line-height: 1; text-align: center; }
.favorite-action::after, .back-button::after { border: 0; }
.favorite-action.is-active { border-color: #b6f13a; background: #202b20; color: #b6f13a; }
.hero-score.is-boosted { color: #b6f13a; animation: score-pop 220ms ease-out; }

.detail-section { margin-top: 28rpx; padding: 30rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.16); }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 2rpx solid #2d393f; }
.section-kicker, .section-title { display: block; }
.section-title { margin-top: 7rpx; font-size: 30rpx; font-weight: 850; line-height: 1.2; }
.section-note { padding-bottom: 2rpx; color: #7e8b91; font-size: 18rpx; }

.profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 22rpx; }
.profile-fact { min-width: 0; min-height: 96rpx; box-sizing: border-box; padding: 18rpx; border: 2rpx solid #2d393f; border-radius: 16rpx; background: #1c262b; }
.profile-fact.is-wide { grid-column: span 2; }
.fact-label, .fact-value { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fact-label { color: #7e8b91; font-size: 17rpx; }
.fact-value { margin-top: 8rpx; color: #f4f7f8; font-size: 23rpx; font-weight: 750; }
.fact-value.is-muted { color: #7e8b91; font-weight: 550; }

.attribute-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26rpx 30rpx; margin-top: 26rpx; }
.attribute-row { min-width: 0; }
.attribute-label { color: #aab5ba; font-size: 20rpx; }
.attribute-value { float: right; color: #f4f7f8; font-size: 26rpx; font-weight: 800; }
.attribute-value.tone-red { color: #ff0000; }
.attribute-value.tone-yellow { color: #ffe600; }
.attribute-value.tone-green { color: #22ff00; }
.attribute-value.tone-cyan { color: #00efff; }
.attribute-delta { color: #b6f13a; font-size: 17rpx; }
.attribute-track { height: 7rpx; margin-top: 12rpx; overflow: hidden; border-radius: 7rpx; background: #27332d; }
.attribute-fill { height: 100%; border-radius: 7rpx; background: #7e8b91; transition: width 220ms ease, background-color 220ms ease; }
.attribute-fill.tone-red { background: #ff0000; }
.attribute-fill.tone-yellow { background: #ffe600; }
.attribute-fill.tone-green { background: #22ff00; }
.attribute-fill.tone-cyan { background: #00efff; }

.skill-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.skill-chip { padding: 13rpx 17rpx; border: 2rpx solid #46545b; border-radius: 14rpx; background: #1c262b; color: #dce6e0; font-size: 21rpx; }
.empty-copy, .state-copy { display: block; margin-top: 22rpx; color: #aab5ba; font-size: 23rpx; }

.sibling-list { margin-top: 20rpx; }
.sibling-row { min-height: 92rpx; display: flex; align-items: center; box-sizing: border-box; margin-top: 12rpx; padding: 12rpx 16rpx; border: 2rpx solid #2d393f; border-radius: 16rpx; background: #1c262b; }
.sibling-rating { width: 80rpx; color: #f4f7f8; font-size: 38rpx; font-weight: 900; }
.sibling-copy { min-width: 0; flex: 1; }
.sibling-title, .sibling-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sibling-title { font-size: 23rpx; font-weight: 750; }
.sibling-meta { margin-top: 6rpx; color: #7e8b91; font-size: 18rpx; }
.sibling-arrow { margin-left: 16rpx; color: #b6f13a; font-size: 40rpx; }

.detail-state { min-height: 70vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
.state-code { color: #aab5ba; font-size: 17rpx; letter-spacing: 4rpx; }
.state-title { margin-top: 20rpx; font-size: 36rpx; font-weight: 800; }
.state-copy { line-height: 1.65; }
.back-button { min-height: 88rpx; margin: 30rpx 0 0; padding: 0 30rpx; border: 2rpx solid #344047; border-radius: 16rpx; background: #1c262b; color: #f4f7f8; font-size: 24rpx; }

.progression-section { transition: border-color 180ms ease, box-shadow 180ms ease; }
.progression-section.is-applied { border-color: #657d35; box-shadow: 0 18rpx 50rpx rgba(130, 190, 40, 0.1); }
.build-summary { display: flex; align-items: center; gap: 22rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; background: #101719; }
.build-summary > view { min-width: 0; flex: 1; }
.build-label, .build-value { display: block; }
.build-label { color: #7e8b91; font-size: 16rpx; letter-spacing: 1rpx; }
.build-value { margin-top: 6rpx; font-size: 34rpx; font-weight: 900; }
.build-value.is-accent, .build-arrow { color: #b6f13a; }
.build-arrow { flex: none; font-size: 30rpx; }
.allocation-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.allocation-chip { display: flex; align-items: center; gap: 10rpx; padding: 11rpx 15rpx; border: 2rpx solid #344047; border-radius: 40rpx; background: #1c262b; color: #dce6e0; font-size: 19rpx; }
.allocation-points { color: #b6f13a; font-weight: 850; }
.auto-build-button { width: 100%; min-height: 84rpx; margin: 22rpx 0 0; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 18rpx; background: #b6f13a; color: #111712; font-size: 24rpx; font-weight: 900; line-height: 1; }
.auto-build-button::after { border: 0; }
.auto-build-button.is-reset { border: 2rpx solid #52602d; background: #202b20; color: #b6f13a; }
.auto-build-button.is-unavailable { border: 2rpx solid #344047; background: #1c262b; color: #7e8b91; }
.build-visuals { display: grid; grid-template-columns: 1fr; gap: 18rpx; margin-top: 22rpx; animation: visual-in 220ms ease-out; }
.visual-card { min-width: 0; padding: 22rpx; border: 2rpx solid #2d393f; border-radius: 18rpx; background: #101719; }
.visual-title { display: block; font-size: 22rpx; font-weight: 850; }
.visual-note { display: block; margin-top: 5rpx; color: #7e8b91; font-size: 15rpx; }
.radar-stage { position: relative; width: 560rpx; max-width: 100%; margin: 14rpx auto 0; aspect-ratio: 1 / 1; }
.radar-plot { position: absolute; inset: 38rpx 52rpx; overflow: hidden; }
.radar-axis, .radar-grid-line, .radar-outline { position: absolute; height: 2rpx; transform-origin: left center; }
.radar-axis { z-index: 1; background: #27332d; }
.radar-grid-line { z-index: 2; background: #2d393f; }
.radar-area { position: absolute; z-index: 3; inset: 0; background: rgba(75, 223, 200, 0.24); transition: clip-path 220ms ease, -webkit-clip-path 220ms ease; }
.radar-outline { z-index: 4; height: 4rpx; background: #b6f13a; transition: left 220ms ease, top 220ms ease, width 220ms ease, transform 220ms ease; }
.radar-dot { position: absolute; z-index: 5; width: 13rpx; height: 13rpx; border-radius: 50%; background: #f4f7f8; box-shadow: 0 0 0 2rpx rgba(182, 241, 58, 0.28); transform: translate(-50%, -50%); transition: left 220ms ease, top 220ms ease; }
.radar-label { width: 104rpx; position: absolute; z-index: 6; display: flex; flex-direction: column; align-items: center; color: #aab5ba; font-size: 17rpx; line-height: 1.1; text-align: center; transform: translate(-50%, -50%); }
.radar-label text:last-child { margin-top: 5rpx; color: #f4f7f8; font-size: 22rpx; font-weight: 900; }
.radar-label--0 { top: 6%; left: 50%; }
.radar-label--1 { top: 29%; left: 91%; }
.radar-label--2 { top: 71%; left: 91%; }
.radar-label--3 { top: 94%; left: 50%; }
.radar-label--4 { top: 71%; left: 9%; }
.radar-label--5 { top: 29%; left: 9%; }
.position-pitch { position: relative; margin-top: 20rpx; padding: 8rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(7, 72rpx); gap: 6rpx; overflow: hidden; border: 2rpx solid #3b494e; border-radius: 16rpx; background: linear-gradient(180deg, rgba(46, 95, 65, .18), rgba(14, 31, 25, .52)), #0c1517; }
.position-pitch::before, .position-pitch::after { position: absolute; z-index: 0; pointer-events: none; content: ''; }
.position-pitch::before { inset: 10rpx; border: 1rpx solid rgba(174, 198, 187, .12); border-radius: 8rpx; }
.position-pitch::after { width: 180rpx; height: 90rpx; bottom: -18rpx; left: 50%; border: 1rpx solid rgba(174, 198, 187, .12); border-radius: 90rpx 90rpx 0 0; transform: translateX(-50%); }
.pitch-mark { position: absolute; z-index: 0; pointer-events: none; }
.pitch-mark--half { top: 50%; right: 10rpx; left: 10rpx; border-top: 1rpx solid rgba(174, 198, 187, .12); }
.pitch-mark--circle { width: 130rpx; height: 130rpx; top: 50%; left: 50%; border: 1rpx solid rgba(174, 198, 187, .12); border-radius: 50%; transform: translate(-50%, -50%); }
.position-cell { z-index: 2; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid #303a3f; border-radius: 10rpx; background: rgba(27, 34, 38, .94); color: #7e8b91; transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease; }
.position-cell--LWF { grid-column: 1; grid-row: 1 / span 2; }
.position-cell--CF { grid-column: 2; grid-row: 1; }
.position-cell--RWF { grid-column: 3; grid-row: 1 / span 2; }
.position-cell--SS { grid-column: 2; grid-row: 2; }
.position-cell--LMF { grid-column: 1; grid-row: 3 / span 3; }
.position-cell--AMF { grid-column: 2; grid-row: 3; }
.position-cell--RMF { grid-column: 3; grid-row: 3 / span 3; }
.position-cell--CMF { grid-column: 2; grid-row: 4; }
.position-cell--DMF { grid-column: 2; grid-row: 5; }
.position-cell--LB { grid-column: 1; grid-row: 6 / span 2; }
.position-cell--CB { grid-column: 2; grid-row: 6; }
.position-cell--RB { grid-column: 3; grid-row: 6 / span 2; }
.position-cell--GK { grid-column: 2; grid-row: 7; }
.position-cell.tone-strong { border-color: #07c160; background: #07c160; color: #06140d; }
.position-cell.tone-partial { border-color: rgba(7, 193, 96, .72); background: rgba(7, 193, 96, .4); color: #e9fff2; }
.position-cell.tone-neutral { border-color: #353b40; background: rgba(37, 40, 43, .94); color: #d6dcde; }
.position-cell.is-primary { border-color: #b6f13a; box-shadow: inset 0 0 0 1rpx rgba(182, 241, 58, .28), 0 0 24rpx rgba(182, 241, 58, .12); }
.position-rating { font-size: 26rpx; font-weight: 900; }
.position-code { margin-top: 2rpx; font-size: 14rpx; font-weight: 800; letter-spacing: 1rpx; }
.build-unavailable { margin-top: 22rpx; padding: 20rpx; border-radius: 16rpx; background: #101719; color: #7e8b91; font-size: 21rpx; line-height: 1.55; }

@keyframes visual-in { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes score-pop { 0% { transform: scale(0.92); } 100% { transform: scale(1); } }

@media (max-width: 390px) {
  .build-visuals { grid-template-columns: 1fr; }
}
