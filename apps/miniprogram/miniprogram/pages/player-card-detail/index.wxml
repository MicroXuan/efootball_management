<view class="detail-page">
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取球员卡档案" />

  <view wx:elif="{{state === 'unavailable'}}" class="detail-state">
    <text class="state-code">卡片不可用</text>
    <text class="state-title">当前无法查看</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="back-button" bindtap="goBack">返回球员库</button>
  </view>

  <view wx:elif="{{state === 'error'}}" class="detail-state">
    <text class="state-code">连接中断</text>
    <text class="state-title">详情加载失败</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="back-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="hero">
      <view class="hero-card"><player-card card="{{card}}" /></view>
      <view class="hero-copy">
        <text class="hero-kicker">球探报告</text>
        <view class="hero-scoreline">
          <text class="hero-score {{autoApplied ? 'is-boosted' : ''}}">{{presentation.overallRating}}</text>
          <view class="hero-position">
            <text class="hero-position-code">{{card.position}}</text>
            <text class="hero-position-label">{{card.positionLabel}}</text>
          </view>
        </view>
        <text class="hero-name">{{card.displayName}}</text>
        <text class="hero-card-name">{{card.cardName}}</text>
        <button class="favorite-action {{isFavorite ? 'is-active' : ''}}" loading="{{favoriteBusy}}" bindtap="toggleFavorite">
          {{isFavorite ? '★ 已收藏' : '☆ 收藏球员'}}
        </button>
      </view>
    </view>

    <view class="detail-section progression-section {{autoApplied ? 'is-applied' : ''}}">
      <view class="section-head">
        <view>
          <text class="section-kicker">智能加点</text>
          <text class="section-title">自动成长方案</text>
        </view>
        <text class="section-note">{{buildPanel.note}}</text>
      </view>

      <block wx:if="{{card.autoBuild.available}}">
        <view class="build-summary">
          <view><text class="build-label">基础总评</text><text class="build-value">{{card.overallRating}}</text></view>
          <text class="build-arrow">→</text>
          <view><text class="build-label">方案总评</text><text class="build-value is-accent">{{card.autoBuild.maxOverall}}</text></view>
        </view>
        <view class="allocation-list">
          <view wx:for="{{card.autoBuild.allocationRows}}" wx:key="key" class="allocation-chip">
            <text>{{item.label}}</text><text class="allocation-points">+{{item.points}}</text>
          </view>
        </view>
      </block>
      <view wx:else class="build-unavailable">
        <text>{{card.autoBuild.unavailableReason}}</text>
      </view>

      <button
        class="auto-build-button {{autoApplied ? 'is-reset' : ''}} {{!card.autoBuild.available ? 'is-unavailable' : ''}}"
        disabled="{{!card.autoBuild.available}}"
        bindtap="toggleAutomaticBuild"
      >
        {{buildPanel.buttonLabel}}
      </button>

      <view class="build-visuals">
        <view class="visual-card radar-card">
          <text class="visual-title">能力雷达</text>
          <view class="radar-stage">
            <view class="radar-plot">
              <view wx:for="{{presentation.radarChart.axes}}" wx:key="key" class="radar-axis" style="{{item.style}}"></view>
              <block wx:for="{{presentation.radarChart.rings}}" wx:key="key" wx:for-item="ring">
                <view wx:for="{{ring.segments}}" wx:key="key" wx:for-item="segment" class="radar-grid-line" style="{{segment.style}}"></view>
              </block>
              <view class="radar-area" style="-webkit-clip-path: polygon({{presentation.radarChart.polygon}}); clip-path: polygon({{presentation.radarChart.polygon}});"></view>
              <view wx:for="{{presentation.radarChart.outline}}" wx:key="key" class="radar-outline" style="{{item.style}}"></view>
              <view wx:for="{{presentation.radarChart.dots}}" wx:key="key" class="radar-dot" style="{{item.style}}"></view>
            </view>
          </view>
          <view class="radar-legend">
            <view wx:for="{{presentation.radarMetrics}}" wx:key="key" class="legend-item">
              <text>{{item.label}}</text><text>{{item.value === null ? '—' : item.value}}</text>
            </view>
          </view>
        </view>
        <view class="visual-card">
          <text class="visual-title">位置适配</text>
          <text class="visual-note">主位置为卡片总评，其余为能力适配值</text>
          <view class="position-map">
            <view wx:for="{{presentation.positions}}" wx:key="code" class="position-cell {{item.isPrimary ? 'is-primary' : ''}} {{item.rating ? 'has-rating' : ''}}">
              <text class="position-rating">{{item.rating || '—'}}</text>
              <text class="position-code">{{item.code}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-head">
        <view>
          <text class="section-kicker">球探档案</text>
          <text class="section-title">基础资料</text>
        </view>
        <text class="section-note">已发布数据</text>
      </view>
      <view class="profile-grid">
        <view
          wx:for="{{card.profileFacts}}"
          wx:key="key"
          class="profile-fact {{item.wide ? 'is-wide' : ''}}"
        >
          <text class="fact-label">{{item.label}}</text>
          <text class="fact-value {{item.value === '未记录' ? 'is-muted' : ''}}">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section ability-section">
      <view class="section-head">
        <view>
          <text class="section-kicker">数据分析</text>
          <text class="section-title">能力面板</text>
        </view>
        <text class="section-note">90+ 高亮</text>
      </view>
      <view wx:if="{{presentation.attributes.length}}" class="attribute-grid">
        <view wx:for="{{presentation.attributes}}" wx:key="key" class="attribute-row {{item.tone === 'elite' ? 'is-elite' : ''}}">
          <text class="attribute-label">{{item.label}}</text>
          <text class="attribute-value">{{item.value}}<text wx:if="{{item.delta}}" class="attribute-delta"> +{{item.delta}}</text></text>
          <view class="attribute-track"><view class="attribute-fill" style="width: {{item.barWidth}}%;"></view></view>
        </view>
      </view>
      <text wx:else class="empty-copy">暂无能力数据</text>
    </view>

    <view class="detail-section">
      <view class="section-head">
        <view>
          <text class="section-kicker">技能清单</text>
          <text class="section-title">球员技能</text>
        </view>
        <text class="section-note">{{card.skills.length}} 项</text>
      </view>
      <view wx:if="{{card.skills.length}}" class="skill-list">
        <text wx:for="{{card.skills}}" wx:key="code" class="skill-chip">{{item.nameZh || item.nameEn || item.code}}</text>
      </view>
      <text wx:else class="empty-copy">暂无已记录技能</text>
    </view>

    <view wx:if="{{card.siblings.length}}" class="detail-section">
      <view class="section-head">
        <view>
          <text class="section-kicker">卡片版本</text>
          <text class="section-title">同球员其他卡片</text>
        </view>
        <text class="section-note">{{card.siblings.length}} 张</text>
      </view>
      <view class="sibling-list">
        <view
          wx:for="{{card.siblings}}"
          wx:key="id"
          class="sibling-row"
          data-id="{{item.id}}"
          bindtap="onSiblingTap"
        >
          <text class="sibling-rating">{{item.overallRating}}</text>
          <view class="sibling-copy">
            <text class="sibling-title">{{item.title}}</text>
            <text class="sibling-meta">{{item.cardTypeLabel}} · {{item.positionLabel}}</text>
          </view>
          <text class="sibling-arrow">›</text>
        </view>
      </view>
    </view>
  </block>
</view>
