page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 28rpx) 28rpx calc(env(safe-area-inset-bottom) + 128rpx);background:radial-gradient(circle at 90% 0,rgba(182,241,58,.08),transparent 30%),#0e1417}.page-head,.search-box,.state-card,.sale-card{border:2rpx solid #344047;border-radius:24rpx;background:#151d21}.page-head{padding:30rpx}.page-kicker{display:block;color:#aab5ba;font-size:18rpx;font-weight:750;letter-spacing:3rpx}.page-title{display:block;margin-top:10rpx;font-size:40rpx;font-weight:900}.page-copy{display:block;margin-top:12rpx;color:#aab5ba;font-size:20rpx;line-height:1.55}.search-box{height:84rpx;margin-top:20rpx;padding:0 22rpx;display:flex;align-items:center}.search-box input{width:100%;color:#f4f7f8;font-size:22rpx}.sales-list{margin-top:20rpx}.sale-card{position:relative;min-height:220rpx;margin-top:16rpx;padding:22rpx;display:grid;grid-template-columns:128rpx minmax(0,1fr) 116rpx;gap:20rpx}.sale-artwork{height:180rpx;overflow:hidden;border-radius:16rpx}.sale-main{min-width:0}.sale-main text{display:block}.sale-league,.sale-time,.sale-bidder{color:#aab5ba;font-size:17rpx}.sale-player{margin-top:7rpx;font-size:28rpx;font-weight:900}.sale-card-meta{margin-top:7rpx;color:#b6f13a;font-size:18rpx}.sale-team{margin-top:18rpx;font-size:21rpx;font-weight:800}.sale-bidder,.sale-time{margin-top:6rpx}.sale-price{align-self:center;text-align:right}.sale-price text{display:block;color:#b6f13a;font-size:34rpx;font-weight:900;font-variant-numeric:tabular-nums}.sale-price text+text{color:#aab5ba;font-size:16rpx}.state-card{margin-top:20rpx;padding:30rpx}.outline-button{min-height:80rpx;margin:24rpx 0 0;border:2rpx solid #344047;border-radius:16rpx;background:#1c262b;color:#f4f7f8}.inline-error,.list-end{display:block;margin:24rpx 0;color:#aab5ba;font-size:18rpx;text-align:center}.retry-link{min-height:72rpx;border:2rpx solid #344047;border-radius:16rpx;background:#1c262b;color:#f4f7f8}.back-to-top{position:fixed;right:28rpx;bottom:calc(38rpx + env(safe-area-inset-bottom));z-index:20;min-width:112rpx;height:66rpx;padding:0 18rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:7rpx;border:2rpx solid #8fbd35;border-radius:34rpx;background:rgba(24,35,30,.96);box-shadow:0 10rpx 30rpx rgba(0,0,0,.34);color:#efffcf;font-size:18rpx;font-weight:900}.back-to-top-arrow{color:#b6f13a;font-size:26rpx;line-height:1}
