page { background: #0e1417; color: #f4f7f8; }
.login-shell { min-height:100vh; box-sizing:border-box; padding:calc(env(safe-area-inset-top) + 52rpx) 56rpx calc(env(safe-area-inset-bottom) + 190rpx); display:flex; flex-direction:column; overflow:hidden; background:radial-gradient(circle at 50% 12%, rgba(182,241,58,.07), transparent 32%), #0e1417; }
.login-stadium-mark { position:relative; height:330rpx; flex:none; display:flex; align-items:center; justify-content:center; }
.login-pitch-ring { position:absolute; width:420rpx; height:280rpx; border:2rpx solid #344047; border-radius:44rpx; box-shadow:0 0 0 56rpx rgba(52,64,71,.12); }
.login-pitch-ring::before,.login-pitch-ring::after { position:absolute; background:#344047; content:''; }
.login-pitch-ring::before { width:2rpx; height:280rpx; left:50%; top:0; }
.login-pitch-ring::after { width:112rpx; height:112rpx; top:82rpx; left:154rpx; border:2rpx solid #344047; border-radius:50%; background:transparent; }
.login-ball { position:relative; z-index:1; font-size:104rpx; filter:drop-shadow(0 24rpx 32rpx rgba(0,0,0,.38)); }
.login-brand-block { margin-top:30rpx; display:flex; flex-direction:column; }
.login-eyebrow { color:#aab5ba; font-size:20rpx; font-weight:700; letter-spacing:6rpx; }
.login-title { margin-top:18rpx; font-size:72rpx; font-weight:850; line-height:1; letter-spacing:2rpx; }
.login-subtitle { margin-top:26rpx; max-width:560rpx; color:#aab5ba; font-size:27rpx; line-height:1.7; }
.login-panel { margin-top:auto; padding:32rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; box-shadow:0 20rpx 54rpx rgba(0,0,0,.26); }
.login-panel-line { display:flex; justify-content:space-between; color:#aab5ba; font-size:22rpx; letter-spacing:2rpx; }
.login-panel-code { color:#7e8b91; }
.login-button { min-height:92rpx; margin-top:34rpx; padding:0 32rpx; border:0; border-radius:16rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; background:#b6f13a; color:#111810; font-size:30rpx; font-weight:800; letter-spacing:3rpx; }
.login-button__label { line-height:1; }
.login-button::after { border:0; }
.login-button[disabled] { background:#263238; color:#7e8b91; }
.login-error-copy { display:block; margin-top:24rpx; color:#ffaaa5; font-size:23rpx; line-height:1.5; }
.login-privacy-copy { display:block; margin-top:24rpx; color:#7e8b91; font-size:21rpx; line-height:1.55; }
.page-shell { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 38rpx) 30rpx 110rpx; background: radial-gradient(circle at 82% 8%, rgba(182,241,58,.06), transparent 32%), #0e1417; }
.topbar,.identity-card,.section-head,.team-card,.team-name-line { display:flex; align-items:center; }
.topbar,.section-head { justify-content:space-between; }
.eyebrow,.section-kicker,.state-code { display:block; color:#aab5ba; font-size:18rpx; letter-spacing:5rpx; }
.page-title { display:block; margin-top:8rpx; font-family:inherit; font-size:54rpx; font-weight:700; }
.record-mark { color:#7e8b91; font-size:20rpx; letter-spacing:3rpx; }
.identity-card,.state-card { margin-top:42rpx; padding:30rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; box-shadow:0 16rpx 44rpx rgba(0,0,0,.18); }
.avatar { width:108rpx; height:108rpx; flex:none; border:2rpx solid #46545b; border-radius:50%; }
.avatar-fallback { display:flex; align-items:center; justify-content:center; background:#183123; font-size:42rpx; }
.identity-copy { min-width:0; margin-left:22rpx; display:flex; flex:1; flex-direction:column; }
.member-name { overflow:hidden; font-size:34rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.member-name-edit { width:max-content; min-height:44rpx; margin:8rpx 0 0; padding:0; border:0; background:transparent; color:#b6f13a; font-size:20rpx; line-height:44rpx; text-align:left; }
.member-name-edit::after { border:0; }
.number-block { flex:none; padding-left:18rpx; border-left:2rpx solid rgba(142,164,151,.2); text-align:right; }
.number-label,.copy-hint { display:block; color:#aab5ba; font-size:17rpx; }
.public-number { display:block; margin:7rpx 0 4rpx; color:#f4f7f8; font-family:inherit; font-size:27rpx; font-weight:800; letter-spacing:2rpx; }
.nickname-editor { margin-top:16rpx; padding:26rpx; border:2rpx solid #425148; border-radius:20rpx; background:#151d21; }
.nickname-editor__label { display:block; color:#f4f7f8; font-size:24rpx; font-weight:800; }
.nickname-editor__input { height:84rpx; margin-top:18rpx; padding:0 22rpx; border:2rpx solid #46545b; border-radius:14rpx; background:#10181c; color:#f4f7f8; font-size:27rpx; }
.nickname-editor__hint { display:block; margin-top:14rpx; color:#8f9ca2; font-size:19rpx; line-height:1.5; }
.nickname-editor__actions { display:flex; justify-content:flex-end; gap:14rpx; }
.nickname-editor__actions .outline-button,.nickname-editor__actions .primary-button { min-width:180rpx; margin-top:22rpx; }
.quick-actions { margin-top:20rpx; padding:26rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; box-shadow:0 16rpx 44rpx rgba(0,0,0,.16); }
.action-center-entry { min-height:126rpx;margin-top:20rpx;padding:22rpx 24rpx;box-sizing:border-box;display:flex;align-items:center;border:2rpx solid #668b26;border-radius:20rpx;background:linear-gradient(145deg,rgba(182,241,58,.12),#151d21 72%); }
.action-center-entry__marker { width:54rpx;height:54rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#b6f13a;color:#111810;font-size:21rpx;font-weight:900; }
.action-center-entry__copy { min-width:0;margin-left:18rpx;flex:1; }
.action-center-entry__top { display:flex;align-items:center;gap:12rpx; }
.action-center-entry__title { font-size:28rpx;font-weight:850; }
.action-center-entry__count { min-width:34rpx;height:34rpx;padding:0 8rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:17rpx;background:#ffba52;color:#171d1f;font-size:17rpx;font-weight:900; }
.action-center-entry__detail { display:block;margin-top:7rpx;color:#aab5ba;font-size:19rpx; }
.action-center-entry__tags { margin-top:9rpx;display:flex;gap:10rpx;color:#b6f13a;font-size:17rpx;font-weight:800; }
.quick-actions__head { display:flex; align-items:flex-end; justify-content:space-between; }
.quick-actions__title { display:block; margin-top:8rpx; font-size:31rpx; font-weight:800; }
.quick-actions__mark { color:#718087; font-size:16rpx; font-weight:700; letter-spacing:3rpx; }
.quick-actions__grid { margin-top:24rpx; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; }
.quick-action { position:relative;min-width:0; min-height:154rpx; padding:18rpx 14rpx; box-sizing:border-box; display:flex; flex-direction:column; border:2rpx solid #2c3a40; border-radius:16rpx; background:#10181c; }
.quick-action__badge { position:absolute;top:12rpx;right:12rpx;min-width:30rpx;height:30rpx;padding:0 7rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#ffba52;color:#171d1f;font-size:15rpx;font-weight:900; }
.quick-action__marker { width:42rpx; height:42rpx; display:flex; align-items:center; justify-content:center; border-radius:10rpx; background:#263238; color:#b6f13a; font-size:20rpx; font-weight:900; }
.quick-action__title { margin-top:18rpx; overflow:hidden; color:#f4f7f8; font-size:23rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.quick-action__detail { margin-top:7rpx; overflow:hidden; color:#8f9ca2; font-size:17rpx; text-overflow:ellipsis; white-space:nowrap; }
.section-head { margin-top:54rpx; }
.section-title { display:block; margin-top:8rpx; font-size:36rpx; font-weight:800; }
.team-count { color:#aab5ba; font-size:22rpx; }
.team-list { margin-top:22rpx; }
.team-card { margin-top:16rpx; padding:24rpx; border:2rpx solid #344047; border-radius:20rpx; background:#151d21; }
.team-logo { width:90rpx; height:90rpx; flex:none; border-radius:16rpx; background:#09140e; }
.team-copy { min-width:0; margin-left:20rpx; display:flex; flex:1; flex-direction:column; }
.team-name-line { min-width:0; gap:12rpx; }
.team-number { color:#aab5ba; font-size:21rpx; font-weight:800; }
.team-name { overflow:hidden; font-size:29rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.team-alias { margin-top:5rpx; color:#aab5ba; font-size:21rpx; }
.league-name,.season-name { margin-top:8rpx; overflow:hidden; color:#9caf9f; font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.season-name { color:#aab5ba; }
.chevron { color:#b6f13a; font-size:44rpx; }
.favorites-entry { min-height:112rpx; margin-top:20rpx; padding:20rpx 24rpx; display:flex; align-items:center; border:2rpx solid #344047; border-radius:20rpx; background:#151d21; }
.favorites-icon { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; border-radius:16rpx; background:#213022; color:#b6f13a; font-size:30rpx; }
.favorites-copy { min-width:0; margin-left:18rpx; display:flex; flex:1; flex-direction:column; }
.favorites-title { font-size:27rpx; font-weight:800; }
.favorites-detail { margin-top:7rpx; overflow:hidden; color:#aab5ba; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }
.state-card { min-height:280rpx; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; }
.state-card.compact { min-height:230rpx; }
.state-title { margin-top:18rpx; font-size:31rpx; font-weight:800; }
.state-copy { margin-top:14rpx; color:#aab5ba; font-size:23rpx; line-height:1.65; }
.login-error { display:block; margin-top:18rpx; color:#ff9c8e; font-size:21rpx; line-height:1.5; }
.primary-button,.outline-button { min-height:88rpx; margin:28rpx 0 0; border-radius: 16rpx; font-weight:800; }
.primary-button::after,.outline-button::after { border:0; }
.primary-button { min-width:280rpx; background:#b6f13a; color:#111810; }
.outline-button { padding:0 28rpx; border:2rpx solid #344047; background:#1c262b; color:#f4f7f8; font-size:23rpx; }
