<view class="page-shell">
  <view class="topbar">
    <view><text class="eyebrow">成员身份</text><text class="page-title">我的</text></view>
    <text class="record-mark">球员档案 · 01</text>
  </view>

  <loading-state wx:if="{{state === 'loading'}}" label="正在加载身份资料" />
  <view wx:elif="{{state === 'error'}}" class="state-card">
    <text class="state-code">身份读取失败</text><text class="state-title">暂时无法加载</text>
    <text class="state-copy">{{errorMessage}}</text><button class="outline-button" bindtap="loadPage">重新加载</button>
  </view>

  <block wx:else>
    <view wx:if="{{!loggedIn}}" class="state-card login-card">
      <text class="state-code">微信身份</text><text class="state-title">登录后查看我的球队</text>
      <text class="state-copy">管理员绑定联赛球队后，球队与当前赛季会自动显示在这里。</text>
      <button class="primary-button" bindtap="login">微信登录</button>
    </view>

    <block wx:else>
      <view class="identity-card">
        <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-fallback">⚽</view>
        <view class="identity-copy">
          <text class="member-name">{{profile.displayName}}</text>
          <text class="member-region">{{profile.region}}</text>
        </view>
        <view class="number-block" bindtap="copyUserNo">
          <text class="number-label">用户编号</text><text class="public-number">{{profile.publicUserNoDisplay}}</text>
          <text wx:if="{{profile.publicUserNoCopy}}" class="copy-hint">点击复制</text>
        </view>
      </view>

      <view class="section-head">
        <view><text class="section-kicker">已绑定球队</text><text class="section-title">已绑定联赛球队</text></view>
        <text class="team-count">{{profile.teams.length}} 支</text>
      </view>

      <view wx:if="{{!profile.hasTeams}}" class="state-card compact">
        <text class="state-title">还没有绑定球队</text>
        <text class="state-copy">球队由联赛管理员在后台创建并绑定。绑定后会自动报名当前赛季，无需你手动填写资料。</text>
      </view>
      <view wx:else class="team-list">
        <view wx:for="{{profile.teams}}" wx:key="id" class="team-card" data-id="{{item.id}}" bindtap="openTeam">
          <image wx:if="{{item.teamLogoUrl}}" class="team-logo" src="{{item.teamLogoUrl}}" mode="aspectFit" />
          <view wx:else class="team-logo logo-fallback">{{item.teamLogoText}}</view>
          <view class="team-copy">
            <view class="team-name-line"><text class="team-number">{{item.teamNumber}}</text><text class="team-name">{{item.teamName}}</text></view>
            <text class="league-name">{{item.leagueName}} · {{item.editionLabel}}</text>
            <text class="season-name">{{item.seasonName}} · 阵容 {{item.rosterCopy}}</text>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>
    </block>
  </block>
</view>
