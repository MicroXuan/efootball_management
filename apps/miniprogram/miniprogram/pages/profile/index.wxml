<block wx:if="{{state === 'loaded'}}">
  <view wx:if="{{!loggedIn}}" class="login-shell">
    <view class="login-stadium-mark" aria-hidden="true">
      <view class="login-pitch-ring"></view>
      <view class="login-ball">⚽</view>
    </view>

    <view class="login-brand-block">
      <text class="login-eyebrow">赛事运营中枢</text>
      <text class="login-title">非概念实况</text>
      <text class="login-subtitle">赛事、战队、球员，实时调度。</text>
    </view>

    <view class="login-panel">
      <view class="login-panel-line">
        <text>参赛者通道</text>
        <text class="login-panel-code">球员档案</text>
      </view>
      <button class="login-button" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="login">
        <text class="login-button__label">{{loginLoading ? '正在进入…' : '微信登录'}}</text>
      </button>
      <text wx:if="{{errorMessage}}" class="login-error-copy">{{errorMessage}}</text>
      <text class="login-privacy-copy">登录即用于识别参赛身份，不读取未授权的微信资料。</text>
    </view>
  </view>

  <view wx:else class="page-shell">
    <view class="topbar">
      <view><text class="eyebrow">成员身份</text><text class="page-title">我的</text></view>
      <text class="record-mark">球员档案</text>
    </view>

    <view class="identity-card">
      <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">⚽</view>
      <view class="identity-copy">
        <text class="member-name">{{profile.displayName}}</text>
      </view>
      <view class="number-block" bindtap="copyUserNo">
        <text class="number-label">用户编号</text><text class="public-number">{{profile.publicUserNoDisplay}}</text>
        <text wx:if="{{profile.publicUserNoCopy}}" class="copy-hint">点击复制</text>
      </view>
    </view>

    <view class="action-center-entry" bindtap="openActionCenter" role="button">
      <view class="action-center-entry__marker">待</view>
      <view class="action-center-entry__copy">
        <view class="action-center-entry__top"><text class="action-center-entry__title">待办中心</text><text class="action-center-entry__count">{{actionCenter.attentionCount}}</text></view>
        <text class="action-center-entry__detail">{{actionCenter.attentionCount ? '跨联赛待处理与状态更新' : '当前没有需要关注的业务'}}</text>
        <view class="action-center-entry__tags"><text wx:if="{{actionCenter.actionRequiredCount}}">待处理 {{actionCenter.actionRequiredCount}}</text><text wx:if="{{actionCenter.auctionCount}}">拍卖 {{actionCenter.auctionCount}}</text></view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view class="quick-actions">
      <view class="quick-actions__head">
        <view><text class="section-kicker">快捷入口</text><text class="quick-actions__title">现在要做什么</text></view>
        <text class="quick-actions__mark">MATCH DESK</text>
      </view>
      <view class="quick-actions__grid">
        <view class="quick-action" bindtap="openMyMatches" role="button">
          <text class="quick-action__marker">赛</text>
          <text class="quick-action__title">我的赛程</text>
          <text class="quick-action__detail">待赛与结果</text>
        </view>
        <view class="quick-action" bindtap="openPlayerAuctions" role="button">
          <text class="quick-action__marker">拍</text>
          <text wx:if="{{actionCenter.auctionCount}}" class="quick-action__badge">{{actionCenter.auctionCount}}</text>
          <text class="quick-action__title">球员拍卖</text>
          <text class="quick-action__detail">进入拍卖大厅</text>
        </view>
        <view class="quick-action" bindtap="openFavorites" role="button">
          <text class="quick-action__marker">藏</text>
          <text class="quick-action__title">我的收藏</text>
          <text class="quick-action__detail">常用球员卡</text>
        </view>
      </view>
    </view>

    <view wx:if="{{features.wechatBot}}" class="favorites-entry" bindtap="openWechatBotBinding" role="button">
      <view class="favorites-icon">🤖</view>
      <view class="favorites-copy"><text class="favorites-title">绑定群机器人</text><text class="favorites-detail">绑定微信身份，使用“我的赛程”等群命令</text></view>
      <text class="chevron">›</text>
    </view>

    <view class="section-head">
      <view><text class="section-kicker">已绑定球队</text><text class="section-title">已绑定联赛球队</text></view>
      <text class="team-count">{{profile.teams.length}} 支</text>
    </view>

    <view wx:if="{{!profile.hasTeams}}" class="state-card compact">
      <text class="state-title">还没有绑定球队</text>
      <text class="state-copy">球队由联赛管理员在后台创建并绑定。绑定后会自动报名当前赛季，无需你手动填写资料。</text>
    </view>
    <view wx:else class="team-list">
      <view wx:for="{{profile.teams}}" wx:key="id" class="team-card" data-id="{{item.id}}" bindtap="openTeam">
        <entity-artwork class="team-logo" src="{{item.teamLogoUrl}}" fallback="{{item.teamLogoText}}" shape="square" />
        <view class="team-copy">
          <view class="team-name-line"><text class="team-name">{{item.identityCopy}}</text></view>
          <text class="team-alias">{{item.ownerAliasCopy}}</text>
          <text class="league-name">{{item.leagueName}} · {{item.editionLabel}}</text>
          <text class="season-name">{{item.seasonName}} · 阵容 {{item.rosterCopy}}</text>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>
  </view>
</block>

<view wx:else class="page-shell">
  <view class="topbar">
    <view><text class="eyebrow">成员身份</text><text class="page-title">我的</text></view>
    <text class="record-mark">球员档案</text>
  </view>
  <loading-state wx:if="{{state === 'loading'}}" label="正在加载身份资料" />
  <view wx:else class="state-card">
    <text class="state-code">身份读取失败</text><text class="state-title">暂时无法加载</text>
    <text class="state-copy">{{errorMessage}}</text><button class="outline-button" bindtap="loadPage">重新加载</button>
  </view>
</view>
