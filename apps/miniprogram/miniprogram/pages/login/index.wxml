<view class="page-shell">
  <view class="stadium-mark" aria-hidden="true">
    <view class="pitch-ring"></view>
    <view class="ball">⚽</view>
  </view>

  <view class="brand-block">
    <text class="eyebrow">赛事运营中枢</text>
    <text class="title">非概念实况</text>
    <text class="subtitle">赛事、战队、球员，实时调度。</text>
  </view>

  <view class="login-panel">
    <view class="panel-line">
      <text>参赛者通道</text>
      <text class="panel-code">球员档案 · 01</text>
    </view>
    <button
      class="login-button"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="login"
    ><text class="login-button__label">{{loading ? '正在进入…' : '微信登录'}}</text></button>
    <text wx:if="{{errorMessage}}" class="error-copy">{{errorMessage}}</text>
    <text class="privacy-copy">登录即用于识别参赛身份，不读取未授权的微信资料。</text>
  </view>
</view>
