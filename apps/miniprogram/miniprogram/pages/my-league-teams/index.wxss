page{background:#07110d;color:#eef7f1}.page-shell{min-height:100vh;padding:56rpx 30rpx 90rpx;box-sizing:border-box;background:linear-gradient(160deg,#07110d,#102219)}.kicker{display:block;color:#d4b05f;font-size:18rpx;letter-spacing:5rpx}.title{display:block;margin-top:10rpx;font:700 52rpx STKaiti,KaiTi,serif}.user-no{margin:28rpx 0 0;padding:0;text-align:left;background:transparent;color:#55ef8b;font-size:24rpx}.user-no::after,.outline::after{border:0}.team-list{margin-top:38rpx}.team-card,.state-card{margin-top:22rpx;padding:30rpx;border:2rpx solid rgba(85,239,139,.25);background:rgba(13,29,20,.92)}.team-head,.metrics{display:flex;justify-content:space-between}.league-name{color:#d4b05f;font-size:22rpx}.status{color:#55ef8b}.status.danger{color:#ff9c8e}.team-name{display:block;margin-top:20rpx;font-size:34rpx;font-weight:700}.metrics{margin-top:26rpx;color:#9bb0a4;font-size:23rpx}.chevron{display:block;margin-top:26rpx;color:#55ef8b;font-size:22rpx}.state-card{min-height:300rpx;display:flex;flex-direction:column;justify-content:center}.state-title{font-size:32rpx;font-weight:700}.muted{margin-top:16rpx;color:#8ea497;line-height:1.6}.outline{margin:28rpx 0 0;border:2rpx solid #55ef8b;background:transparent;color:#55ef8b}
