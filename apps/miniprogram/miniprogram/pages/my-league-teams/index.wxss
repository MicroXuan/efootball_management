page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;padding:56rpx 30rpx 110rpx;box-sizing:border-box;background:radial-gradient(circle at 92% 2%,rgba(182,241,58,.06),transparent 28%),#0e1417}.kicker{display:block;color:#aab5ba;font-size:18rpx;letter-spacing:5rpx}.title{display:block;margin-top:10rpx;font:800 52rpx inherit}.user-no{min-height:72rpx;margin:28rpx 0 0;padding:0 18rpx;border:2rpx solid #344047;border-radius:14rpx;text-align:left;background:#1c262b;color:#f4f7f8;font-size:22rpx}.user-no::after,.outline::after{border:0}.team-list{margin-top:38rpx}.team-card,.state-card{margin-top:22rpx;padding:30rpx;border:2rpx solid #344047;border-radius:24rpx;background:#151d21;box-shadow:0 16rpx 44rpx rgba(0,0,0,.18)}.team-head,.metrics{display:flex;justify-content:space-between;gap:18rpx}.league-name{color:#aab5ba;font-size:22rpx}.status{color:#f4f7f8}.status.danger{color:#ff9c8e}.team-name{display:block;margin-top:20rpx;font-size:34rpx;font-weight:800}.metrics{margin-top:26rpx;color:#aab5ba;font-size:23rpx}.chevron{display:block;margin-top:26rpx;color:#b6f13a;font-size:22rpx;font-weight:750}.state-card{min-height:300rpx;display:flex;flex-direction:column;justify-content:center}.state-title{font-size:32rpx;font-weight:800}.muted{margin-top:16rpx;color:#aab5ba;line-height:1.6}.outline{min-height:76rpx;margin:28rpx 0 0;border:2rpx solid #344047;border-radius:16rpx;background:#1c262b;color:#f4f7f8}
