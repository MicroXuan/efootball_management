page{background:#0a0a0a;color:#f7f8f5}.page-shell{min-height:100vh;padding:56rpx 30rpx 90rpx;box-sizing:border-box;background:linear-gradient(160deg,#0a0a0a,#102219)}.kicker{display:block;color:#d9e342;font-size:18rpx;letter-spacing:5rpx}.title{display:block;margin-top:10rpx;font:700 52rpx inherit}.user-no{margin:28rpx 0 0;padding:0;text-align:left;background:transparent;color:#b0ff00;font-size:24rpx}.user-no::after,.outline::after{border:0}.team-list{margin-top:38rpx}.team-card,.state-card{margin-top:22rpx;padding:30rpx;border:2rpx solid rgba(176,255,0,.25);background:#171917}.team-head,.metrics{display:flex;justify-content:space-between}.league-name{color:#d9e342;font-size:22rpx}.status{color:#b0ff00}.status.danger{color:#ff9c8e}.team-name{display:block;margin-top:20rpx;font-size:34rpx;font-weight:700}.metrics{margin-top:26rpx;color:#9bb0a4;font-size:23rpx}.chevron{display:block;margin-top:26rpx;color:#b0ff00;font-size:22rpx}.state-card{min-height:300rpx;display:flex;flex-direction:column;justify-content:center}.state-title{font-size:32rpx;font-weight:700}.muted{margin-top:16rpx;color:#8ea497;line-height:1.6}.outline{margin:28rpx 0 0;border:2rpx solid #b0ff00;background:transparent;color:#b0ff00}
