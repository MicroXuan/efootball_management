<view class="page-shell">
  <view class="hero"><text class="kicker">联赛身份</text><text class="title">我的联赛球队</text><button class="user-no" bindtap="copyUserNo">用户编号 {{publicUserNoDisplay}} · 点击复制</button></view>
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取联赛球队" />
  <view wx:elif="{{state === 'error'}}" class="state-card"><text class="state-title">暂时无法读取</text><text class="muted">{{errorMessage}}</text><button class="outline" bindtap="loadPage">重新加载</button></view>
  <view wx:elif="{{!teams.length}}" class="state-card"><text class="state-title">暂无联赛球队</text><text class="muted">球队由联赛管理员创建并分配；你无需在小程序中自行建队。</text></view>
  <view wx:else class="team-list">
    <view wx:for="{{teams}}" wx:key="id" class="team-card" data-id="{{item.id}}" bindtap="openTeam">
      <view class="team-head"><text class="league-name">{{item.leagueName}}</text><text class="status {{item.rosterStatus === 'OVER_CAP' ? 'danger' : ''}}">{{item.statusCopy}}</text></view>
      <view class="team-identity">
        <entity-artwork class="team-crest" src="{{item.logoUrl}}" fallback="{{item.logoFallback}}" shape="square" />
        <view class="team-identity__copy"><text class="team-name">{{item.identityCopy}}</text><text class="team-alias">{{item.ownerAliasCopy}}</text></view>
      </view>
      <view class="metrics"><text>阵容 {{item.rosterCopy}}</text><text>工资 {{item.salaryCopy}}</text></view>
      <text class="chevron">查看球队档案 →</text>
    </view>
  </view>
</view>
