<view class="standings-page">
  <view class="page-head">
    <text class="kicker">赛季数据中心</text>
    <text class="title">{{seasonTitle}}</text>
    <text class="subtitle">正式参赛球队专属 · 实时排名</text>
  </view>
  <loading-state wx:if="{{loading}}" label="正在读取积分榜" />
  <view wx:elif="{{errorMessage}}" class="state-card">
    <text class="state-kicker">读取失败</text><text class="state-title">暂时无法打开积分榜</text>
    <text class="state-copy">{{errorMessage}}</text><button class="retry efm-retry-button" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
    <scroll-view class="stage-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="stage-tabs__inner">
        <view wx:for="{{tabs}}" wx:key="id" data-index="{{index}}" bindtap="selectStage" class="stage-tab {{selectedIndex === index ? 'is-active' : ''}}">
          <text class="stage-tab__label">{{item.label}}</text><text class="stage-tab__meta">{{item.countLabel}}{{item.isMine ? ' · 我的组' : ''}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="board-card">
      <view class="board-head"><view><text class="board-kicker">当前排名</text><text class="board-title">{{selectedLabel}}</text></view><text class="updated">{{updatedLabel}}</text></view>
      <view wx:if="{{rows.length === 0}}" class="empty"><text>排名尚未产生</text><text>赛程发布后，比赛结果会在这里形成实时积分榜。</text></view>
      <scroll-view wx:else class="table-scroll" scroll-x enhanced>
        <view class="standings-table">
          <view class="table-row table-head"><text class="rank">排名</text><text class="team">球队</text><text class="played">场次</text><text class="record">胜/平/负</text><text class="goals">进/失/净</text><text class="points">积分</text></view>
          <view wx:for="{{rows}}" wx:key="participantId" class="table-row {{item.isMine ? 'is-mine' : ''}}">
            <view class="rank rank-cell">
              <text wx:if="{{item.medalLabel}}" class="medal">{{item.medalLabel}}</text>
              <view wx:else class="plain-rank {{item.rankAccent ? 'is-accent' : ''}}"><text>{{item.rankLabel}}</text></view>
            </view>
            <view class="team team-cell">
              <entity-artwork class="team-crest" src="{{item.teamLogoSrc}}" fallback="{{item.logoFallback}}" shape="square" />
              <view class="team-copy">
                <text class="team-name">{{item.teamIdentityLabel}}{{item.teamLifecycleStatus === 'ARCHIVED' ? '（已退赛）' : ''}}</text>
                <text class="owner-name">（{{item.ownerDisplayName}}）</text>
                <text wx:if="{{item.tieLabel}}" class="tie">{{item.tieLabel}}</text>
              </view>
            </view>
            <text class="played">{{item.played}}</text><text class="record">{{item.wins}}/{{item.draws}}/{{item.losses}}</text><text class="goals">{{item.goalsFor}}/{{item.goalsAgainst}}/{{item.goalDifference}}</text><text class="points">{{item.totalPoints}}</text>
          </view>
        </view>
      </scroll-view>
      <text wx:if="{{rows.length}}" class="legend">* 同分球队最终顺序待管理员确认</text>
    </view>
  </block>
</view>
