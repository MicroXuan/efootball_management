page{background:#0e1417;color:#f4f7f8}.standings-page{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 30rpx) 26rpx calc(env(safe-area-inset-bottom) + 48rpx);background:radial-gradient(circle at 90% 0%,rgba(182,241,58,.07),transparent 28%),#0e1417}.kicker,.board-kicker,.state-kicker{display:block;color:#aab5ba;font-size:17rpx;font-weight:750;letter-spacing:5rpx}.title{display:block;margin-top:10rpx;font-size:52rpx;font-weight:850;letter-spacing:-1rpx}.subtitle{display:block;margin-top:12rpx;color:#aab5ba;font-size:21rpx}.stage-tabs{width:100%;margin-top:34rpx;white-space:nowrap}.stage-tabs__inner{display:inline-flex;gap:14rpx;padding-right:26rpx}.stage-tab{min-width:190rpx;padding:20rpx 24rpx;border:2rpx solid #344047;border-radius:18rpx;background:#151d21}.stage-tab.is-active{border-color:#b6f13a;background:#202c25}.stage-tab__label,.stage-tab__meta{display:block}.stage-tab__label{font-size:24rpx;font-weight:850}.stage-tab__meta{margin-top:7rpx;color:#aab5ba;font-size:17rpx}.stage-tab.is-active .stage-tab__meta{color:#d9efac}.board-card,.state-card{margin-top:24rpx;padding:28rpx;border:2rpx solid #344047;border-radius:24rpx;background:#151d21;box-shadow:0 16rpx 44rpx rgba(0,0,0,.18)}.board-head{display:flex;align-items:flex-end;justify-content:space-between}.board-title{display:block;margin-top:8rpx;font-size:32rpx;font-weight:850}.updated{color:#7e8b91;font-size:17rpx}.table-scroll{width:100%;margin-top:28rpx;border:2rpx solid #2d393f;border-radius:16rpx}.standings-table{min-width:980rpx}.table-row{display:grid;grid-template-columns:76rpx 240rpx repeat(7,64rpx) 78rpx;min-height:82rpx;align-items:center;border-bottom:2rpx solid #273238;background:#151d21;font-size:20rpx;text-align:center}.table-row:last-child{border-bottom:0}.table-row text{min-width:0}.table-head{min-height:66rpx;background:#1c262b;color:#aab5ba;font-size:17rpx;font-weight:750}.table-row.is-mine{background:#202c25;box-shadow:inset 6rpx 0 #b6f13a}.rank{font-size:23rpx;font-weight:850}.team{box-sizing:border-box;padding:0 14rpx;text-align:left;font-weight:750}.team text{display:block}.tie{margin-top:4rpx;color:#eecb72;font-size:15rpx;font-weight:650}.points{color:#b6f13a;font-size:24rpx;font-weight:900}.legend{display:block;margin-top:18rpx;color:#aab5ba;font-size:17rpx}.empty{min-height:300rpx;display:flex;flex-direction:column;justify-content:center;gap:12rpx;color:#aab5ba;font-size:21rpx;text-align:center}.empty text:first-child{color:#f4f7f8;font-size:29rpx;font-weight:850}.state-card{min-height:420rpx;display:flex;flex-direction:column;justify-content:center}.state-title{display:block;margin-top:16rpx;font-size:32rpx;font-weight:850}.state-copy{display:block;margin-top:14rpx;color:#aab5ba;font-size:21rpx;line-height:1.6}.retry{min-height:80rpx;margin:26rpx 0 0;border-radius:16rpx;background:#b6f13a;color:#111810;font-size:23rpx;font-weight:850}.retry::after{border:0}
