<view class="page-shell">
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取球员详情" />
  <view wx:elif="{{state === 'error'}}" class="state-card"><text class="section-title">暂时无法读取</text><text class="muted">{{errorMessage}}</text><button class="outline-button efm-retry-button" bindtap="loadDetail">重新加载</button></view>
  <block wx:else>
    <view class="player-hero">
      <view class="hero-top"><view class="rating-tile"><text>{{player.overallLabel}}</text><text>{{player.position}}</text></view><view class="hero-copy"><view class="name-row"><text class="player-name">{{player.playerName}}</text><text wx:if="{{player.showForcedTransferBadge}}" class="forced-badge">本赛季强报</text></view><text class="muted">{{player.nationalityLabel}} · {{player.clubLabel}}</text><text class="card-name">{{player.card.cardName}}</text></view></view>
      <view wx:if="{{player.profileFacts.length}}" class="profile-facts"><view wx:for="{{player.profileFacts}}" wx:for-item="fact" wx:key="key" class="profile-fact"><text class="profile-fact-label">{{fact.label}}</text><text class="profile-fact-value">{{fact.value}}</text></view></view>
      <view class="value-row"><text>官方身价</text><text>{{player.officialValueLabel}}</text></view>
      <view class="salary-panel">
        <view class="salary-row"><text>{{player.salaryHeading}}</text><text>{{player.salaryLabel}}</text></view>
        <text wx:if="{{player.currentTierLabel}}" class="salary-note">{{player.currentTierLabel}} · 当前规则仅供比较</text>
        <text wx:if="{{player.salary.kind === 'UNAVAILABLE'}}" class="salary-note">{{player.salaryUnavailableLabel}}</text>
        <view class="salary-row"><text>本队当前工资</text><text>{{player.salaryImpact.currentLabel}}</text></view>
        <view class="salary-row"><text>本队工资帽</text><text>{{player.salaryImpact.capLabel}}</text></view>
        <view class="salary-row"><text>签入后预计占用</text><text>{{player.salaryImpact.projectedLabel}}</text></view>
        <text wx:if="{{player.salaryImpact.overCapLabel}}" class="warning">{{player.salaryImpact.overCapLabel}}</text>
        <text class="salary-note">工资占用工资帽，具体以审核时结果为准</text>
      </view>
      <view wx:if="{{player.owner}}" class="owner-panel"><view class="crest"><image wx:if="{{player.owner.logoUrl}}" src="{{player.owner.logoUrl}}" mode="aspectFit" /><text wx:else>{{player.owner.fallback}}</text></view><view><text class="owner-name">{{player.owner.numberLabel}} · {{player.owner.name}}</text><text class="muted">联赛称呼 · {{player.owner.ownerAlias}}</text></view></view>
      <view wx:else class="owner-panel"><text class="owner-name">自由球员</text><text class="muted">当前没有所属球队</text></view>
    </view>

    <view wx:if="{{myApplication}}" class="application-panel">
      <view class="section-head"><view><text class="eyebrow">我的申请</text><text class="section-title">{{myApplication.statusLabel}}</text></view><text class="amount">{{myApplication.amountLabel}}</text></view>
      <text class="muted">{{myApplication.typeLabel}}<text wx:if="{{myApplication.queuePosition}}"> · 公开队列 {{myApplication.queuePosition}}</text></text>
      <text wx:if="{{myApplication.status === 'REJECTED'}}" class="review-reason">{{myApplication.reviewReason ? '驳回原因：' + myApplication.reviewReason : '管理员未填写驳回原因；如需了解详情，请联系联赛管理员。'}}</text>
      <view wx:if="{{reapply}}" class="reapply-panel"><text class="muted">{{reapply.hint}}</text><button class="primary-button reapply-button {{!reapply.enabled ? 'is-disabled' : ''}}" bindtap="openComposer" disabled="{{submitting || !reapply.enabled}}">{{reapply.actionLabel}}</button></view>
      <view wx:elif="{{myApplication.canEdit || myApplication.canWithdraw}}" class="button-grid efm-equal-tabs"><button class="primary-button" bindtap="editApplication" disabled="{{submitting || !myApplication.canEdit}}">修改报价</button><button class="danger-button" bindtap="withdrawApplication" loading="{{submitting}}" disabled="{{submitting || !myApplication.canWithdraw}}">撤回申请</button></view>
    </view>
    <view wx:if="{{forcedCopyText}}" class="forced-copy-panel">
      <text class="eyebrow">微信群文案</text><text class="section-title">分享本次强报报价</text>
      <text class="forced-copy-text" user-select="true">{{forcedCopyText}}</text>
      <text class="muted">仅复制到剪贴板，需要你自行粘贴到微信群；此报价不会修改官方身价。</text>
      <button class="primary-button" bindtap="copyForcedOffer">复制强报文案</button>
    </view>

    <view wx:if="{{!myApplication}}" class="action-panel">
      <text class="eyebrow">交易操作</text><text class="section-title">{{player.label}}</text>
      <text wx:if="{{player.action === 'APPLY'}}" class="warning">最高报价不代表必然获批</text>
      <text wx:if="{{player.action === 'FORCE_SIGN'}}" class="warning">原球队无需同意 · 强报金额不得低于官方身价</text>
      <text wx:if="{{player.disabledReason === 'OFFICIAL_VALUE_REQUIRED'}}" class="warning">管理员尚未设置官方身价，暂不能强报</text>
      <button class="primary-button" bindtap="openComposer" disabled="{{submitting || !player.actionEnabled}}">{{player.actionLabel}}</button>
    </view>

    <view wx:if="{{showComposer}}" class="composer">
      <text class="eyebrow">{{myApplication && myApplication.canEdit ? '修改申请' : reapply ? reapply.actionLabel : player.label}}</text><text class="section-title">确认交易金额</text>
      <view wx:if="{{player.action === 'FORCE_SIGN'}}" class="forced-confirm"><text>原球队</text><text>{{player.owner.numberLabel}} · {{player.owner.name}}</text><text>官方身价</text><text>{{player.officialValueLabel}}</text><text class="warning">原球队无需同意</text></view>
      <view class="amount-field"><text>金额</text><input type="number" value="{{amount}}" bindinput="onAmountInput" placeholder="输入整数金额" /></view><text class="muted">{{amountHint}}</text>
      <view class="salary-confirm"><text>{{player.salaryHeading}} {{player.salaryLabel}}</text><text>签入后预计占用 {{player.salaryImpact.projectedLabel}} / 工资帽 {{player.salaryImpact.capLabel}}</text><text wx:if="{{player.salaryImpact.overCapLabel}}" class="warning">{{player.salaryImpact.overCapLabel}}</text><text>申请金额与工资分开计算，最终以审核时结果为准</text></view>
      <view class="button-grid efm-equal-tabs"><button class="outline-button" bindtap="closeComposer" disabled="{{submitting}}">取消</button><button class="primary-button" bindtap="confirmComposer" loading="{{submitting}}" disabled="{{submitting}}">确认提交</button></view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-panel"><text>{{errorMessage}}</text><button wx:if="{{recoveryLabel}}" bindtap="runRecovery">{{recoveryLabel}}</button></view>

    <view class="public-panel"><view class="section-head"><view><text class="eyebrow">公开透明</text><text class="section-title">申请进度</text></view><text class="count">{{player.publicApplicationCount}} 笔</text></view>
      <text wx:if="{{!publicApplications.length}}" class="muted">尚无公开申请</text>
      <view wx:for="{{publicApplications}}" wx:key="id" class="public-application"><view class="public-head"><text>{{item.applicant.numberLabel}} · {{item.applicant.name}}</text><text>{{item.amountLabel}}</text></view><text class="muted">{{item.applicant.ownerAlias}} · {{item.typeLabel}} · {{item.statusLabel}}</text><view class="timeline"><view wx:for="{{item.timeline}}" wx:for-item="event" wx:key="id"><text>{{event.label}}</text><text>{{event.detail || event.time}}</text></view></view></view>
    </view>
  </block>
</view>
