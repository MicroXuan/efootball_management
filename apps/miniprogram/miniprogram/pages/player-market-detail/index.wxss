page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;box-sizing:border-box;padding:28rpx 24rpx 120rpx;background:radial-gradient(circle at 85% 0,rgba(182,241,58,.1),transparent 32%),#0e1417}.player-hero,.application-panel,.action-panel,.composer,.public-panel,.state-card,.error-panel{margin-bottom:20rpx;padding:28rpx;border:2rpx solid #35434a;border-radius:24rpx;background:#151d21}.hero-top{display:flex;gap:20rpx}.rating-tile{display:flex;flex:none;flex-direction:column;align-items:center;justify-content:center;width:106rpx;height:106rpx;border:2rpx solid #63822d;border-radius:20rpx;background:#1c3320;color:#b6f13a;font-size:18rpx;font-weight:900}.rating-tile text:first-child{font-size:34rpx}.hero-copy{min-width:0;flex:1}.name-row{display:flex;min-width:0;align-items:center;gap:10rpx}.player-name{min-width:0;flex:1;overflow:hidden;font-size:31rpx;font-weight:950;text-overflow:ellipsis;white-space:nowrap}.forced-badge{flex:none;padding:6rpx 10rpx;border-radius:8rpx;background:#493f0f;color:#f8d84b;font-size:16rpx;font-weight:900;white-space:nowrap}.muted{display:block;margin-top:10rpx;color:#98a6ad;font-size:19rpx;line-height:1.5}.card-name{display:block;margin-top:10rpx;color:#b6f13a;font-size:18rpx;font-weight:850}.value-row,.section-head,.public-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.section-head>view,.owner-panel>view{min-width:0}.amount,.count{flex:none}.value-row{margin-top:24rpx;padding:20rpx 0;border-top:2rpx solid #303d43;border-bottom:2rpx solid #303d43}.value-row text:last-child,.amount,.count,.public-head text:last-child{color:#b6f13a;font-size:27rpx;font-weight:950}.owner-panel{display:flex;align-items:center;gap:14rpx;margin-top:20rpx}.crest{display:flex;flex:none;align-items:center;justify-content:center;width:62rpx;height:62rpx;overflow:hidden;border-radius:15rpx;background:#26343a;color:#b6f13a;font-weight:900}.crest image{width:100%;height:100%}.owner-name{display:block;max-width:500rpx;overflow:hidden;font-size:22rpx;font-weight:850;text-overflow:ellipsis;white-space:nowrap}.eyebrow{display:block;color:#91a0a7;font-size:17rpx;font-weight:800;letter-spacing:4rpx}.section-title{display:block;margin-top:9rpx;font-size:28rpx;font-weight:950}.warning{display:block;margin-top:16rpx;color:#f5d34e;font-size:20rpx;font-weight:800}.primary-button,.outline-button,.danger-button{display:flex;align-items:center;justify-content:center;min-height:82rpx;margin-top:22rpx;border-radius:16rpx;font-size:22rpx;font-weight:900}.primary-button{background:#b6f13a;color:#0e1417}.outline-button{border:2rpx solid #47565d;background:#1b252a;color:#f4f7f8}.danger-button{border:2rpx solid #6d3d3b;background:#2d1e1d;color:#ff9993}.button-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;box-sizing:border-box;gap:14rpx;margin-top:22rpx;overflow:hidden}.button-grid>button{width:100%;min-width:0;max-width:100%;box-sizing:border-box;margin:0;padding:0 12rpx;overflow:hidden}.forced-confirm{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12rpx;margin-top:20rpx;padding:20rpx;border-radius:16rpx;background:#222815}.forced-confirm text:nth-child(2n){min-width:0;overflow-wrap:anywhere;text-align:right;font-weight:800}.forced-confirm .warning{grid-column:1/-1;text-align:center}.amount-field{display:flex;align-items:center;gap:18rpx;margin-top:20rpx;padding:0 20rpx;border:2rpx solid #53626a;border-radius:16rpx}.amount-field input{min-width:0;flex:1;height:82rpx;color:#f4f7f8;font-size:28rpx;text-align:right}.error-panel{display:flex;align-items:center;justify-content:space-between;border-color:#724844;color:#ffaaa3}.error-panel>text{min-width:0;overflow-wrap:anywhere}.error-panel button{flex:none;margin:0 0 0 18rpx;background:#ffaaa3;color:#27110f;font-size:18rpx}.public-application{margin-top:18rpx;padding:20rpx;border:2rpx solid #2e3a40;border-radius:18rpx;background:#1b252a}.public-head text:first-child{min-width:0;flex:1;overflow:hidden;font-weight:850;text-overflow:ellipsis;white-space:nowrap}.public-head text:last-child{flex:none}.timeline{margin-top:16rpx;padding-left:16rpx;border-left:3rpx solid #4c5d64}.timeline>view{display:flex;justify-content:space-between;gap:20rpx;padding:8rpx 0;color:#9aa7ad;font-size:17rpx}.timeline>view text{min-width:0}.timeline>view text:last-child{overflow-wrap:anywhere;text-align:right}.state-card{text-align:center}
.forced-copy-panel{margin-bottom:20rpx;padding:28rpx;border:2rpx solid #5f7935;border-radius:24rpx;background:#1a261d}
.profile-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin-top:22rpx}.profile-fact{display:flex;min-width:0;flex-direction:column;gap:6rpx;padding:12rpx 8rpx;box-sizing:border-box;border:2rpx solid #2c3a3f;border-radius:12rpx;background:#1b2629;text-align:center}.profile-fact-label{color:#8e9da3;font-size:16rpx}.profile-fact-value{overflow:hidden;color:#ecf3ee;font-size:20rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}
.forced-copy-text{display:block;margin-top:18rpx;padding:20rpx;border:2rpx solid #3c5631;border-radius:14rpx;color:#e6f4db;background:#111b14;font-size:20rpx;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}
.review-reason{display:block;margin-top:18rpx;padding:16rpx 18rpx;border-left:4rpx solid #f5d34e;border-radius:8rpx;color:#f1dda0;background:#27271d;font-size:20rpx;line-height:1.5;overflow-wrap:anywhere}
.reapply-panel{margin-top:16rpx}.reapply-button{width:100%;box-sizing:border-box;padding:0 20rpx;text-align:center}.reapply-button.is-disabled{border:2rpx solid #3c4a3d;background:#263229!important;color:#9caca0!important;opacity:1}
.salary-panel,.salary-confirm{display:flex;flex-direction:column;gap:12rpx;margin-top:20rpx;padding:20rpx;box-sizing:border-box;border:2rpx solid #354b3a;border-radius:16rpx;background:#1a2820;font-size:20rpx;line-height:1.5;overflow-wrap:anywhere}.salary-row{display:flex;justify-content:space-between;align-items:flex-start;gap:14rpx}.salary-row text{min-width:0}.salary-row text:last-child{flex:none;color:#b6f13a;font-weight:850}.salary-note{color:#9cab9d;font-size:18rpx}.salary-confirm .warning{margin-top:0}
