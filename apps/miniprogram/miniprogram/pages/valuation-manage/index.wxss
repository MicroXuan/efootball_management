page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;padding:54rpx 28rpx 140rpx;box-sizing:border-box;background:radial-gradient(circle at 90% 0,rgba(182,241,58,.08),transparent 30%),#0e1417}.kicker,.muted,.range{display:block;color:#9eaaaf;font-size:22rpx}.title{display:block;margin-top:12rpx;font-size:48rpx;font-weight:850}.countdown{display:block;margin-top:24rpx;color:#b6f13a;font-weight:750}.status{display:inline-block;margin-top:14rpx;padding:8rpx 16rpx;border:1rpx solid #4b5a61;border-radius:28rpx;color:#dbe2e5;font-size:21rpx}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:30rpx 0}.summary view,.panel,.player-card{border:1rpx solid #344047;border-radius:22rpx;background:#151d21}.summary view{padding:20rpx 8rpx;text-align:center}.summary text{display:block;font-size:32rpx;font-weight:850}.summary label{color:#9eaaaf;font-size:19rpx}.panel{padding:24rpx}.player-card{margin-top:16rpx;padding:26rpx}.player-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:18rpx}.player-name{display:block;font-size:28rpx;font-weight:800}.pill{flex:none;padding:7rpx 13rpx;border-radius:28rpx;background:#273138;color:#cdd5d9;font-size:19rpx}.danger{color:#ff9c8e}.range{margin:20rpx 0 10rpx}.player-card input{height:82rpx;padding:0 22rpx;border:1rpx solid #4a585f;border-radius:16rpx;background:#0f1619;color:#fff;font-size:30rpx}.actions{position:fixed;left:24rpx;right:24rpx;bottom:28rpx;display:grid;grid-template-columns:1fr 1.5fr;gap:14rpx;padding:14rpx;border:1rpx solid #344047;border-radius:24rpx;background:rgba(21,29,33,.96)}button{border-radius:16rpx;font-weight:800}button::after{border:0}.primary{background:#b6f13a;color:#111}.secondary{background:#283238;color:#f4f7f8}.readonly{margin-top:22rpx;color:#9eaaaf}
