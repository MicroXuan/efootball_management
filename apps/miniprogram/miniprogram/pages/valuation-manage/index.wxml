<view class="page-shell"><loading-state wx:if="{{state === 'loading'}}" label="正在读取身价工作区" /><view wx:elif="{{state === 'error'}}" class="panel"><text class="title">暂时无法读取</text><text class="muted">{{errorMessage}}</text><button bindtap="loadPage">重新加载</button></view><block wx:else><view class="hero"><text class="kicker">身价管理 · {{workspace.window.name}}</text><text class="title">{{workspace.team.name}}</text><text class="countdown">{{countdown}}</text><text class="status">{{submissionCopy}}</text></view><view class="summary"><view><text>{{summary.changedCount}}</text><label>修改</label></view><view><text>{{summary.unchangedCount}}</text><label>沿用</label></view><view><text>{{summary.exceededCount}}</text><label>超限</label></view><view><text>{{summary.missingCount}}</text><label>待填写</label></view></view><view class="rule panel"><text>本窗口规则 V{{workspace.window.rule.version}}</text><text class="muted">全局范围 {{workspace.window.rule.minimumValueMinor}} — {{workspace.window.rule.maximumValueMinor}}</text></view><view class="player-card" wx:for="{{players}}" wx:key="snapshotId"><view class="player-heading"><view><text class="player-name">{{item.playerName}}</text><text class="muted">{{item.cardName}} · 当前 {{item.currentValueCopy}}</text></view><text class="pill {{item.changeState === '超出范围' ? 'danger' : ''}}">{{item.changeState}}</text></view><text class="range">允许 {{item.allowedRangeCopy}}</text><input type="number" inputmode="numeric" disabled="{{!editable}}" value="{{item.inputValue}}" data-index="{{index}}" bindinput="onValueInput" placeholder="输入整数身价" /></view><view class="actions" wx:if="{{editable}}"><button class="secondary" loading="{{saving}}" disabled="{{saving || publishing}}" bindtap="saveDraft">保存草稿</button><button class="primary" loading="{{publishing}}" disabled="{{saving || publishing || !summary.complete}}" bindtap="publish">确认并发布</button></view><view wx:else class="panel readonly">当前状态不可编辑，可查看已提交的正式数据。</view></block></view>
