page{background:#07110d;color:#eef7f1}.editor-page{min-height:100vh;box-sizing:border-box;padding:42rpx 28rpx 90rpx;background:radial-gradient(circle at 86% 4%,rgba(85,239,139,.14),transparent 26%),linear-gradient(165deg,#07110d,#0d2117 58%,#101611)}
.header{padding:20rpx 0 30rpx;border-bottom:2rpx solid rgba(85,239,139,.25)}.kicker,.section-kicker{display:block;color:#d4b05f;font-size:17rpx;letter-spacing:4rpx}.title{display:block;margin-top:10rpx;font-family:STKaiti,KaiTi,serif;font-size:49rpx;font-weight:800}.subtitle,.hint{display:block;margin-top:13rpx;color:#91a397;font-size:21rpx;line-height:1.65}
.form-card,.state-card{margin-top:22rpx;padding:28rpx;border:2rpx solid rgba(85,239,139,.22);background:rgba(10,25,17,.96)}.serial-strip{display:flex;justify-content:space-between;padding-bottom:19rpx;border-bottom:2rpx dashed rgba(212,176,95,.28);color:#d4b05f;font:700 18rpx "DIN Alternate",sans-serif;letter-spacing:3rpx}.field{display:block;margin-top:24rpx}.field>text,.capacity-grid text{display:block;margin-bottom:10rpx;color:#91a397;font-size:20rpx}.field input,.field textarea,.picker,.capacity-grid input{width:100%;box-sizing:border-box;padding:19rpx;border:2rpx solid rgba(85,239,139,.18);background:#07110d;color:#eef7f1;font-size:23rpx}.field textarea{height:138rpx}.rule-grid{display:grid;grid-template-columns:1fr 1fr;gap:15rpx}.capacity-board{margin-top:31rpx;padding:24rpx;background:rgba(31,65,44,.55)}.section-title{display:block;margin-top:8rpx;font-size:30rpx;font-weight:800}.capacity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:22rpx}.capacity-grid label{min-width:0}.capacity-grid input{text-align:center;color:#55ef8b;font-size:30rpx;font-weight:800}.error{display:block;margin-top:22rpx;color:#ff9c8e;font-size:21rpx;line-height:1.5}.save,.secondary{border-radius:0;font-weight:800}.save::after,.secondary::after{border:0}.save{margin-top:28rpx;background:#55ef8b;color:#07110d}.save[disabled]{background:#294536;color:#82978a}.secondary{margin:24rpx 0 0;border:2rpx solid rgba(85,239,139,.4);background:transparent;color:#55ef8b}.state-card{min-height:300rpx;display:flex;flex-direction:column;justify-content:center}.state-title{font-size:31rpx;font-weight:800}
