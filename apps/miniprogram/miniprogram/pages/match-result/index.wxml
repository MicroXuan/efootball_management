<view class="result-page">
  <canvas canvas-id="result-evidence-canvas" class="evidence-canvas" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"></canvas>
  <loading-state wx:if="{{loading && !item}}" label="正在核对比赛" />
  <view wx:elif="{{item}}" class="result-content">
    <view class="state-head">
      <view><text class="eyebrow">{{item.competition.name}} · 第 {{item.match.roundNumber}} 轮</text><text class="state-title">{{statusLabel}}</text></view>
      <text class="state-mark">{{item.match.stageDisplayName || '赛果'}}</text>
    </view>

    <view class="score-body">
      <view class="team-side"><text class="team-side-label">主队</text><text class="team-name">{{item.match.homeParticipant.displayName}}</text></view>
      <view class="score-center"><text class="score-value">{{scoreCopy}}</text><text class="score-caption">{{state === 'DONE' ? '最终比分' : state === 'SUBMIT' ? '等待录入' : '提交比分'}}</text></view>
      <view class="team-side team-away"><text class="team-side-label">客队</text><text class="team-name">{{item.match.awayParticipant.displayName}}</text></view>
    </view>

    <view class="status-rail">
      <view class="rail-deadline"><view class="rail-dot {{state === 'CONFIRMATION_EXPIRED' ? 'rail-dot-alert' : ''}}"></view><text>{{deadlineCopy}}</text></view>
      <view wx:if="{{state === 'EVIDENCE_COLLECTION' || state === 'READY_FOR_REVIEW' || (state === 'DONE' && dispute)}}" class="rail-evidence">
        <view class="rail-party"><view class="rail-dot {{evidenceStatus.submitter === '已提交' ? 'rail-dot-done' : ''}}"></view><text>提交方证据</text><text>{{evidenceStatus.submitter}}</text></view>
        <view class="rail-party"><view class="rail-dot {{evidenceStatus.opponent === '已提交' ? 'rail-dot-done' : ''}}"></view><text>对手证据</text><text>{{evidenceStatus.opponent}}</text></view>
      </view>
    </view>

    <view class="action-zone">
      <view wx:if="{{state === 'SUBMIT'}}">
        <text class="action-label">录入最终比分</text>
        <view class="score-inputs"><input type="number" maxlength="2" value="{{homeScore}}" disabled="{{acting || loading}}" bindinput="onHomeInput" aria-label="主队进球" /><text>:</text><input type="number" maxlength="2" value="{{awayScore}}" disabled="{{acting || loading}}" bindinput="onAwayInput" aria-label="客队进球" /></view>
        <view wx:if="{{item.evidenceRequired}}" class="evidence-choice"><text class="hint">本场须先上传比赛截图</text><button class="choice-button" disabled="{{acting || loading}}" loading="{{acting || loading}}" bindtap="chooseEvidence">{{evidenceSelected ? '更换截图' : '选择截图'}}</button><text wx:if="{{evidenceSelected}}" class="file-ready">{{evidenceSizeCopy}}</text></view>
        <button class="primary-action" disabled="{{acting || loading || !homeScore || !awayScore || (item.evidenceRequired && !evidenceSelected)}}" loading="{{acting || loading}}" bindtap="submit">提交比分给对手</button>
      </view>

      <view wx:elif="{{state === 'WAIT_CONFIRM'}}"><text class="action-label">比分已提交</text><text class="hint">等待对手在确认期限前确认或拒绝。页面会在状态更新后显示下一步。</text></view>

      <view wx:elif="{{state === 'CONFIRM'}}">
        <text class="action-label">核对对手提交的比分</text><text class="proposed-score">{{scoreCopy}}</text>
        <button class="primary-action" disabled="{{acting || loading}}" loading="{{acting || loading}}" bindtap="confirm">确认比分</button>
        <view class="reject-area"><text class="warning">拒绝后将进入证据收集，双方都可提交一张截图。</text><textarea maxlength="512" placeholder="填写拒绝原因" value="{{reason}}" disabled="{{acting || loading}}" bindinput="onReasonInput" /><button class="secondary-action" disabled="{{acting || loading || !reason}}" loading="{{acting || loading}}" bindtap="reject">拒绝并开启争议</button></view>
      </view>

      <view wx:elif="{{state === 'CONFIRMATION_EXPIRED'}}">
        <view wx:if="{{canOpenTimeout}}"><text class="action-label">对手未在 24 小时内确认</text><text class="hint">上传比赛截图后可申请争议，由管理员裁决。</text><button class="choice-button" disabled="{{acting || loading}}" loading="{{acting || loading}}" bindtap="chooseEvidence">{{evidenceSelected ? '更换截图' : '选择截图'}}</button><text wx:if="{{evidenceSelected}}" class="file-ready">{{evidenceSizeCopy}}</text><button class="primary-action" disabled="{{acting || loading || !evidenceSelected}}" loading="{{acting || loading}}" bindtap="openTimeout">上传证据并申请争议</button></view>
        <text wx:else class="hint">确认期限已结束，等待原提交方申请争议。</text>
      </view>

      <view wx:elif="{{state === 'EVIDENCE_COLLECTION'}}">
        <text class="action-label">提交你的比赛截图</text><text class="hint">{{myRole === 'SUBMITTER' ? '你是比分提交方' : '你是对手方'}}。证据期内可替换自己的一张截图。</text>
        <button class="choice-button" disabled="{{acting || loading}}" loading="{{acting || loading}}" bindtap="chooseEvidence">{{evidenceSelected ? '更换截图' : '选择截图'}}</button><text wx:if="{{evidenceSelected}}" class="file-ready">{{evidenceSizeCopy}}</text>
        <button class="primary-action" disabled="{{acting || loading || !evidenceSelected || !canUploadEvidence}}" loading="{{acting || loading}}" bindtap="attachEvidence">{{myRole === 'SUBMITTER' && evidenceStatus.submitter === '已提交' || myRole === 'OPPONENT' && evidenceStatus.opponent === '已提交' ? '替换我的证据' : '上传我的证据'}}</button>
      </view>

      <view wx:elif="{{state === 'READY_FOR_REVIEW'}}"><text class="action-label">等待管理员裁决</text><text class="hint">{{canUploadEvidence ? '截止前仍可更新自己的证据。' : '证据收集已结束。'}}双方提交状态见上方，证据内容仅管理员可查看。</text><view wx:if="{{canUploadEvidence}}"><button class="choice-button" disabled="{{acting || loading}}" loading="{{acting || loading}}" bindtap="chooseEvidence">{{evidenceSelected ? '更换截图' : '选择截图'}}</button><text wx:if="{{evidenceSelected}}" class="file-ready">{{evidenceSizeCopy}}</text><button class="primary-action" disabled="{{acting || loading || !evidenceSelected}}" loading="{{acting || loading}}" bindtap="attachEvidence">{{canReplaceEvidence ? '替换我的证据' : '上传我的证据'}}</button></view></view>

      <view wx:elif="{{state === 'DONE'}}"><text class="action-label">最终比分</text><text class="final-score">{{scoreCopy}}</text><text class="hint">本场赛果已确定。</text></view>
    </view>

    <text wx:if="{{errorMessage}}" class="error" role="alert">{{errorMessage}}</text>
    <view wx:if="{{state === 'DONE' && timeline.length}}" class="timeline"><text class="timeline-title">赛果记录</text><view wx:for="{{timeline}}" wx:key="index" class="timeline-row"><text class="timeline-time">{{item.at}}</text><view><text class="timeline-label">{{item.label}}</text><text wx:if="{{item.reason}}" class="timeline-reason">原因：{{item.reason}}</text></view></view></view>
  </view>
  <view wx:else class="empty-state"><text>{{errorMessage || '比赛不存在或已不可操作'}}</text><button bindtap="retry">重新加载</button></view>
</view>
