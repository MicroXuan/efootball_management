page{background:#0a0a0a;color:#f7f8f5}.result-page{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 36rpx) 28rpx}.kicker{display:block;color:#b0ff00;font-size:17rpx;letter-spacing:5rpx}.title{display:block;margin-top:8rpx;font-family:inherit;font-size:52rpx;font-weight:700}.scoreboard{margin-top:50rpx;padding:34rpx 20rpx;display:grid;grid-template-columns:1fr 50rpx 1fr;align-items:center;border:2rpx solid #294c3a;background:#171917;text-align:center;font-size:26rpx;font-weight:800}.divider{color:#d9e342}.form{margin-top:28rpx;padding:28rpx;border:2rpx solid #294c3a;background:#171917}.label{display:block;color:#a0a69d;font-size:21rpx}.score-inputs{margin:30rpx 0;display:flex;align-items:center;justify-content:center;gap:22rpx;font-size:38rpx}.score-inputs input{width:150rpx;height:100rpx;border:2rpx solid #365744;color:#b0ff00;font-size:48rpx;text-align:center}.form button{background:#b0ff00;color:#0a0a0a;font-weight:800}.form button::after{border:0}.proposal{display:block;margin:30rpx 0;color:#b0ff00;font-size:58rpx;text-align:center}.form textarea{width:100%;height:130rpx;margin:18rpx 0;box-sizing:border-box;padding:18rpx;border:1rpx solid #365744;color:#f7f8f5}.form .reject{border:2rpx solid #d9e342;background:transparent;color:#d9e342}.error{display:block;margin-top:22rpx;color:#d9e342;font-size:22rpx}
