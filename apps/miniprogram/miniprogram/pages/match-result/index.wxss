page{background:#0b100e;color:#f5f7f6}.result-page{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 36rpx) 28rpx}.kicker{display:block;color:#66f05a;font-size:17rpx;letter-spacing:5rpx}.title{display:block;margin-top:8rpx;font-family:STKaiti,KaiTi,serif;font-size:52rpx;font-weight:700}.scoreboard{margin-top:50rpx;padding:34rpx 20rpx;display:grid;grid-template-columns:1fr 50rpx 1fr;align-items:center;border:2rpx solid #294c3a;background:#141c18;text-align:center;font-size:26rpx;font-weight:800}.divider{color:#f0b84b}.form{margin-top:28rpx;padding:28rpx;border:2rpx solid #294c3a;background:#141c18}.label{display:block;color:#98a69f;font-size:21rpx}.score-inputs{margin:30rpx 0;display:flex;align-items:center;justify-content:center;gap:22rpx;font-size:38rpx}.score-inputs input{width:150rpx;height:100rpx;border:2rpx solid #365744;color:#66f05a;font-size:48rpx;text-align:center}.form button{background:#66f05a;color:#07110d;font-weight:800}.form button::after{border:0}.proposal{display:block;margin:30rpx 0;color:#66f05a;font-size:58rpx;text-align:center}.form textarea{width:100%;height:130rpx;margin:18rpx 0;box-sizing:border-box;padding:18rpx;border:1rpx solid #365744;color:#f5f7f6}.form .reject{border:2rpx solid #f0b84b;background:transparent;color:#f0b84b}.error{display:block;margin-top:22rpx;color:#f0b84b;font-size:22rpx}
