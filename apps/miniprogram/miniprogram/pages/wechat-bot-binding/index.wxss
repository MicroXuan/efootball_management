page { background:#0e1417; color:#f4f7f8; }
.binding-page { min-height:100vh; box-sizing:border-box; padding:calc(env(safe-area-inset-top) + 34rpx) 30rpx calc(env(safe-area-inset-bottom) + 54rpx); background:radial-gradient(circle at 86% 2%, rgba(182,241,58,.1), transparent 28%), #0e1417; }
.page-head { display:flex; align-items:flex-end; justify-content:space-between; }
.head-kicker,.head-title { display:block; }
.head-kicker,.status-label,.state-code { color:#aab5ba; font-size:17rpx; letter-spacing:5rpx; }
.head-title { margin-top:8rpx; font-size:50rpx; font-weight:800; }
.head-mark { color:#7e8b91; font-size:18rpx; letter-spacing:3rpx; }
.status-card,.code-card,.steps-card,.state-card { margin-top:34rpx; padding:30rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; }
.status-title,.state-title { display:block; margin-top:16rpx; font-size:34rpx; font-weight:800; }
.status-copy,.state-copy { display:block; margin-top:12rpx; color:#aab5ba; font-size:23rpx; line-height:1.65; }
.code-card { text-align:center; border-color:rgba(182,241,58,.45); }
.code-label { display:block; color:#aab5ba; font-size:19rpx; }
.code-value { display:block; margin-top:18rpx; color:#b6f13a; font-size:68rpx; font-weight:800; letter-spacing:8rpx; }
.countdown { display:block; margin-top:10rpx; color:#f4f7f8; font-size:23rpx; }
.instruction { margin-top:28rpx; padding:22rpx; display:flex; justify-content:space-between; gap:16rpx; border-radius:14rpx; background:#0e1417; color:#f4f7f8; font-size:22rpx; text-align:left; }
.copy-action { flex:none; color:#b6f13a; }
.security-note { display:block; margin-top:18rpx; color:#7e8b91; font-size:19rpx; }
.primary-button,.danger-button,.outline-button { min-height:88rpx; margin-top:28rpx; border-radius:16rpx; font-size:24rpx; font-weight:800; }
.primary-button::after,.danger-button::after,.outline-button::after { border:0; }
.primary-button { background:#b6f13a; color:#111810; }
.primary-button[disabled] { background:#344047; color:#7e8b91; }
.danger-button { border:2rpx solid #925654; background:transparent; color:#ffaaa5; }
.outline-button { margin-left:0; padding:0 30rpx; border:2rpx solid #344047; background:#1c262b; color:#f4f7f8; }
.error-copy { display:block; margin-top:22rpx; color:#ffaaa5; font-size:21rpx; }
.steps-title { display:block; color:#b6f13a; font-size:24rpx; font-weight:800; }
.step { display:block; margin-top:18rpx; color:#aab5ba; font-size:22rpx; line-height:1.65; }
.state-card { min-height:360rpx; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; }
