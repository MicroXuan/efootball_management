<view class="binding-page">
  <view class="page-head">
    <view><text class="head-kicker">微信群助手</text><text class="head-title">群机器人关联</text></view>
    <text class="head-mark">BOT · 01</text>
  </view>
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取关联状态" />
  <view wx:elif="{{state === 'error'}}" class="state-card">
    <text class="state-title">暂时无法加载</text>
    <text class="state-copy">{{view.errorMessage}}</text>
    <button class="outline-button efm-retry-button" bindtap="loadStatus">重新加载</button>
  </view>
  <block wx:else>
    <view class="status-card">
      <text class="status-label">当前状态</text>
      <text class="status-title">{{view.stateTitle}}</text>
      <text class="status-copy">{{view.stateCopy}}</text>
    </view>
    <text wx:if="{{view.errorMessage}}" class="error-copy">{{view.errorMessage}}</text>
    <button wx:if="{{view.showUnbind}}" class="danger-button" disabled="{{busy}}" loading="{{busy}}" bindtap="unbind">{{busy ? '正在处理' : '解除关联'}}</button>
    <button class="outline-button" disabled="{{busy}}" bindtap="loadStatus">刷新关联状态</button>
    <view class="steps-card">
      <text class="steps-title">直接在微信群使用</text>
      <text class="step">管理员在后台将微信成员与你的用户编号关联。</text>
      <text class="step">关联完成后，在授权群发送“我的赛程”或按拍卖规则出价即可。</text>
      <text class="step">公开赛程查询无需关联；球队和联赛权限仍按系统规则校验。</text>
    </view>
  </block>
</view>
