<view class="page-shell"><loading-state wx:if="{{state === 'loading'}}" label="正在加载交易记录"/><view wx:elif="{{state === 'error'}}" class="panel"><text>{{errorMessage}}</text><button bindtap="loadPage">重新加载</button></view><block wx:else><view class="hero"><text class="kicker">联赛公开记录</text><text class="title">交易记录</text><text class="muted">仅展示正式交易事实与手续费快照</text></view><view wx:if="{{!items.length}}" class="panel">暂无交易记录</view><view class="transaction" wx:for="{{items}}" wx:key="id"><view class="heading"><text>{{item.playerName}}</text><text class="pill">{{item.typeLabel}}</text></view><text class="teams">{{item.teamsCopy}}</text><view class="details"><text>成交额 {{item.amountCopy}}</text><text>{{item.valuationCopy}}</text><text>{{item.feeCopy}}</text></view><text class="muted">备注：{{item.reason}}</text></view><button wx:if="{{nextCursor}}" class="more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button></block></view>
