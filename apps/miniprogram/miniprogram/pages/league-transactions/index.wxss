page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;padding:54rpx 28rpx 110rpx;background:#0e1417;box-sizing:border-box}.kicker,.muted{display:block;color:#9eaaaf;font-size:21rpx}.title{display:block;margin:12rpx 0;font-size:44rpx;font-weight:850}.panel,.transaction{padding:25rpx;border:1rpx solid #344047;border-radius:20rpx;background:#151d21}.panel,.transaction{margin-top:18rpx}.heading{display:flex;justify-content:space-between;font-size:28rpx;font-weight:800}.pill{padding:6rpx 12rpx;border-radius:18rpx;background:#29343a;color:#b6f13a;font-size:19rpx}.teams{display:block;margin:18rpx 0;color:#dce3e6}.details{display:grid;grid-template-columns:1fr 1fr;gap:8rpx;color:#c4cdd1;font-size:21rpx}.panel button,.more{margin-top:18rpx;border-radius:16rpx;background:#b6f13a;color:#111}
