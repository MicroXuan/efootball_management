<view class="page-shell">
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取球队档案" />
  <view wx:elif="{{state === 'error'}}" class="panel"><text class="headline">暂时无法读取</text><text class="muted">{{errorMessage}}</text></view>
  <block wx:else>
    <view class="hero team-hero">
      <entity-artwork class="team-hero__crest" src="{{overview.team.logoUrl}}" fallback="{{overview.team.shortName}}" shape="square" />
      <view class="team-hero__copy"><text class="kicker">{{overview.leagueName}}</text><text class="title">{{overview.team.teamNumber}}-{{overview.team.name}}</text><text class="muted">（{{overview.team.ownerAlias}}） · 用户编号 {{overview.team.ownerPublicUserNo}}</text></view>
    </view>
    <view class="metrics"><view><text class="value">{{overview.team.activePlayerCount}}/25</text><text class="label">阵容</text></view><view><text class="value {{overCap ? 'danger' : ''}}">{{overview.team.salaryTotalMinor}}/{{overview.team.salaryCapMinor}}</text><text class="label">工资 / 工资帽</text></view></view>
    <view class="workspace-grid">
      <button wx:for="{{actions}}" wx:key="key" class="workspace-link" data-url="{{item.url}}" bindtap="openSection">
        <text class="workspace-link__marker">{{item.marker}}</text>
        <view class="workspace-link__copy"><text class="workspace-link__label">{{item.label}}</text><text class="workspace-link__description">{{item.description}}</text></view>
        <text class="workspace-link__arrow">›</text>
      </button>
    </view>
    <view class="section"><text class="section-title">阵容球员</text><view wx:if="{{rosterEmpty}}" class="panel"><text class="muted">当前阵容为空</text></view><view wx:else class="roster-grid"><view wx:for="{{roster}}" wx:key="id" class="player"><view class="position-badge position-badge--{{item.positionTone}}">{{item.position}}</view><view class="player-copy"><text class="player-name">{{item.playerName}}</text><view class="player-meta"><text>{{item.heightCopy}}</text><text>位置 {{item.positionCopy}}</text><text>工资 {{item.salaryCopy}}</text></view></view></view></view></view>
  </block>
</view>
