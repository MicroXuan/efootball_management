<view class="page-shell">
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取球队档案" />
  <view wx:elif="{{state === 'error'}}" class="panel"><text class="headline">暂时无法读取</text><text class="muted">{{errorMessage}}</text></view>
  <block wx:else>
    <view class="hero team-hero">
      <entity-artwork class="team-hero__crest" src="{{overview.team.logoUrl}}" fallback="{{overview.team.shortName}}" shape="square" />
      <view class="team-hero__copy"><text class="kicker">{{overview.leagueName}}</text><text class="title">{{overview.team.teamNumber}}-{{overview.team.name}}</text><text class="muted">（{{overview.team.ownerAlias}}） · 用户编号 {{overview.team.ownerPublicUserNo}}</text></view>
    </view>
    <view class="metrics"><view class="metric"><text class="value">{{overview.team.activePlayerCount}}/25</text><text class="label">阵容人数</text></view><view class="metric"><text class="value {{overCap ? 'danger' : ''}}">{{overview.team.salaryTotalMinor}} / {{overview.team.salaryCapMinor ? overview.team.salaryCapMinor : '待管理员设置'}}</text><text class="label">工资 / 工资帽</text></view></view>
    <view class="section workspace-section">
      <text class="section-title">球队操作</text>
      <view class="directory-link" role="button" aria-label="查看联赛其他球队阵容" bindtap="openTeamDirectory">
        <view class="directory-link__copy"><text class="directory-link__label">联赛球队</text><text class="directory-link__description">查看其他球队阵容</text></view>
        <text class="directory-link__arrow">›</text>
      </view>
      <view class="workspace-grid">
        <view wx:for="{{actions}}" wx:key="key" class="workspace-link {{item.enabled ? '' : 'workspace-link--disabled'}}" role="button" aria-label="{{item.label}}，{{item.description}}" aria-disabled="{{!item.enabled}}" data-url="{{item.url}}" bindtap="openSection">
          <text class="workspace-link__marker">{{item.marker}}</text>
          <view class="workspace-link__copy"><text class="workspace-link__label">{{item.label}}</text><text class="workspace-link__description">{{item.description}}</text></view>
          <text class="workspace-link__arrow">{{item.enabled ? '›' : '—'}}</text>
        </view>
      </view>
    </view>
    <view class="section roster-section"><text class="section-title">阵容球员</text><view wx:if="{{rosterEmpty}}" class="panel"><text class="muted">当前阵容为空</text></view><view wx:else class="roster-grid"><view wx:for="{{roster}}" wx:key="id" class="player"><view class="position-badge position-badge--{{item.positionTone}}">{{item.position}}</view><view class="player-copy"><text class="player-name">{{item.playerName}}</text><view class="player-meta"><text>{{item.heightCopy}}</text><text>位置 {{item.positionCopy}}</text><text>工资 {{item.salaryCopy}}</text></view></view></view></view></view>
  </block>
</view>
