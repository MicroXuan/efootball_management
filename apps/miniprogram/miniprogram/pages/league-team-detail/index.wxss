page{background:#07110d;color:#eef7f1}.page-shell{min-height:100vh;padding:58rpx 30rpx 90rpx;box-sizing:border-box;background:linear-gradient(160deg,#07110d,#102219)}.kicker,.label{display:block;color:#d4b05f;font-size:19rpx;letter-spacing:3rpx}.title{display:block;margin-top:12rpx;font:700 48rpx STKaiti,KaiTi,serif}.muted{display:block;margin-top:8rpx;color:#8ea497;font-size:22rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:38rpx}.metrics view,.panel,.player,.ledger-row{padding:26rpx;border:2rpx solid rgba(85,239,139,.22);background:rgba(13,29,20,.9)}.value{display:block;font-size:36rpx;font-weight:700}.label{margin-top:10rpx;letter-spacing:1rpx}.section{margin-top:48rpx}.section-title{display:block;margin-bottom:20rpx;font-size:32rpx;font-weight:700}.window-open,.readonly{display:block;color:#55ef8b}.readonly{margin-top:18rpx;color:#d4b05f;font-size:21rpx}.roster-grid{display:grid;gap:14rpx}.player{display:flex;align-items:center}.rating{width:82rpx;color:#55ef8b;font-size:38rpx;font-weight:800}.player-name{display:block;font-size:27rpx;font-weight:700}.ledger-row{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx}.amount{color:#55ef8b;font-weight:700}.danger{color:#ff9c8e!important}
