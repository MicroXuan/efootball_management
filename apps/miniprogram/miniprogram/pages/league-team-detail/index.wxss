page{background:#0e1417;color:#f4f7f8}.page-shell{min-height:100vh;padding:58rpx 30rpx 100rpx;box-sizing:border-box;background:radial-gradient(circle at 92% 2%,rgba(182,241,58,.06),transparent 28%),#0e1417}.kicker,.label{display:block;color:#aab5ba;font-size:19rpx;letter-spacing:3rpx}.title{display:block;margin-top:12rpx;font:800 48rpx inherit}.muted{display:block;margin-top:8rpx;color:#aab5ba;font-size:22rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:38rpx}.metrics view,.panel,.player,.ledger-row{padding:26rpx;border:2rpx solid #344047;border-radius:20rpx;background:#151d21}.value{display:block;font-size:36rpx;font-weight:800}.label{margin-top:10rpx;letter-spacing:1rpx}.section{margin-top:48rpx}.section-title{display:block;margin-bottom:20rpx;font-size:32rpx;font-weight:800}.window-open,.readonly{display:block;color:#f4f7f8}.readonly{margin-top:18rpx;color:#aab5ba;font-size:21rpx}.roster-grid{display:grid;gap:14rpx}.player{display:flex;align-items:center}.rating{width:82rpx;color:#f4f7f8;font-size:38rpx;font-weight:850}.player-name{display:block;font-size:27rpx;font-weight:750}.ledger-row{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx}.amount{color:#f4f7f8;font-weight:750}.danger{color:#ff9c8e!important}.valuation-entry{margin:22rpx 0 0;border:0;border-radius:18rpx;background:#b6f13a;color:#111;font-weight:850}.valuation-entry::after{border:0}
