page { background: #0e1417; color: #f4f7f8; }
.detail-page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 20rpx) 26rpx calc(env(safe-area-inset-bottom) + 50rpx); background: radial-gradient(circle at 15% 0%, rgba(182, 241, 58,.12), transparent 28%), #0e1417; }
.hero { padding: 30rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: linear-gradient(145deg, #1c262b, #151d21 66%); box-shadow: 0 16rpx 44rpx rgba(0,0,0,.18); }
.hero-top, .scoreboard, .fact, .versus { display: flex; justify-content: space-between; align-items: center; }
.status { color: #b6f13a; font-size: 19rpx; letter-spacing: 3rpx; }
.serial, .panel-kicker, .round { color: #7e8b91; font-family:inherit; font-size: 17rpx; letter-spacing: 2rpx; }
.name { display: block; margin-top: 30rpx; font-family:inherit; font-size: 48rpx; font-weight: 700; line-height: 1.3; }
.description { display: block; margin-top: 14rpx; color: #aab6af; font-size: 23rpx; line-height: 1.65; }
.scoreboard { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid #46545b; }
.scoreboard > view:last-child { text-align: right; }
.score-label, .score-value { display: block; }
.score-label { color: #7e8b91; font-size: 17rpx; }
.score-value { margin-top: 7rpx; color: #aab5ba; font-size: 22rpx; }
.tabs { margin: 26rpx 0; display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 2rpx solid #344047; }
.tabs.tabs--four { grid-template-columns: repeat(4, 1fr); }
.tab { margin: 0; padding: 20rpx 0; border: 0; border-radius:20rpx; background: transparent; color: #7e8b91; font-size: 23rpx; }
.tab::after { border: 0; }
.tab.is-active { border-bottom: 4rpx solid #b6f13a; color: #eaffE8; }
.section-stack { display: flex; flex-direction: column; gap: 20rpx; }
.panel, .match-card, .standing-table, .empty-panel { padding: 26rpx; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; }
.panel-title { display: block; margin: 8rpx 0 20rpx; font-size: 29rpx; font-weight: 800; }
.fact { padding: 17rpx 0; border-top: 1rpx solid #2d393f; color: #c6d1cb; font-size: 22rpx; }
.fact text:last-child { color: #f4f7f8; }
.rule-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.rule-grid text { padding: 20rpx; border: 1rpx solid #46545b; color: #aab5ba; text-align: center; }
.account { margin-top: 12rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid #344047; border-radius: 16rpx; color: #aab5ba; font-size: 19rpx; }
.account.is-selected { border-color: #b6f13a; background: #1c262b; color: #b6f13a; }
.account.is-disabled { opacity: .45; }
.account-name, .account-meta { display: block; }
.account-name { color: #f4f7f8; font-size: 24rpx; }.account-meta { margin-top: 5rpx; font-size: 18rpx; }
.team-entry-hint { padding: 24rpx; display: grid; gap: 8rpx; border: 1rpx dashed #46545b; border-radius: 20rpx; color: #7e8b91; }
.team-entry-hint text:first-child { color: #f4f7f8; font-weight: 700; }
.registered-team { border-color: rgba(182,241,58,.34); background: linear-gradient(145deg, rgba(182,241,58,.08), #151d21); }
.primary-button, .danger-button, .outline-button, .manager-button { min-height: 88rpx; border-radius: 16rpx; font-size: 24rpx; font-weight: 700; }
.primary-button { background: #b6f13a; color: #0e1417; }.primary-button[disabled] { background: #263238; color: #7e8b91; }
.danger-button { border: 2rpx solid #aab5ba; background: transparent; color: #aab5ba; }
.manager-button { border: 2rpx solid #aab5ba; background: #392f1b; color: #ffe3a8; }
.primary-button::after, .danger-button::after, .outline-button::after, .manager-button::after { border: 0; }
.match-card { position: relative; }.versus { margin-top: 18rpx; gap: 16rpx; font-size: 24rpx; font-weight: 700; }.vs { color: #aab5ba; font-size: 18rpx; }
.official-score { display: block; margin-top: 18rpx; color: #b6f13a; font-family:inherit; font-size: 36rpx; text-align: center; }
.standing-row { display: grid; grid-template-columns: 45rpx 1fr 60rpx 70rpx 70rpx; gap: 8rpx; padding: 17rpx 0; border-top: 1rpx solid #2d393f; color: #c6d1cb; font-size: 21rpx; }
.standing-head { border-top: 0; color: #7e8b91; font-size: 17rpx; }.points { color: #b6f13a; font-weight: 800; }
.empty-panel { min-height: 180rpx; display: flex; align-items: center; color: #aab5ba; font-size: 23rpx; line-height: 1.6; }
.bracket-summary { padding: 24rpx 26rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid #344047; border-radius: 24rpx; background: #151d21; }
.bracket-summary .panel-title { margin-bottom: 0; }
.bracket-current { padding: 10rpx 16rpx; border: 1rpx solid #52652c; border-radius: 40rpx; color: #b6f13a; font-size: 18rpx; }
.bracket-scroll { width: 100%; }
.bracket-track { padding-bottom: 18rpx; display: inline-flex; gap: 22rpx; }
.bracket-round { width: 490rpx; padding: 22rpx; flex: none; border: 2rpx solid #344047; border-radius: 22rpx; background: #151d21; opacity: .7; }
.bracket-round.is-current { border-color: #60782d; opacity: 1; box-shadow: inset 6rpx 0 0 #b6f13a; }
.bracket-round-head { margin-bottom: 18rpx; display: flex; align-items: center; justify-content: space-between; }
.bracket-round-head text:first-child { color: #f4f7f8; font-size: 24rpx; font-weight: 800; }
.bracket-round-head text:last-child { color: #7e8b91; font-size: 18rpx; }
.bracket-round.is-current .bracket-round-head text:last-child { color: #b6f13a; }
.bracket-pairings { display: flex; flex-direction: column; gap: 18rpx; }
.bracket-pairing { overflow: hidden; border: 1rpx solid #3c494f; border-radius: 16rpx; background: #1c262b; }
.bracket-team { min-height: 64rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid #344047; color: #aab5ba; font-size: 21rpx; }
.bracket-team:last-child { border-bottom: 0; }
.bracket-team.is-winner { color: #f4f7f8; background: rgba(182,241,58,.08); }
.bracket-team.is-winner text:last-child { color: #b6f13a; font-weight: 800; }
.inline-error, .state-copy { color: #aab5ba; font-size: 22rpx; line-height: 1.6; }
.state-panel { min-height: 600rpx; display: flex; flex-direction: column; justify-content: center; }.state-code { color: #aab5ba; font-size: 17rpx; letter-spacing: 4rpx; }.state-title { margin-top: 18rpx; font-size: 34rpx; font-weight: 800; }
.outline-button { width: 240rpx; margin: 28rpx 0 0; border: 2rpx solid #b6f13a; background: transparent; color: #b6f13a; }
.outline-button.wide { width: 100%; margin: 0; }
