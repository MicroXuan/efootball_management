<view class="page-shell detail-page" style="padding-top: calc({{statusBarHeight}}px + 26rpx);">
  <loading-state wx:if="{{state === 'loading'}}" label="正在读取赛季资料" />
  <view wx:elif="{{state === 'error'}}" class="state-card">
    <text class="state-code">赛季读取失败</text>
    <text class="state-title">暂时无法读取联赛</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="outline-button efm-retry-button" bindtap="loadPage">重新加载</button>
  </view>
  <block wx:else>
    <view class="league-hero league-hero--compact">
      <view class="league-hero__main">
        <view class="league-mark">
          <entity-artwork src="{{league.logoUrl}}" fallback="{{leagueLogoText}}" shape="square" surface="light" />
        </view>
        <view class="league-hero__copy">
          <text class="hero-kicker">{{leagueEditionLabel}} · 联赛中心</text>
          <text class="hero-title">{{league.name}}</text>
          <text class="hero-copy">{{league.description || '长期联赛赛季、报名和球队资格中心'}}</text>
        </view>
      </view>
      <view wx:if="{{selectedSeason}}" class="hero-season-row">
        <picker class="season-switcher__picker" range="{{seasonLabels}}" value="{{selectedSeasonIndex}}" bindchange="onSeasonChange">
          <view class="season-switcher">
            <view><text class="season-switcher__label">当前赛季</text><text class="season-switcher__name">{{selectedSeason.displayName}}</text></view>
            <view class="season-switcher__action">
              <text>切换</text>
              <view class="season-switcher__chevron"></view>
            </view>
          </view>
        </picker>
        <status-badge label="{{seasonStatusLabel}}" tone="{{seasonStatusTone}}" />
      </view>
    </view>

    <view wx:if="{{selectedSeason}}" class="entry-card entry-card--priority">
      <view class="entry-summary">
        <view><text class="section-kicker">我的资格</text><text class="entry-summary__status">{{entryStatus}}</text></view>
        <view wx:if="{{profile}}" class="entry-team"><view class="team-mark"><entity-artwork src="{{profile.logoUrl}}" fallback="{{profile.shortName}}" shape="square" /></view><text class="team-name">{{profile.name}}</text></view>
      </view>
      <text wx:if="{{errorMessage}}" class="error-copy">{{errorMessage}}</text>
    </view>

    <view wx:if="{{workspace && workspaceView}}" class="workspace-card">
      <view class="workspace-head">
        <view><text class="section-kicker">我的联赛</text><text class="workspace-title">赛季工作台</text></view>
        <text class="workspace-division">{{workspaceView.divisionName}}</text>
      </view>
      <view class="workspace-metrics">
        <view class="workspace-metric workspace-metric--rank"><text class="workspace-metric__label">当前排名</text><view class="workspace-rank-row"><text class="workspace-rank">{{workspaceView.rank}}</text><text wx:if="{{workspaceView.rankNotice}}" class="workspace-rank-notice">{{workspaceView.rankNotice}}</text></view><text class="workspace-metric__meta">{{workspaceView.rankMeta}}</text></view>
        <view class="workspace-metric workspace-metric--schedule" bindtap="openFixtures" role="button"><text class="workspace-metric__label">赛程中心</text><view class="workspace-schedule-action"><text class="workspace-next">全部赛程</text><text class="workspace-schedule-arrow">›</text></view><text class="workspace-metric__meta">按队伍和状态查找比赛</text></view>
      </view>
      <view class="directory-entry" bindtap="openTeamDirectory" role="button"><text>联赛球队阵容</text><text>查看全部球队 ›</text></view>
      <view class="workspace-groups">
        <view wx:for="{{workspaceModuleGroups}}" wx:key="key" wx:for-item="group" class="workspace-group">
          <view class="workspace-group__head"><text>{{group.label}}</text></view>
          <view class="module-grid">
            <block
              wx:for="{{group.modules}}"
              wx:key="key"
              wx:for-item="module"
            >
              <view
                class="module-tile {{module.enabled ? '' : 'is-locked'}} {{module.wide ? 'is-wide' : ''}} {{module.tone === 'personal' ? 'is-personal' : ''}}"
                data-key="{{module.key}}"
                bindtap="onWorkspaceModuleTap"
                role="button"
                aria-disabled="{{!module.enabled}}"
              >
                <view class="module-topline">
                  <text class="module-marker">{{module.marker}}</text>
                  <text class="module-state">{{module.key === 'playerMarket' ? (marketAttentionCount ? marketAttentionCount + ' 项提醒' : module.stateLabel) : module.stateLabel}}</text>
                </view>
                <text class="module-title">{{module.label}}</text>
                <view class="module-footer">
                  <text class="module-description">{{module.description}}</text>
                  <text class="module-arrow">{{module.enabled ? '→' : '锁定'}}</text>
                </view>
              </view>
              <view wx:if="{{group.key === 'transactions' && module.key === 'playerMarket' && playerAuctionEnabled}}" class="module-tile is-auction" bindtap="openPlayerAuctions" role="button">
                <view class="module-topline">
                  <text class="module-marker">拍</text>
                  <text class="module-state">{{auctionAttentionCount ? auctionAttentionCount + ' 项提醒' : '实时开放'}}</text>
                </view>
                <text class="module-title">球员拍卖</text>
                <view class="module-footer">
                  <text class="module-description">进入小程序拍卖大厅</text>
                  <text class="module-arrow">→</text>
                </view>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{selectedSeason}}" class="season-overview-card">
      <view class="board-head">
        <view><text class="section-kicker">赛季概览</text><text class="board-title">{{selectedSeason.displayName}}</text></view>
        <text class="season-number">S{{selectedSeason.seasonNumber}}</text>
      </view>
      <text class="structure-copy">{{structureCopy}}</text>
      <view class="season-overview__rail"><text class="season-overview__label">赛季进程</text><season-rail steps="{{seasonRail}}" /></view>
      <view class="metric-grid">
        <view><text class="metric-value">{{selectedSeason.approvedEntryCount}}</text><text class="metric-label">已确认球队</text></view>
        <view><text class="metric-value">{{selectedSeason.championCapacity}}</text><text class="metric-label">冠军组上限</text></view>
        <view><text class="metric-value">{{selectedSeason.promotionCount}}</text><text class="metric-label">升级建议数</text></view>
      </view>
      <view class="timeline"><text>报名截止</text><text>{{registrationCloseDate}}</text></view>
    </view>

    <view wx:if="{{!selectedSeason}}" class="state-card compact">
      <text class="state-code">等待发布</text>
      <text class="state-title">暂无公开赛季</text>
      <text class="state-copy">等待联赛管理员发布新赛季。</text>
    </view>
  </block>
</view>
