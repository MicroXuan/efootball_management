page { background:#07110d; color:#eef7f1; }.page-shell{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 26rpx) 28rpx 90rpx;background:linear-gradient(165deg,#07110d,#0d2117 56%,#101611)}
.league-hero{position:relative;padding:42rpx 30rpx 34rpx;border:2rpx solid rgba(85,239,139,.25);background:radial-gradient(circle at 90% 10%,rgba(85,239,139,.18),transparent 34%),rgba(10,27,18,.95);overflow:hidden}.league-logo{width:112rpx;height:112rpx;background:#07110d}.logo-fallback,.team-fallback{display:flex;align-items:center;justify-content:center;color:#55ef8b;font-family:"DIN Alternate",sans-serif;font-weight:800}.hero-kicker,.board-kicker,.section-kicker,.state-code{display:block;margin-top:28rpx;color:#d4b05f;font-size:17rpx;letter-spacing:4rpx}.hero-title{display:block;margin-top:10rpx;font-family:STKaiti,KaiTi,serif;font-size:48rpx;font-weight:800}.hero-copy,.structure-copy,.state-copy{display:block;margin-top:15rpx;color:#95aa9d;font-size:22rpx;line-height:1.65}
.season-picker-card,.season-board,.entry-card,.state-card{margin-top:20rpx;padding:28rpx;border:2rpx solid rgba(85,239,139,.2);background:rgba(11,27,19,.94)}.field-label{display:block;margin-bottom:11rpx;color:#82978a;font-size:20rpx}.picker-control,.board-head,.team-line,.timeline{display:flex;align-items:center}.picker-control,.board-head,.timeline{justify-content:space-between}.picker-control{min-height:80rpx;padding:0 21rpx;border-bottom:2rpx solid rgba(85,239,139,.28);background:#07110d;font-size:25rpx}.board-kicker{margin:0}.season-number{color:rgba(85,239,139,.45);font-size:28rpx;font-weight:800}.board-title,.section-title{display:block;margin-top:11rpx;font-size:34rpx;font-weight:800}.metric-grid{margin-top:28rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.metric-grid view{padding:20rpx 12rpx;background:rgba(32,69,46,.65)}.metric-value,.metric-label{display:block}.metric-value{color:#55ef8b;font-family:"DIN Alternate",sans-serif;font-size:36rpx;font-weight:800}.metric-label{margin-top:6rpx;color:#95aa9d;font-size:18rpx}.timeline{margin-top:18rpx;padding-top:18rpx;border-top:2rpx solid rgba(142,164,151,.14);color:#95aa9d;font-size:20rpx}
.section-kicker{margin:0}.team-line{margin-top:24rpx}.team-logo{width:82rpx;height:82rpx;margin-right:20rpx;background:#07110d}.team-name,.entry-status{display:block}.team-name{font-size:28rpx;font-weight:800}.entry-status{margin-top:7rpx;color:#95aa9d;font-size:20rpx}.account-select{margin-top:24rpx}.action-button,.outline-button{border-radius:0;font-weight:800}.action-button::after,.outline-button::after{border:0}.action-button{margin-top:26rpx;background:#55ef8b;color:#07110d}.action-button.secondary{border:2rpx solid rgba(212,176,95,.55);background:transparent;color:#d4b05f}.action-button.muted,.action-button[disabled]{background:#294536;color:#82978a}.error-copy{display:block;margin-top:20rpx;color:#ff9c8e;font-size:21rpx;line-height:1.5}.state-card{min-height:320rpx;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.state-card.compact{min-height:220rpx}.state-title{margin-top:18rpx;font-size:31rpx;font-weight:800}.outline-button{margin:25rpx 0 0;padding:0 26rpx;border:2rpx solid rgba(85,239,139,.4);background:transparent;color:#55ef8b;font-size:23rpx}
.manager-button{margin:24rpx 0 0;padding:0 24rpx;border:2rpx solid rgba(212,176,95,.5);border-radius:0;background:rgba(212,176,95,.1);color:#d4b05f;font-size:21rpx;font-weight:800}.manager-button::after{border:0}
.entry-readonly{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:20rpx;border:2rpx solid rgba(85,239,139,.2);background:#07110d}.entry-readonly-label{color:#82978a;font-size:20rpx}.entry-readonly-value{color:#55ef8b;font-size:22rpx;font-weight:800}
