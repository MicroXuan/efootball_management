page { background: #0e1417; color: #f4f7f8; }

.page-shell {
  padding: calc(env(safe-area-inset-top) + 26rpx) 28rpx 100rpx;
  background:
    radial-gradient(circle at 94% 3%, rgba(182, 241, 58, 0.08), transparent 28%),
    #0e1417;
}

.league-hero,
.season-overview-card,
.entry-card,
.workspace-card,
.state-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 2rpx solid #344047;
  border-radius: 24rpx;
  background: #151d21;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.18);
}

.league-hero {
  position: relative;
  margin-top: 0;
  overflow: hidden;
  padding: 22rpx;
  background:
    linear-gradient(135deg, rgba(182, 241, 58, 0.07), transparent 46%),
    #151d21;
}

.league-hero--compact { padding-bottom: 20rpx; }
.league-hero__main,
.hero-season-row,
.season-switcher,
.board-head,
.timeline,
.entry-summary,
.entry-team {
  display: flex;
  align-items: center;
}

.league-hero__main { display: flex; gap: 18rpx; }
.league-hero__copy { min-width: 0; flex: 1; }

.hero-season-row,
.season-switcher,
.board-head,
.timeline,
.entry-summary { justify-content: space-between; }

.league-mark { width: 72rpx; flex: none; }
.hero-kicker { display: block; color: #aab5ba; font-size: 16rpx; font-weight: 750; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 5rpx; font-size: 34rpx; font-weight: 850; letter-spacing: -1rpx; line-height: 1.18; }
.hero-copy { display: block; margin-top: 7rpx; color: #aab5ba; font-size: 18rpx; line-height: 1.45; }
.structure-copy,
.state-copy { display: block; margin-top: 12rpx; color: #aab5ba; font-size: 20rpx; line-height: 1.55; }

.hero-season-row {
  margin-top: 16rpx;
  padding-top: 14rpx;
  gap: 12rpx;
  border-top: 2rpx solid #2d393f;
}
.season-switcher__picker { min-width: 0; flex: 1; }
.season-switcher { min-height: 58rpx; padding: 0 14rpx; border: 2rpx solid #344047; border-radius: 14rpx; background: #1c262b; }
.season-switcher__label { display: block; color: #7e8b91; font-size: 15rpx; font-weight: 700; letter-spacing: 2rpx; }
.season-switcher__name { display: block; margin-top: 2rpx; font-size: 20rpx; font-weight: 850; }
.season-switcher__action { height: 42rpx; padding: 0 4rpx 0 12rpx; display: flex; flex: none; align-items: center; gap: 10rpx; color: #b6f13a; font-size: 17rpx; font-weight: 800; }
.season-switcher__chevron { width: 12rpx; height: 12rpx; box-sizing: border-box; border-right: 3rpx solid #b6f13a; border-bottom: 3rpx solid #b6f13a; transform: rotate(45deg) translateY(-3rpx); }

.section-kicker,
.board-kicker,
.state-code {
  display: block;
  color: #aab5ba;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 4rpx;
}

.section-title,
.board-title { display: block; margin-top: 7rpx; font-size: 30rpx; font-weight: 800; }
.season-number { color: #7e8b91; font-size: 28rpx; font-weight: 800; }
.season-overview__rail { margin-top: 24rpx; padding: 20rpx 18rpx; border: 2rpx solid #2d393f; border-radius: 18rpx; background: #1c262b; }
.season-overview__label { display: block; margin-bottom: 24rpx; color: #aab5ba; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }

.metric-grid { margin-top: 30rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.metric-grid view { min-width: 0; padding: 22rpx 14rpx; border: 2rpx solid #2d393f; border-radius: 16rpx; background: #1c262b; }
.metric-value,
.metric-label { display: block; }
.metric-value { font-size: 38rpx; font-weight: 850; }
.metric-label { margin-top: 7rpx; color: #aab5ba; font-size: 18rpx; line-height: 1.35; }
.timeline { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid #2d393f; color: #aab5ba; font-size: 20rpx; }

.entry-card { padding: 22rpx 26rpx; }
.entry-card--priority { border-color: #546b37; background: #1a2420; }
.entry-summary { gap: 18rpx; }
.entry-summary__status { display: block; margin-top: 7rpx; font-size: 24rpx; font-weight: 850; }
.entry-team { min-width: 0; justify-content: flex-end; }
.team-mark { width: 58rpx; margin-right: 12rpx; flex: none; }
.team-name { max-width: 180rpx; overflow: hidden; color: #d9efac; font-size: 20rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.error-copy { display: block; margin-top: 20rpx; color: #ffaaa5; font-size: 21rpx; line-height: 1.5; }

.state-card { min-height: 320rpx; display: flex; align-items: flex-start; justify-content: center; flex-direction: column; }
.state-card.compact { min-height: 220rpx; }
.state-title { margin-top: 18rpx; font-size: 32rpx; font-weight: 800; }
.outline-button { min-height: 76rpx; margin: 26rpx 0 0; padding: 0 26rpx; font-size: 23rpx; font-weight: 750; }
.workspace-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.workspace-title { display: block; margin-top: 9rpx; font-size: 34rpx; font-weight: 850; }
.workspace-division { padding: 10rpx 15rpx; border: 2rpx solid #546b37; border-radius: 18rpx; background: #202c25; color: #d9efac; font-size: 18rpx; font-weight: 800; }
.workspace-metrics { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 14rpx; margin-top: 26rpx; }
.workspace-metrics > view { min-width: 0; min-height: 164rpx; box-sizing: border-box; display: flex; flex-direction: column; padding: 22rpx; border: 2rpx solid #2d393f; border-radius: 18rpx; background: #1c262b; }
.workspace-metric--rank { border-color: #46584b; background: linear-gradient(145deg, rgba(182,241,58,.06), transparent 65%), #1c262b; }
.workspace-metric--schedule { border-color: #3c4b52; transition: border-color 120ms ease, background-color 120ms ease; }
.workspace-metric--schedule:active { border-color: #7eaa28; background: #202c25; }
.workspace-metric__label,
.workspace-metric__meta { display: block; color: #aab5ba; font-size: 17rpx; }
.workspace-rank-row { display: flex; align-items: center; gap: 10rpx; }
.workspace-rank { display: block; margin-top: 8rpx; color: #b6f13a; font-size: 52rpx; font-weight: 900; line-height: 1; }
.workspace-rank-notice { margin-top: 10rpx; padding: 4rpx 8rpx; border: 1rpx solid #6d7c56; border-radius: 8rpx; color: #d9efac; background: #202c25; font-size: 15rpx; font-weight: 750; }
.workspace-next { display: block; font-size: 24rpx; font-weight: 850; line-height: 1.35; }
.workspace-metric__meta { margin-top: auto; padding-top: 10rpx; line-height: 1.4; }
.workspace-schedule-action { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 14rpx; }
.workspace-schedule-arrow { width: 42rpx; height: 42rpx; flex: none; border: 2rpx solid #546b37; border-radius: 50%; color: #b6f13a; background: #202c25; font-size: 32rpx; font-weight: 700; line-height: 36rpx; text-align: center; }

.workspace-groups { margin-top: 20rpx; }
.workspace-group + .workspace-group { margin-top: 22rpx; }
.workspace-group__head { padding: 0 2rpx; color: #aab5ba; font-size: 16rpx; font-weight: 750; letter-spacing: 3rpx; }
.module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 10rpx; }
.module-tile { position: relative; min-width: 0; min-height: 148rpx; box-sizing: border-box; padding: 16rpx; overflow: hidden; border: 2rpx solid #344047; border-radius: 18rpx; background: #1c262b; }
.module-tile.is-wide { grid-column: span 2; min-height: 132rpx; }
.module-tile.is-personal { border-color: #46584b; background: #1a2420; }
.module-tile.is-auction { border-color: #546b37; background: #1a2420; }
.module-tile.is-locked { border-color: #2d393f; background: #171f23; }
.module-topline,
.module-footer { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.module-marker { width: 42rpx; height: 42rpx; border-radius: 12rpx; background: #b6f13a; color: #111810; font-size: 18rpx; font-weight: 900; line-height: 42rpx; text-align: center; }
.module-state { color: #b6f13a; font-size: 16rpx; font-weight: 750; }
.module-title { display: block; margin-top: 13rpx; color: #f4f7f8; font-size: 23rpx; font-weight: 850; }
.module-footer { align-items: flex-end; margin-top: 7rpx; }
.module-description { min-width: 0; color: #aab5ba; font-size: 17rpx; line-height: 1.45; }
.module-arrow { flex: none; color: #b6f13a; font-size: 24rpx; font-weight: 850; }
.module-tile.is-locked .module-marker { background: #273238; color: #7e8b91; }
.module-tile.is-locked .module-state,
.module-tile.is-locked .module-title,
.module-tile.is-locked .module-arrow { color: #7e8b91; }
.module-tile.is-locked .module-arrow { font-size: 16rpx; letter-spacing: 2rpx; }
@media (max-width:340px) { .workspace-metrics { grid-template-columns: 1fr; } .workspace-metrics > view { min-height: 142rpx; } }
