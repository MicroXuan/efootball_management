page { background: #0e1417; color: #f4f7f8; }

.page-shell {
  padding: calc(env(safe-area-inset-top) + 26rpx) 28rpx 100rpx;
  background:
    radial-gradient(circle at 94% 3%, rgba(182, 241, 58, 0.08), transparent 28%),
    #0e1417;
}

.league-hero,
.progress-card,
.season-picker-card,
.season-board,
.entry-card,
.standings-entry,
.workspace-card,
.state-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 2rpx solid #344047;
  border-radius: 24rpx;
  background: #151d21;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.18);
}

.league-hero {
  position: relative;
  margin-top: 0;
  overflow: hidden;
  padding: 34rpx;
  background:
    linear-gradient(135deg, rgba(182, 241, 58, 0.07), transparent 46%),
    #151d21;
}

.league-hero__topline,
.hero-season,
.section-heading,
.picker-control,
.board-head,
.team-line,
.timeline,
.entry-readonly {
  display: flex;
  align-items: center;
}

.hero-season,
.section-heading,
.picker-control,
.board-head,
.timeline,
.entry-readonly { justify-content: space-between; }

.league-mark { width: 112rpx; flex: none; }
.hero-kicker { margin-left: 22rpx; color: #aab5ba; font-size: 18rpx; font-weight: 750; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 28rpx; font-size: 48rpx; font-weight: 850; letter-spacing: -1rpx; line-height: 1.18; }
.hero-copy,
.structure-copy,
.state-copy { display: block; margin-top: 16rpx; color: #aab5ba; font-size: 22rpx; line-height: 1.65; }

.hero-season {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #2d393f;
}

.hero-season__label { display: block; color: #7e8b91; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-season__name { display: block; margin-top: 8rpx; font-size: 28rpx; font-weight: 800; }
.action-button { min-height: 88rpx; margin-top: 26rpx; font-size: 25rpx; }

.section-kicker,
.board-kicker,
.state-code {
  display: block;
  color: #aab5ba;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 4rpx;
}

.section-title,
.board-title { display: block; margin-top: 9rpx; font-size: 32rpx; font-weight: 800; }
.season-number { color: #7e8b91; font-size: 28rpx; font-weight: 800; }
.progress-card season-rail { margin-top: 34rpx; }

.field-label { display: block; margin-bottom: 12rpx; color: #aab5ba; font-size: 20rpx; font-weight: 700; }
.picker-control { min-height: 84rpx; padding: 0 22rpx; border: 2rpx solid #344047; border-radius: 16rpx; background: #1c262b; font-size: 25rpx; font-weight: 700; }
.picker-arrow { color: #b6f13a; font-size: 26rpx; }

.metric-grid { margin-top: 30rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.metric-grid view { min-width: 0; padding: 22rpx 14rpx; border: 2rpx solid #2d393f; border-radius: 16rpx; background: #1c262b; }
.metric-value,
.metric-label { display: block; }
.metric-value { font-size: 38rpx; font-weight: 850; }
.metric-label { margin-top: 7rpx; color: #aab5ba; font-size: 18rpx; line-height: 1.35; }
.timeline { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid #2d393f; color: #aab5ba; font-size: 20rpx; }

.team-line { margin-top: 26rpx; }
.team-mark { width: 82rpx; margin-right: 20rpx; flex: none; }
.team-name,
.entry-status { display: block; }
.team-name { font-size: 28rpx; font-weight: 800; }
.entry-status { margin-top: 7rpx; color: #aab5ba; font-size: 20rpx; }
.error-copy { display: block; margin-top: 20rpx; color: #ffaaa5; font-size: 21rpx; line-height: 1.5; }
.entry-readonly { margin-top: 24rpx; padding: 20rpx; border: 2rpx solid #2d393f; border-radius: 16rpx; background: #1c262b; }
.entry-readonly-label { color: #aab5ba; font-size: 20rpx; }
.entry-readonly-value { margin-left: 18rpx; color: #f4f7f8; font-size: 22rpx; font-weight: 800; text-align: right; }

.state-card { min-height: 320rpx; display: flex; align-items: flex-start; justify-content: center; flex-direction: column; }
.state-card.compact { min-height: 220rpx; }
.state-title { margin-top: 18rpx; font-size: 32rpx; font-weight: 800; }
.outline-button { min-height: 76rpx; margin: 26rpx 0 0; padding: 0 26rpx; font-size: 23rpx; font-weight: 750; }
.standings-entry { display:flex;align-items:center;justify-content:space-between; }
.standings-entry__title { display:block;margin-top:10rpx;font-size:30rpx;font-weight:850; }
.standings-entry__hint { display:block;margin-top:10rpx;color:#aab5ba;font-size:20rpx; }
.standings-entry__arrow { color:#b6f13a;font-size:30rpx;font-weight:850; }
.standings-entry.is-locked { opacity:.72; }
.standings-entry.is-locked .standings-entry__arrow { color:#7e8b91;font-size:18rpx;letter-spacing:2rpx; }
.workspace-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.workspace-title{display:block;margin-top:9rpx;font-size:34rpx;font-weight:850}.workspace-division{padding:10rpx 15rpx;border:2rpx solid #546b37;border-radius:18rpx;background:#202c25;color:#d9efac;font-size:18rpx;font-weight:800}.workspace-metrics{display:grid;grid-template-columns:180rpx minmax(0,1fr);gap:14rpx;margin-top:26rpx}.workspace-metrics>view{min-width:0;padding:22rpx;border:2rpx solid #2d393f;border-radius:18rpx;background:#1c262b}.workspace-metric__label,.workspace-metric__meta{display:block;color:#aab5ba;font-size:17rpx}.workspace-rank{display:block;margin-top:8rpx;color:#b6f13a;font-size:48rpx;font-weight:900}.workspace-next{display:block;margin-top:10rpx;font-size:22rpx;font-weight:850;line-height:1.35}.workspace-metric__meta{margin-top:8rpx}.module-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:16rpx}.module-grid view{padding:21rpx;border:2rpx solid #344047;border-radius:16rpx;background:#151d21}.module-grid text{display:block;font-size:21rpx;font-weight:800}.module-grid text+text{margin-top:7rpx;color:#aab5ba;font-size:17rpx;font-weight:600}
