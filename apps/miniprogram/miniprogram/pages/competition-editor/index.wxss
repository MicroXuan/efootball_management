page { background:#09100d; color:#f4f7f5; }
.editor-page { min-height:100vh; padding:36rpx 28rpx 80rpx; box-sizing:border-box; background:linear-gradient(160deg,#10271a,#09100d 38%); }
.header { padding:24rpx 0 30rpx; border-bottom:2rpx solid #294c3a; }.kicker,.serial,.block-title { display:block; color:#b0ff00; font-size:18rpx; letter-spacing:4rpx; }.title { display:block; margin:10rpx 0; font-family:inherit; font-size:50rpx; font-weight:700; }.serial { color:#8f968c; }
.form-card { margin-top:24rpx; padding:28rpx; border:2rpx solid #294c3a; background:#121b16; }.notice,.error { display:block; padding:18rpx; color:#d9e342; background:#2d281b; font-size:21rpx; line-height:1.55; }.field { display:block; margin-top:25rpx; }.field>text { display:block; margin-bottom:11rpx; color:#a0a69d; font-size:21rpx; }.field input,.field textarea,.picker { width:100%; box-sizing:border-box; padding:20rpx; border:1rpx solid #365744; background:#0b120e; color:#f4f7f5; font-size:23rpx; }.field textarea { height:150rpx; }.time-block { margin-top:34rpx; padding-top:24rpx; border-top:1rpx solid #294c3a; }.block-title { color:#d9e342; }.error { margin-top:24rpx; }.save { margin-top:30rpx; border-radius:6rpx; background:#b0ff00; color:#0a0a0a; font-weight:800; }.save::after { border:0; }.save[disabled] { background:#26382e; color:#8f968c; }
