page { background:#0e1417; color:#f4f7f8; }
.editor-page { min-height:100vh; padding:36rpx 28rpx 80rpx; box-sizing:border-box; background:linear-gradient(160deg,#10271a,#0e1417 38%); }
.header { padding:24rpx 0 30rpx; border-bottom:2rpx solid #344047; }.kicker,.serial,.block-title { display:block; color:#aab5ba; font-size:18rpx; letter-spacing:4rpx; }.title { display:block; margin:10rpx 0; font-family:inherit; font-size:50rpx; font-weight:800; }.serial { color:#7e8b91; }
.form-card { margin-top:24rpx; padding:28rpx; border:2rpx solid #344047; border-radius:24rpx; background:#151d21; box-shadow:0 16rpx 44rpx rgba(0,0,0,.18); }.notice,.error { display:block; padding:18rpx; border-radius:12rpx; color:#f0cb7e; background:rgba(232,189,101,.08); font-size:21rpx; line-height:1.55; }.field { display:block; margin-top:25rpx; }.field>text { display:block; margin-bottom:11rpx; color:#aab5ba; font-size:21rpx; }.field input,.field textarea,.picker { width:100%; min-height:88rpx; padding:20rpx; border:2rpx solid #46545b; border-radius: 16rpx; background:#1c262b; color:#f4f7f8; font-size:23rpx; }.field textarea { height:150rpx; }.time-block { margin-top:34rpx; padding-top:24rpx; border-top:1rpx solid #344047; }.block-title { color:#aab5ba; }.error { margin-top:24rpx; color:#ffaaa5; background:rgba(255,127,120,.08); }.save { min-height:88rpx; margin-top:30rpx; border-radius:16rpx; background:#b6f13a; color:#111810; font-weight:800; }.save::after { border:0; }.save[disabled] { background:#263238; color:#7e8b91; }
