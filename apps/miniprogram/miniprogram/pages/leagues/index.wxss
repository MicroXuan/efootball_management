page { background: #07110d; color: #eef7f1; }
.page-shell { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 38rpx) 26rpx 170rpx; background: radial-gradient(circle at 88% 8%, rgba(85,239,139,.11), transparent 28%), linear-gradient(165deg,#07110d,#0b1b13 55%,#111710); }
.masthead,.brand-line,.season-strip { display: flex; align-items: center; }
.masthead,.season-strip { justify-content: space-between; }
.eyebrow,.state-code,.season-label { display: block; color: #d4b05f; font-size: 17rpx; letter-spacing: 5rpx; }
.page-title { display: block; margin-top: 7rpx; font-family: STKaiti, KaiTi, serif; font-size: 56rpx; font-weight: 800; }
.edition { color: rgba(85,239,139,.44); font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; }
.intro { display: block; max-width: 560rpx; margin-top: 24rpx; color: #95aa9d; font-size: 23rpx; line-height: 1.65; }
.league-list { margin-top: 38rpx; }
.league-card { margin-top: 20rpx; border: 2rpx solid rgba(85,239,139,.26); background: rgba(11,28,19,.94); overflow: hidden; }
.brand-line { padding: 28rpx; }
.league-logo { width: 92rpx; height: 92rpx; flex: none; background: #09140e; }
.logo-fallback { display: flex; align-items: center; justify-content: center; color: #55ef8b; font-family: "DIN Alternate",sans-serif; font-size: 27rpx; font-weight: 800; }
.brand-copy { min-width: 0; margin-left: 22rpx; flex: 1; }
.league-name,.league-meta,.season-name,.entry-copy { display: block; }
.league-name { overflow: hidden; font-size: 31rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.league-meta { margin-top: 8rpx; color: #95aa9d; font-size: 21rpx; }
.arrow { color: #55ef8b; font-size: 35rpx; }
.season-strip { padding: 23rpx 28rpx; border-top: 2rpx solid rgba(85,239,139,.16); background: rgba(29,61,41,.52); }
.season-name { margin-top: 7rpx; font-size: 25rpx; font-weight: 700; }
.season-state { text-align: right; color: #55ef8b; font-size: 24rpx; font-weight: 800; }
.entry-copy { margin-top: 6rpx; color: #82978a; font-size: 18rpx; font-weight: 400; }
.state-card { min-height: 380rpx; margin-top: 40rpx; padding: 34rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; border: 2rpx solid rgba(85,239,139,.2); background: rgba(11,27,19,.92); }
.state-title { margin-top: 22rpx; font-size: 33rpx; font-weight: 800; }.state-copy { margin-top: 14rpx; color: #95aa9d; font-size: 23rpx; line-height: 1.65; }
.outline-button { margin: 28rpx 0 0; padding: 0 28rpx; border: 2rpx solid rgba(85,239,139,.4); border-radius: 0; background: transparent; color: #55ef8b; font-size: 24rpx; font-weight: 800; }.outline-button::after { border: 0; }
