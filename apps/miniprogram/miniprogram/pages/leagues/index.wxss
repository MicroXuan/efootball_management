page { background: #0e1417; color: #f4f7f8; }

.page-shell {
  padding: calc(env(safe-area-inset-top) + 38rpx) 28rpx 184rpx;
  background:
    radial-gradient(circle at 94% 2%, rgba(182, 241, 58, 0.07), transparent 30%),
    #0e1417;
}

.league-card__identity,
.league-card__meta-line,
.season-strip {
  display: flex;
  align-items: center;
}

.season-strip { justify-content: space-between; }

.state-code,
.season-label {
  display: block;
  color: #aab5ba;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.league-banner {
  position: relative;
  height: 220rpx;
  overflow: hidden;
  border: 2rpx solid #344047;
  border-radius: 24rpx;
  background: #151d21;
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.28);
}

.league-banner__image,
.league-banner__fallback {
  width: 100%;
  height: 100%;
}

.league-banner__image { display: block; }

.league-banner__fallback {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 20%, rgba(182, 241, 58, 0.17), transparent 28%),
    linear-gradient(135deg, #1b3428 0%, #14251f 52%, #10191a 100%);
}

.pitch-line {
  position: absolute;
  border: 2rpx solid rgba(244, 247, 248, 0.18);
}

.pitch-line--outer {
  inset: 24rpx;
  border-radius: 10rpx;
}

.pitch-line--center {
  top: 24rpx;
  bottom: 24rpx;
  left: 50%;
  border-width: 0 0 0 2rpx;
}

.pitch-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 70rpx;
  height: 70rpx;
  border: 2rpx solid rgba(244, 247, 248, 0.18);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.league-tabs {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border: 2rpx solid #2d393f;
  border-radius: 20rpx;
  background: #151d21;
}

.league-tabs button {
  border: 0;
  border-radius: 14rpx;
  color: #aab5ba;
  background: transparent;
  font-size: 24rpx;
  font-weight: 750;
}

.league-tabs button.is-active {
  color: #111810;
  background: #b6f13a;
}

.league-list { margin-top: 38rpx; }

.league-card {
  margin-top: 24rpx;
  overflow: hidden;
  border: 2rpx solid #344047;
  border-radius: 24rpx;
  background: #151d21;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.2);
  transition: transform 180ms ease, border-color 180ms ease, opacity 180ms ease;
}

.league-card:first-child { margin-top: 0; }
.league-card--pressed { opacity: 0.86; transform: scale(0.988); }

.league-card__identity { min-height: 184rpx; padding: 28rpx; }
.league-mark { width: 104rpx; flex: none; }
.league-card__copy { min-width: 0; margin-left: 22rpx; flex: 1; }
.league-card__meta-line { min-width: 0; gap: 12rpx; }

.edition-badge {
  flex: none;
  padding: 6rpx 10rpx;
  border: 2rpx solid #46545b;
  border-radius: 8rpx;
  color: #cbd4d8;
  font-size: 17rpx;
  font-weight: 750;
}

.my-team {
  min-width: 0;
  overflow: hidden;
  color: #aab5ba;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.league-name,
.league-meta,
.season-label,
.season-name,
.entry-copy { display: block; }

.league-name {
  margin-top: 12rpx;
  overflow: hidden;
  display: -webkit-box;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.24;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.league-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #aab5ba;
  font-size: 21rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  margin-left: 16rpx;
  color: #b6f13a;
  font-size: 34rpx;
  font-weight: 500;
}

.season-strip {
  min-height: 132rpx;
  padding: 22rpx 28rpx;
  border-top: 2rpx solid #2d393f;
  background: #1c262b;
}

.season-copy { min-width: 0; padding-right: 18rpx; }
.season-label { color: #7e8b91; letter-spacing: 3rpx; }
.season-name { margin-top: 7rpx; overflow: hidden; font-size: 25rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.entry-copy { margin-top: 5rpx; color: #aab5ba; font-size: 19rpx; }

.state-card {
  min-height: 380rpx;
  margin-top: 40rpx;
  padding: 36rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
}

.state-title { margin-top: 20rpx; font-size: 34rpx; font-weight: 800; }
.state-copy { margin-top: 14rpx; color: #aab5ba; font-size: 23rpx; line-height: 1.65; }
.outline-button { min-height: 76rpx; margin: 28rpx 0 0; padding: 0 28rpx; font-size: 23rpx; font-weight: 750; }
