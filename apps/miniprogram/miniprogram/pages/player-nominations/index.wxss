page { background: #0e1417; color: #f4f7f8; }
.nomination-page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 28rpx 120rpx; }
.hero { padding: 18rpx 4rpx 30rpx; }
.eyebrow { display: block; color: #b6f13a; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.title { display: block; margin-top: 8rpx; font-size: 37rpx; font-weight: 850; }
.sub { display: block; margin-top: 10rpx; color: #a9b6ba; font-size: 22rpx; line-height: 1.55; }
.window-card,.section,.state { margin-bottom: 20rpx; padding: 26rpx; border: 2rpx solid #334047; border-radius: 20rpx; background: #151d21; }
.label { display: block; color: #aeb9bd; font-size: 22rpx; }
.count { display: block; margin: 10rpx 0; color: #b6f13a; font-size: 49rpx; font-weight: 850; }
.window-status { color: #eaf6cf; font-size: 22rpx; font-weight: 700; }
.section-title { display: block; margin-bottom: 20rpx; font-size: 27rpx; font-weight: 800; }
.section-copy { display: block; margin-top: 8rpx; color: #a9b6ba; font-size: 22rpx; line-height: 1.5; }
.nomination-heading { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.nomination-heading .section-title { margin-bottom:0; }
.nomination-scroll-hint { flex:none; color:#8f9fa5; font-size:17rpx; }
.nomination-list { display:block; width:100%; margin-top:14rpx; padding-right:16rpx; box-sizing:border-box; }
.nomination-list.is-scrollable { height:470rpx; }
.nomination-row { display:flex; align-items:center; gap:14rpx; min-width:0; min-height:132rpx; padding:12rpx 0; box-sizing:border-box; border-top:1rpx solid #334047; color:#e9eff1; }
.nomination-photo { width:82rpx; flex:none; }
.nomination-photo entity-artwork { width:100%; }
.nomination-info { display:flex; min-width:0; flex:1; flex-direction:column; gap:4rpx; }
.nomination-name { display:block; width:100%; overflow-wrap:anywhere; font-size:22rpx; font-weight:800; line-height:1.3; }
.nomination-detail { display:block; width:100%; color:#9cabb0; font-size:17rpx; line-height:1.3; overflow-wrap:anywhere; }
.withdraw-action { display:flex; flex:none; align-items:center; justify-content:center; box-sizing:border-box; width:94rpx; min-height:58rpx; border:2rpx solid #43535a; border-radius:12rpx; color:#d7e0e3; background:#263238; font-size:19rpx; font-weight:700; line-height:1.2; }
.search { display: flex; align-items: stretch; gap: 10rpx; min-width: 0; margin-top: 20rpx; }
.search input { flex: 1; box-sizing: border-box; width: auto; min-width: 0; height: 76rpx; padding: 0 18rpx; border: 2rpx solid #44545a; border-radius: 13rpx; color: #f4f7f8; background: #10181c; font-size: 22rpx; }
.search-button { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; width: 120rpx; min-height: 76rpx; padding: 0 8rpx; border-radius: 13rpx; color: #10200b; background: #b6f13a; font-size: 23rpx; font-weight: 800; line-height: 1.2; }
.search-button.is-disabled, .nominate-button.is-disabled, .withdraw-action.is-disabled { opacity: .52; }
.result-count { margin: 22rpx 0 12rpx; color: #aab8be; font-size: 19rpx; }
.search-empty { margin-top: 16rpx; padding: 22rpx; border-radius: 14rpx; color: #aab8be; background: #10181c; font-size: 20rpx; line-height: 1.5; }
.player-card { margin-top: 14rpx; padding: 16rpx; border: 2rpx solid #35454b; border-radius: 18rpx; background: #10191d; }
.player-card-main { display: grid; grid-template-columns: 148rpx minmax(0, 1fr); align-items: start; gap: 18rpx; }
.player-photo { width: 148rpx; }
.player-photo entity-artwork { width: 100%; }
.player-info { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; }
.player-name { display: block; width: 100%; color: #f5f8f7; font-size: 26rpx; font-weight: 850; line-height: 1.35; overflow-wrap: anywhere; }
.player-club { display: block; margin-top: 5rpx; color: #d6e4e4; font-size: 21rpx; line-height: 1.4; overflow-wrap: anywhere; }
.player-meta, .player-value { display: block; margin-top: 6rpx; color: #93a4a9; font-size: 18rpx; line-height: 1.45; overflow-wrap: anywhere; }
.player-stats { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.player-stats text { padding: 5rpx 10rpx; border-radius: 8rpx; font-size: 18rpx; font-weight: 750; }
.stat-position { color: #e7eef0; background: #26363d; }
.stat-at { color: #dfff8c; background: #293923; }
.nominate-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 70rpx; margin-top: 16rpx; padding: 10rpx 16rpx; border-radius: 12rpx; color: #10200b; background: #b6f13a; font-size: 23rpx; font-weight: 800; line-height: 1.2; text-align: center; }
.empty,.state { color: #9fadb2; font-size: 21rpx; }
.state--empty { padding: 30rpx; border-color: #3b4a42; background: #19231f; }
.state-eyebrow { display: block; color: #b6f13a; font-size: 17rpx; font-weight: 750; letter-spacing: 2rpx; }
.state-title { display: block; margin-top: 12rpx; color: #f4f7f8; font-size: 27rpx; font-weight: 800; line-height: 1.35; }
.state-copy { display: block; margin-top: 11rpx; color: #aab5ba; font-size: 20rpx; line-height: 1.55; }
.error { margin: 16rpx 0; color: #ff9d91; font-size: 21rpx; }
