page { background: #0e1417; color: #f4f7f8; }
.nomination-page { min-height: 100vh; padding: 34rpx 28rpx 120rpx; }
.hero { padding: 18rpx 4rpx 30rpx; }
.eyebrow { display: block; color: #b6f13a; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.title { display: block; margin-top: 8rpx; font-size: 37rpx; font-weight: 850; }
.sub { display: block; margin-top: 10rpx; color: #94a2a7; font-size: 20rpx; line-height: 1.55; }
.window-card,.section,.state { margin-bottom: 20rpx; padding: 26rpx; border: 2rpx solid #334047; border-radius: 20rpx; background: #151d21; }
.label { display: block; color: #aeb9bd; font-size: 20rpx; }
.count { display: block; margin: 10rpx 0; color: #b6f13a; font-size: 49rpx; font-weight: 850; }
.window-status { color: #eaf6cf; font-size: 22rpx; font-weight: 700; }
.section-title { display: block; margin-bottom: 20rpx; font-size: 27rpx; font-weight: 800; }
.nomination-row,.player-row,.search { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 14rpx 0; border-top: 1rpx solid #334047; }
.nomination-row button,.player-row button,.search button { flex: none; margin: 0; padding: 0 24rpx; color: #10200b; background: #b6f13a; font-size: 20rpx; }
.nomination-row button { color: #d7e0e3; background: #2b373c; }
.search input { min-width: 0; flex: 1; color: #f4f7f8; font-size: 22rpx; }
.player-name { display: block; font-size: 22rpx; font-weight: 700; }
.player-meta { display: block; margin-top: 5rpx; color: #8a9aa0; font-size: 18rpx; }
.empty,.state { color: #9fadb2; font-size: 21rpx; }
.error { margin: 16rpx 0; color: #ff9d91; font-size: 21rpx; }
