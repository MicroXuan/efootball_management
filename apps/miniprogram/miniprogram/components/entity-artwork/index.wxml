<view class="artwork artwork--{{shape}} artwork--{{surface}}" aria-label="{{fallback}}">
  <image
    wx:if="{{displaySrc && !imageFailed}}"
    class="artwork__image"
    src="{{displaySrc}}"
    mode="{{fit === 'contain' || shape !== 'portrait' ? 'aspectFit' : 'aspectFill'}}"
    binderror="onImageError"
  />
  <view wx:else class="artwork__fallback">
    <text>{{fallback}}</text>
  </view>
</view>
