.player-card {
  width: 218rpx;
  min-height: 390rpx;
  display: block;
  overflow: hidden;
  border: 2rpx solid #344047;
  border-radius: 20rpx;
  color: #f4f7f8;
  background: #151d21;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.2);
  transition: transform 180ms ease, opacity 180ms ease, border-color 180ms ease;
}

.player-card--pressed { opacity: 0.82; transform: scale(0.98); }

.card-art {
  position: relative;
  height: 282rpx;
  overflow: hidden;
  border-bottom: 2rpx solid #344047;
  background: linear-gradient(145deg, #24343a 0%, #18252a 48%, #10171a 100%);
}

.pitch-line { position: absolute; z-index: 1; width: 320rpx; height: 2rpx; background: rgba(182, 241, 58, 0.14); transform: rotate(-38deg); }
.pitch-line--one { top: 90rpx; left: -55rpx; }
.pitch-line--two { top: 170rpx; left: -16rpx; }
.rating-block { position: absolute; z-index: 4; top: 14rpx; left: 16rpx; display: flex; flex-direction: column; text-shadow: 0 2rpx 8rpx #000; }
.rating { font-size: 54rpx; font-weight: 850; line-height: 1; }
.position { margin-top: 2rpx; color: #b6f13a; font-size: 24rpx; font-weight: 850; }
.player-image,
.fallback-art { width: 100%; height: 100%; }
.fallback-art { display: flex; align-items: center; justify-content: center; flex-direction: column; background: radial-gradient(circle at 72% 30%, rgba(182, 241, 58, 0.12), transparent 38%); }
.fallback-initials { margin-top: 22rpx; color: #d8e2e5; font-size: 58rpx; font-weight: 800; }
.fallback-mark { margin-top: 10rpx; color: #7e8b91; font-size: 16rpx; letter-spacing: 8rpx; }
.name-plate { position: absolute; z-index: 5; right: 0; bottom: 0; left: 0; padding: 16rpx 12rpx 14rpx; background: linear-gradient(transparent, rgba(8, 13, 15, 0.96)); }
.player-name,
.card-name,
.card-meta,
.play-style { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-name { font-size: 24rpx; font-weight: 800; }
.card-copy { padding: 16rpx 14rpx 18rpx; }
.card-name { font-size: 24rpx; font-weight: 750; }
.card-meta { margin-top: 7rpx; color: #aab5ba; font-size: 19rpx; }
.play-style { margin-top: 5rpx; color: #7e8b91; font-size: 18rpx; }
