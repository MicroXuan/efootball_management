.player-card {
  width: 218rpx;
  min-height: 390rpx;
  display: block;
  color: #f5f7f6;
  transition: transform 120ms ease, opacity 120ms ease;
}

.player-card--pressed {
  opacity: 0.78;
  transform: scale(0.975);
}

.card-art {
  position: relative;
  height: 282rpx;
  overflow: hidden;
  border: 2rpx solid #3c7656;
  border-radius: 18rpx 18rpx 6rpx 6rpx;
  background: linear-gradient(145deg, #203d2d 0%, #14241d 48%, #0b100e 100%);
}

.pitch-line {
  position: absolute;
  z-index: 1;
  width: 320rpx;
  height: 2rpx;
  background: rgba(102, 240, 90, 0.2);
  transform: rotate(-38deg);
}

.pitch-line--one { top: 90rpx; left: -55rpx; }
.pitch-line--two { top: 170rpx; left: -16rpx; }

.rating-block {
  position: absolute;
  z-index: 4;
  top: 14rpx;
  left: 16rpx;
  display: flex;
  flex-direction: column;
  text-shadow: 0 2rpx 8rpx #000;
}

.rating {
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1;
}

.position {
  margin-top: 2rpx;
  color: #66f05a;
  font-size: 24rpx;
  font-weight: 800;
}

.player-image,
.fallback-art {
  width: 100%;
  height: 100%;
}

.fallback-art {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: radial-gradient(circle at 72% 30%, rgba(102, 240, 90, 0.2), transparent 38%);
}

.fallback-initials {
  margin-top: 22rpx;
  font-family: STKaiti, KaiTi, serif;
  color: #dfffd9;
  font-size: 58rpx;
  font-weight: 700;
}

.fallback-mark {
  margin-top: 10rpx;
  color: rgba(240, 184, 75, 0.62);
  font-size: 16rpx;
  letter-spacing: 8rpx;
}

.name-plate {
  position: absolute;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 12rpx 14rpx;
  background: linear-gradient(transparent, rgba(5, 9, 7, 0.96));
}

.player-name,
.card-name,
.card-meta,
.play-style {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-name { font-size: 24rpx; font-weight: 800; }
.card-copy { padding: 14rpx 4rpx 0; }
.card-name { font-size: 25rpx; font-weight: 700; }
.card-meta { margin-top: 6rpx; color: #f0b84b; font-size: 20rpx; }
.play-style { margin-top: 4rpx; color: #98a69f; font-size: 19rpx; }
