.tabbar-shell {
  position: fixed;
  z-index: 1000;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  left: 24rpx;
  pointer-events: none;
}

.tabbar {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 10rpx;
  border: 2rpx solid #344047;
  border-radius: 28rpx;
  background: rgba(21, 29, 33, 0.98);
  box-shadow: 0 20rpx 54rpx rgba(0, 0, 0, 0.38);
  pointer-events: auto;
}

.tab-item {
  min-height: 88rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 18rpx;
  color: #aab5ba;
  font-size: 21rpx;
  font-weight: 650;
  transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
}

.tab-item.is-active {
  color: #111810;
  background: #b6f13a;
}

.tab-item:active {
  transform: scale(0.98);
}

.icon-wrap {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.icon {
  width: 100%;
  height: 100%;
}

.attention-badge {
  position: absolute;
  top: -17rpx;
  right: -24rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #151d21;
  border-radius: 14rpx;
  background: #ffba52;
  color: #161b1d;
  font-size: 15rpx;
  font-weight: 900;
  line-height: 1;
}
