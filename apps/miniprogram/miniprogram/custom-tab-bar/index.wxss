.tabbar-shell {
  position: fixed;
  z-index: 1000;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  left: 24rpx;
  pointer-events: none;
}
.tabbar {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 10rpx;
  border: 2rpx solid rgba(176, 255, 0, .18);
  border-radius: 34rpx;
  background: rgba(26, 26, 26, .98);
  box-shadow: 0 20rpx 54rpx rgba(0, 0, 0, .45);
  pointer-events: auto;
}
.tab-item {
  height: 88rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 26rpx;
  color: #8f968c;
  font-size: 21rpx;
  font-weight: 650;
}
.tab-item.is-active { color: #0a0a0a; background: #b0ff00; }
.icon-wrap { width: 34rpx; height: 34rpx; }
.icon { width: 100%; height: 100%; }
