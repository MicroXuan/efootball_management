<view class="tabbar-shell">
  <view class="tabbar">
    <view wx:for="{{items}}" wx:key="text" class="tab-item {{selected === index ? 'is-active' : ''}}" data-index="{{index}}" bindtap="switchTab">
      <view class="icon-wrap">
        <image class="icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      </view>
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
