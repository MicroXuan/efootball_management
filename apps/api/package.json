{
  "name": "@efm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "pnpm --filter @efm/contracts build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prestart:dev": "pnpm --filter @efm/contracts build && pnpm prisma:generate",
    "start:dev": "tsx watch src/main.ts",
    "prebuild": "pnpm prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @efm/contracts build && pnpm prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @efm/contracts build && pnpm prisma:generate",
    "test": "JEST_SCOPE=unit NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts",
    "pretest:e2e": "pnpm --filter @efm/contracts build && pnpm prisma:generate",
    "test:e2e": "JEST_SCOPE=e2e NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts",
    "player-import": "tsx src/player-import/player-import.cli.ts",
    "sync:pesdata": "tsx src/pesdata-sync/pesdata-sync.cli.ts",
    "competition:demo": "tsx src/competitions/competition-demo.cli.ts",
    "league-teams:migrate": "tsx src/league-teams/league-team-backfill.cli.ts"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "@efm/contracts": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.1",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/testing": "^12.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
