  overridden       Boolean                  @default(false)
  reason           String?                  @db.VarChar(512)
  decidedByAdminId String                   @map("decided_by_admin_id") @db.Char(36)
  createdAt        DateTime                 @default(now()) @map("created_at")
  proposal         SeasonAllocationProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  seasonEntry      SeasonEntry              @relation(fields: [seasonEntryId], references: [id], onDelete: Restrict)
  decidedByAdmin   AdminAccount             @relation("AllocationDecisionActor", fields: [decidedByAdminId], references: [id], onDelete: Restrict)

  @@unique([proposalId, seasonEntryId], map: "season_allocation_decisions_entry_unique")
  @@index([seasonEntryId], map: "season_allocation_decisions_season_entry_idx")
  @@index([decidedByAdminId], map: "season_allocation_decisions_admin_idx")
  @@map("season_allocation_decisions")
}

model CompetitionMatch {
  id                      String                 @id @default(uuid()) @db.Char(36)
  stageId                 String                 @map("stage_id") @db.Char(36)
  roundNumber             Int                    @map("round_number") @db.UnsignedInt
  pairingKey              String                 @map("pairing_key") @db.VarChar(73)
  matchNumber             Int                    @map("match_number") @db.UnsignedInt
  homeParticipantId       String                 @map("home_participant_id") @db.Char(36)
  awayParticipantId       String                 @map("away_participant_id") @db.Char(36)
  plannedAt               DateTime?              @map("planned_at")
  status                  CompetitionMatchStatus @default(SCHEDULED)
  officialResultVersionId String?                @unique @map("official_result_version_id") @db.Char(36)
  version                 Int                    @default(1) @db.UnsignedInt
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  stage                   CompetitionStage       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  homeParticipant         CompetitionParticipant @relation("CompetitionMatchHome", fields: [homeParticipantId], references: [id], onDelete: Restrict)
  awayParticipant         CompetitionParticipant @relation("CompetitionMatchAway", fields: [awayParticipantId], references: [id], onDelete: Restrict)
  resultVersions          MatchResultVersion[]   @relation("MatchResultHistory")
  officialResultVersion   MatchResultVersion?    @relation("OfficialMatchResult", fields: [officialResultVersionId], references: [id], onDelete: Restrict)
  bracketPairing          CupBracketPairing?

  @@unique([stageId, pairingKey], map: "competition_matches_pair_unique")
  @@unique([stageId, matchNumber], map: "competition_matches_number_unique")
  @@index([stageId, roundNumber, matchNumber], map: "competition_matches_round_idx")
  @@index([homeParticipantId], map: "competition_matches_home_idx")
  @@index([awayParticipantId], map: "competition_matches_away_idx")
  @@map("competition_matches")
}

model MatchResultVersion {
  id                 String                    @id @default(uuid()) @db.Char(36)
  matchId            String                    @map("match_id") @db.Char(36)
  version            Int                       @db.UnsignedInt
  homeScore          Int                       @map("home_score") @db.UnsignedTinyInt
  awayScore          Int                       @map("away_score") @db.UnsignedTinyInt
  submittedById      String                    @map("submitted_by_id") @db.Char(36)
  submissionSide     MatchResultSubmissionSide @map("submission_side")
  status             MatchResultVersionStatus  @default(PROPOSED)
  reason             String?                   @db.VarChar(512)
  evidenceMetadata   Json?                     @map("evidence_metadata")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  match              CompetitionMatch          @relation("MatchResultHistory", fields: [matchId], references: [id], onDelete: Restrict)
  submitter          User                      @relation("MatchResultSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  officialForMatch   CompetitionMatch?         @relation("OfficialMatchResult")
  triggeredSnapshots StandingsSnapshot[]

  @@unique([matchId, version], map: "match_result_versions_version_unique")
  @@index([matchId, status], map: "match_result_versions_status_idx")
  @@index([submittedById], map: "match_result_versions_submitter_idx")
  @@map("match_result_versions")
}

model StandingsSnapshot {
  id                        String              @id @default(uuid()) @db.Char(36)
  competitionId             String              @map("competition_id") @db.Char(36)
  stageId                   String?             @map("stage_id") @db.Char(36)
  version                   Int                 @db.UnsignedInt
  triggeringResultVersionId String?             @map("triggering_result_version_id") @db.Char(36)
  ruleVersion               Int                 @map("rule_version") @db.UnsignedInt
  generatedAt               DateTime            @default(now()) @map("generated_at")
  competition               Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  stage                     CompetitionStage?   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  triggeringResultVersion   MatchResultVersion? @relation(fields: [triggeringResultVersionId], references: [id], onDelete: Restrict)
  rows                      StandingsRow[]

  @@unique([competitionId, stageId, version], map: "standings_snapshots_scope_version_unique")
  @@index([triggeringResultVersionId], map: "standings_snapshots_trigger_idx")
  @@index([stageId, version], map: "standings_snapshots_stage_version_idx")
  @@map("standings_snapshots")
}

model StandingsRow {
  id               String                 @id @default(uuid()) @db.Char(36)
  snapshotId       String                 @map("snapshot_id") @db.Char(36)
  participantId    String                 @map("participant_id") @db.Char(36)
  played           Int                    @default(0) @db.UnsignedInt
  wins             Int                    @default(0) @db.UnsignedInt
  draws            Int                    @default(0) @db.UnsignedInt
  losses           Int                    @default(0) @db.UnsignedInt
  goalsFor         Int                    @default(0) @map("goals_for") @db.UnsignedInt
  goalsAgainst     Int                    @default(0) @map("goals_against") @db.UnsignedInt
  goalDifference   Int                    @default(0) @map("goal_difference")
  basePoints       Int                    @default(0) @map("base_points")
  adjustmentPoints Int                    @default(0) @map("adjustment_points")
  totalPoints      Int                    @default(0) @map("total_points")
  rank             Int                    @db.UnsignedInt
  tiePending       Boolean                @default(false) @map("tie_pending")
  tieBreakValues   Json                   @map("tie_break_values")
  snapshot         StandingsSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  participant      CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, participantId], map: "standings_rows_participant_unique")
  @@index([snapshotId, rank], map: "standings_rows_rank_idx")
  @@index([participantId], map: "standings_rows_participant_idx")
  @@map("standings_rows")
}

model MutationReceipt {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String   @map("actor_id") @db.Char(36)
  operation  String   @db.VarChar(96)
  key        String   @db.VarChar(128)
  resultJson Json?    @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  actor      User     @relation("MutationReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key], map: "mutation_receipts_request_unique")
  @@map("mutation_receipts")
}

model AdminMutationReceipt {
  id          String       @id @default(uuid()) @db.Char(36)
  adminId     String       @map("admin_id") @db.Char(36)
  operation   String       @db.VarChar(191)
  key         String       @db.VarChar(128)
  requestHash String?      @map("request_hash") @db.Char(64)
  resultJson  Json?        @map("result_json")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  admin       AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([adminId, operation, key], map: "admin_mutation_receipts_request_unique")
  @@map("admin_mutation_receipts")
}

model PlatformPresentation {
  id                    String   @id @db.VarChar(32)
  leagueCenterBannerUrl String?  @map("league_center_banner_url") @db.VarChar(2048)
  version               Int      @default(1) @db.UnsignedInt
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("platform_presentations")
}
