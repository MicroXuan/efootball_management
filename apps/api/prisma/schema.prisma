generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GamePlatform {
  MOBILE
  PLAYSTATION
  XBOX
  STEAM
}

enum LeagueEdition {
  NATIONAL
  INTERNATIONAL
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ScopeType {
  PLATFORM
  ORGANIZATION
  LEAGUE
  SEASON
  COMPETITION
  TEAM
}

enum LeagueStatus {
  ACTIVE
  ARCHIVED
}

enum TeamProfileStatus {
  ACTIVE
  ARCHIVED
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum AdminRole {
  PLATFORM_ADMIN
  LEAGUE_MANAGER
}

enum LeagueTeamStatus {
  ACTIVE
  ARCHIVED
  NEEDS_NUMBER
}

enum LeagueTeamRosterStatus {
  COMPLIANT
  OVER_CAP
}

enum SalaryRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RosterEntryStatus {
  ACTIVE
  RELEASED
  TRANSFERRED
  DISAPPEARED
  RETIRED
}

enum ValuationSubmissionStatus {
  DRAFT
  PUBLISHED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RosterTransactionType {
  BUY
  SELL
  RELEASE
  TRANSFER
  CARD_UPGRADE
  SALARY_RECALCULATION
  EMERGENCY_CORRECTION
}

enum FinanceLedgerDirection {
  DEBIT
  CREDIT
}

enum FinanceLedgerType {
  PLAYER_PURCHASE
  PLAYER_SALE
  PLAYER_TRANSFER
  CARD_UPGRADE
  TRANSACTION_FEE
  LUXURY_TAX
  OFFSEASON_FEE
  UNFINISHED_MATCH_PENALTY
  AUCTION
  ROOKIE_SELECTION
  INSTALLMENT_PAYMENT
  MANUAL_ADJUSTMENT
}

enum LeagueSeasonStatus {
  DRAFT
  REGISTRATION_OPEN
  ALLOCATION_REVIEW
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SeasonEntrySource {
  NEW_APPLICATION
  RENEWAL
}

enum SeasonEntryStatus {
  INVITED
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ImportSourceType {
  MANUAL
  API
}

enum PlayerPosition {
  GK
  CB
  LB
  RB
  DMF
  CMF
  LMF
  RMF
  AMF
  LWF
  RWF
  SS
  CF
}

enum PlayerCardType {
  STANDARD
  LEGENDARY
  EPIC
  BIG_TIME
  TRENDING
  FEATURED
  HIGHLIGHT
  SHOW_TIME
  OTHER
}

enum PlayerCardStatus {
  ACTIVE
  INACTIVE
}

enum ImportFormat {
  CSV
  JSON
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  READY
  PUBLISHED
  FAILED
  CANCELLED
}

enum ImportDiffType {
  CREATE
  UPDATE
  UNCHANGED
  INVALID
}

enum ExternalSyncMode {
  SAMPLE
  FULL
  INCREMENTAL
}

enum ExternalSyncStatus {
  PENDING
  RUNNING
  READY
  PAUSED
  FAILED
}

enum ExternalSyncItemStatus {
  PENDING
  FETCHED
  SKIPPED
  FAILED
}

enum TeamCatalogSourceType {
  PESDATA
  CUSTOM
}

enum TeamCatalogStatus {
  ACTIVE
  SOURCE_UNCONFIRMED
  DISABLED
}

enum TeamShellChangeType {
  ASSIGN
  CHANGE
  TRANSFER
  SWAP
  REFRESH
}

enum TeamCatalogSyncMode {
  SAMPLE
  FULL
  INCREMENTAL
  RESUME
}

enum TeamCatalogSyncStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum TeamCatalogSyncChangeType {
  ADDED
  UPDATED
  SOURCE_MISSING
}

enum TeamCatalogSyncReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  FAILED
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CompetitionType {
  OPEN_EVENT
  DIVISION_LEAGUE
  GROUP_KNOCKOUT_CUP
  KNOCKOUT_CUP
}

enum SeasonAllocationProposalStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

enum CupProposalStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

enum SeasonAllocationSource {
  FIRST_SEASON
  RETAINED
  PROMOTED
  RELEGATED
  REPLACEMENT
  CHAMPION_POOL
  NEW_ENTRY
}

enum CompetitionParticipantType {
  INDIVIDUAL
  TEAM
}

enum CompetitionFormat {
  ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
  SINGLE_ELIMINATION
  GROUP_KNOCKOUT
}

enum CompetitionRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CompetitionStageStatus {
  DRAFT
  PUBLISHED
}

enum CompetitionMatchStatus {
  SCHEDULED
  AWAITING_RESULT
  PENDING_CONFIRMATION
  CONFIRMED
  ADMIN_DECIDED
}

enum MatchResultSubmissionSide {
  HOME
  AWAY
  MANAGER
}

enum MatchResultVersionStatus {
  PROPOSED
  REJECTED
  OFFICIAL
  SUPERSEDED
}

model User {
  id                               String                                 @id @default(uuid()) @db.Char(36)
  wechatOpenId                     String                                 @unique @map("wechat_open_id") @db.VarChar(128)
  wechatUnionId                    String?                                @unique @map("wechat_union_id") @db.VarChar(128)
  publicUserNo                     String?                                @unique @map("public_user_no") @db.Char(6)
  displayName                      String                                 @map("display_name") @db.VarChar(32)
  avatarUrl                        String?                                @map("avatar_url") @db.VarChar(2048)
  region                           String?                                @db.VarChar(64)
  status                           UserStatus                             @default(ACTIVE)
  agreementVersion                 String?                                @map("agreement_version") @db.VarChar(32)
  privacyConsentAt                 DateTime?                              @map("privacy_consent_at")
  createdAt                        DateTime                               @default(now()) @map("created_at")
  updatedAt                        DateTime                               @updatedAt @map("updated_at")
  gameAccounts                     GameAccount[]
  refreshSessions                  RefreshSession[]
  roleBindings                     UserRoleBinding[]
  createdCompetitions              Competition[]                          @relation("CompetitionCreator")
  createdCompetitionRules          CompetitionRuleVersion[]               @relation("CompetitionRuleCreator")
  competitionRegistrations         CompetitionRegistration[]              @relation("CompetitionApplicant")
  reviewedCompetitionRegistrations CompetitionRegistration[]              @relation("CompetitionRegistrationReviewer")
  competitionRegistrationHistory   CompetitionRegistrationStatusHistory[] @relation("CompetitionRegistrationActor")
  competitionParticipants          CompetitionParticipant[]               @relation("CompetitionIndividualParticipant")
  submittedMatchResults            MatchResultVersion[]                   @relation("MatchResultSubmitter")
  mutationReceipts                 MutationReceipt[]                      @relation("MutationReceiptActor")
  ownedTeamProfile                 TeamProfile?                           @relation("TeamProfileOwner")
  leagueTeams                      LeagueTeam[]                           @relation("LeagueTeamOwner")
  createdLeagues                   League[]                               @relation("LeagueCreator")
  createdLeagueSeasons             LeagueSeason[]                         @relation("LeagueSeasonCreator")
  seasonEntries                    SeasonEntry[]                          @relation("SeasonEntryOwner")
  reviewedSeasonEntries            SeasonEntry[]                          @relation("SeasonEntryReviewer")
  seasonEntryHistoryActions        SeasonEntryStatusHistory[]             @relation("SeasonEntryStatusActor")
  leagueSeasonHistoryActions       LeagueSeasonStatusHistory[]            @relation("LeagueSeasonStatusActor")
  valuationSubmissions             ValuationSubmission[]                  @relation("ValuationSubmissionSubmitter")
  auditLogs                        AuditLog[]                             @relation("AuditUserActor")
  playerFavorites                  UserPlayerFavorite[]

  @@map("users")
}

model GameAccount {
  id                       String                    @id @default(uuid()) @db.Char(36)
  userId                   String                    @map("user_id") @db.Char(36)
  platform                 GamePlatform
  serverRegion             String                    @map("server_region") @db.VarChar(32)
  gamerTag                 String                    @map("gamer_tag") @db.VarChar(64)
  gameUid                  String?                   @map("game_uid") @db.VarChar(64)
  isDefault                Boolean                   @default(false) @map("is_default")
  verificationStatus       VerificationStatus        @default(UNVERIFIED) @map("verification_status")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  competitionRegistrations CompetitionRegistration[]
  defaultForTeamProfiles   TeamProfile[]
  defaultForLeagueTeams    LeagueTeam[]
  seasonEntries            SeasonEntry[]

  @@unique([platform, serverRegion, gameUid], map: "game_accounts_identity_unique")
  @@index([userId], map: "game_accounts_user_id_idx")
  @@map("game_accounts")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Char(36)
  userId              String    @map("user_id") @db.Char(36)
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  familyId            String    @map("family_id") @db.Char(36)
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Char(36)
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_sessions_user_id_idx")
  @@index([familyId], map: "refresh_sessions_family_id_idx")
  @@map("refresh_sessions")
}

model Role {
  id          String            @id @default(uuid()) @db.Char(36)
  code        String            @unique @db.VarChar(64)
  name        String            @db.VarChar(64)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  permissions RolePermission[]
  bindings    UserRoleBinding[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid()) @db.Char(36)
  code      String           @unique @db.VarChar(128)
  name      String           @db.VarChar(128)
  createdAt DateTime         @default(now()) @map("created_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleBinding {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  roleId      String    @map("role_id") @db.Char(36)
  scopeType   ScopeType @map("scope_type")
  scopeId     String?   @map("scope_id") @db.Char(36)
  startsAt    DateTime  @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  grantedById String?   @map("granted_by_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, scopeType, scopeId], map: "role_bindings_scope_idx")
  @@map("user_role_bindings")
}

model PublicUserNumberSequence {
  key       String   @id @db.VarChar(32)
  nextValue Int      @map("next_value") @db.UnsignedInt
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_user_number_sequences")
}

model AdminAccount {
  id                           String                            @id @default(uuid()) @db.Char(36)
  username                     String                            @unique @db.VarChar(64)
  displayName                  String                            @map("display_name") @db.VarChar(64)
  passwordHash                 String                            @map("password_hash") @db.VarChar(255)
  status                       AdminStatus                       @default(ACTIVE)
  platformRole                 AdminRole?                        @map("platform_role")
  failedLoginCount             Int                               @default(0) @map("failed_login_count") @db.UnsignedInt
  lockedUntil                  DateTime?                         @map("locked_until")
  lastLoginAt                  DateTime?                         @map("last_login_at")
  version                      Int                               @default(1) @db.UnsignedInt
  createdAt                    DateTime                          @default(now()) @map("created_at")
  updatedAt                    DateTime                          @updatedAt @map("updated_at")
  sessions                     AdminSession[]
  leagueRoles                  AdminLeagueRole[]                 @relation("AdminLeagueRoleAdmin")
  grantedLeagueRoles           AdminLeagueRole[]                 @relation("AdminLeagueRoleGrantor")
  auditLogs                    AuditLog[]                        @relation("AuditActor")
  createdLeagues               League[]                          @relation("AdminLeagueCreator")
  createdLeagueSeasons         LeagueSeason[]                    @relation("LeagueSeasonAdminCreator")
  mutationReceipts             AdminMutationReceipt[]
  createdSalaryRules           LeagueSalaryRuleVersion[]
  createdTransferWindows       TransferWindow[]
  rosterTransactions           RosterTransaction[]
  createdValuationWindows      ValuationWindow[]                 @relation("ValuationWindowCreator")
  createdValuationRules        ValuationWindowRuleVersion[]      @relation("ValuationRuleCreator")
  reviewedValuationSubmissions ValuationSubmission[]             @relation("ValuationSubmissionReviewer")
  createdTransactionFeeRules   LeagueTransactionFeeRuleVersion[] @relation("TransactionFeeRuleCreator")
  allocationProposals          SeasonAllocationProposal[]        @relation("AllocationProposalCreator")
  allocationDecisions          SeasonAllocationDecision[]        @relation("AllocationDecisionActor")
  createdCompetitions          Competition[]                     @relation("CompetitionAdminCreator")
  createdCompetitionRules      CompetitionRuleVersion[]          @relation("CompetitionRuleAdminCreator")
  teamShellChanges             LeagueTeamShellHistory[]          @relation("TeamShellHistoryActor")
  teamCatalogSyncRuns          TeamCatalogSyncRun[]              @relation("TeamCatalogSyncActor")
  cupGroupProposals            CupGroupProposal[]                @relation("CupGroupProposalCreator")
  cupBracketProposals          CupBracketProposal[]              @relation("CupBracketProposalCreator")

  @@index([status, username], map: "admin_accounts_status_username_idx")
  @@map("admin_accounts")
}

model AdminSession {
  id                  String       @id @default(uuid()) @db.Char(36)
  adminId             String       @map("admin_id") @db.Char(36)
  tokenHash           String       @unique @map("token_hash") @db.Char(64)
  familyId            String       @map("family_id") @db.Char(36)
  expiresAt           DateTime     @map("expires_at")
  revokedAt           DateTime?    @map("revoked_at")
  replacedBySessionId String?      @map("replaced_by_session_id") @db.Char(36)
  ipAddress           String?      @map("ip_address") @db.VarChar(45)
  userAgent           String?      @map("user_agent") @db.VarChar(512)
  createdAt           DateTime     @default(now()) @map("created_at")
  admin               AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "admin_sessions_admin_id_idx")
  @@index([familyId], map: "admin_sessions_family_id_idx")
  @@map("admin_sessions")
}

model AdminLeagueRole {
  id          String       @id @default(uuid()) @db.Char(36)
  adminId     String       @map("admin_id") @db.Char(36)
  leagueId    String       @map("league_id") @db.Char(36)
  role        AdminRole    @default(LEAGUE_MANAGER)
  grantedById String       @map("granted_by_id") @db.Char(36)
  revokedAt   DateTime?    @map("revoked_at")
  version     Int          @default(1) @db.UnsignedInt
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  admin       AdminAccount @relation("AdminLeagueRoleAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  grantedBy   AdminAccount @relation("AdminLeagueRoleGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([adminId, leagueId, role], map: "admin_league_roles_unique")
  @@index([leagueId, role, revokedAt], map: "admin_league_roles_scope_idx")
  @@index([grantedById], map: "admin_league_roles_grantor_idx")
  @@map("admin_league_roles")
}

model League {
  id                      String                            @id @default(uuid()) @db.Char(36)
  name                    String                            @db.VarChar(64)
  shortName               String                            @map("short_name") @db.VarChar(24)
  description             String                            @default("") @db.VarChar(500)
  logoUrl                 String?                           @map("logo_url") @db.VarChar(2048)
  status                  LeagueStatus                      @default(ACTIVE)
  edition                 LeagueEdition                     @default(INTERNATIONAL)
  currentSeasonId         String?                           @unique @map("current_season_id") @db.Char(36)
  defaultPlatform         GamePlatform                      @map("default_platform")
  defaultServerRegion     String                            @map("default_server_region") @db.VarChar(32)
  defaultSuperCapacity    Int                               @default(23) @map("default_super_capacity") @db.UnsignedSmallInt
  defaultChampionCapacity Int                               @default(18) @map("default_champion_capacity") @db.UnsignedSmallInt
  defaultPromotionCount   Int                               @default(4) @map("default_promotion_count") @db.UnsignedSmallInt
  createdById             String?                           @map("created_by_id") @db.Char(36)
  createdByAdminId        String?                           @map("created_by_admin_id") @db.Char(36)
  version                 Int                               @default(1) @db.UnsignedInt
  createdAt               DateTime                          @default(now()) @map("created_at")
  updatedAt               DateTime                          @updatedAt @map("updated_at")
  creator                 User?                             @relation("LeagueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  adminCreator            AdminAccount?                     @relation("AdminLeagueCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  seasons                 LeagueSeason[]
  currentSeason           LeagueSeason?                     @relation("LeagueCurrentSeason", fields: [currentSeasonId], references: [id], onDelete: SetNull)
  teams                   LeagueTeam[]
  adminRoles              AdminLeagueRole[]
  auditLogs               AuditLog[]
  teamShellHistory        LeagueTeamShellHistory[]
  salaryRuleVersions      LeagueSalaryRuleVersion[]
  playerOwnerships        LeaguePlayerOwnership[]
  rosterTransactions      RosterTransaction[]
  financeLedgerEntries    FinanceLedgerEntry[]
  playerValuations        LeaguePlayerValuation[]
  playerValuationHistory  PlayerValuationHistory[]
  transactionFeeRules     LeagueTransactionFeeRuleVersion[]

  @@index([status, createdAt, id], map: "leagues_public_list_idx")
  @@index([createdById], map: "leagues_creator_idx")
  @@index([createdByAdminId], map: "leagues_admin_creator_idx")
  @@map("leagues")
}

model TeamProfile {
  id                   String            @id @default(uuid()) @db.Char(36)
  ownerUserId          String            @unique @map("owner_user_id") @db.Char(36)
  name                 String            @db.VarChar(64)
  shortName            String            @map("short_name") @db.VarChar(24)
  logoUrl              String?           @map("logo_url") @db.VarChar(2048)
  defaultGameAccountId String?           @map("default_game_account_id") @db.Char(36)
  status               TeamProfileStatus @default(ACTIVE)
  version              Int               @default(1) @db.UnsignedInt
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  owner                User              @relation("TeamProfileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  defaultGameAccount   GameAccount?      @relation(fields: [defaultGameAccountId], references: [id], onDelete: SetNull)
  seasonEntries        SeasonEntry[]

  @@index([defaultGameAccountId], map: "team_profiles_default_account_idx")
  @@map("team_profiles")
}

model LeagueTeam {
  id                         String                    @id @default(uuid()) @db.Char(36)
  leagueId                   String                    @map("league_id") @db.Char(36)
  ownerUserId                String                    @map("owner_user_id") @db.Char(36)
  ownerAlias                 String                    @map("owner_alias") @db.VarChar(32)
  catalogTeamId              String                    @map("catalog_team_id") @db.Char(36)
  teamNumber                 Int?                      @map("team_number") @db.UnsignedSmallInt
  name                       String                    @db.VarChar(64)
  shortName                  String                    @map("short_name") @db.VarChar(24)
  logoUrl                    String?                   @map("logo_url") @db.VarChar(2048)
  defaultGameAccountId       String?                   @map("default_game_account_id") @db.Char(36)
  status                     LeagueTeamStatus          @default(ACTIVE)
  rosterStatus               LeagueTeamRosterStatus    @default(COMPLIANT) @map("roster_status")
  shellValueMinor            Int                       @default(0) @map("shell_value_minor") @db.UnsignedInt
  version                    Int                       @default(1) @db.UnsignedInt
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  league                     League                    @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  owner                      User                      @relation("LeagueTeamOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  catalogTeam                TeamCatalogItem           @relation(fields: [catalogTeamId], references: [id], onDelete: Restrict)
  defaultGameAccount         GameAccount?              @relation(fields: [defaultGameAccountId], references: [id], onDelete: SetNull)
  seasonEntries              SeasonEntry[]
  playerOwnerships           LeaguePlayerOwnership[]
  outgoingRosterTransactions RosterTransaction[]       @relation("RosterTransactionSourceTeam")
  incomingRosterTransactions RosterTransaction[]       @relation("RosterTransactionTargetTeam")
  financeLedgerEntries       FinanceLedgerEntry[]
  valuationSnapshots         ValuationRosterSnapshot[]
  valuationSubmissions       ValuationSubmission[]
  shellHistory               LeagueTeamShellHistory[]  @relation("ShellHistoryTeam")
  relatedShellHistory        LeagueTeamShellHistory[]  @relation("ShellHistoryRelatedTeam")

  @@unique([leagueId, ownerUserId], map: "league_teams_owner_unique")
  @@unique([leagueId, teamNumber], map: "league_teams_number_unique")
  @@unique([leagueId, catalogTeamId], map: "league_teams_catalog_unique")
  @@index([catalogTeamId], map: "league_teams_catalog_idx")
  @@index([defaultGameAccountId], map: "league_teams_default_account_idx")
  @@index([leagueId, status, createdAt], map: "league_teams_status_idx")
  @@map("league_teams")
}

model TeamCatalogItem {
  id                     String                   @id @default(uuid()) @db.Char(36)
  sourceType             TeamCatalogSourceType    @map("source_type")
  sourceExternalId       String?                  @map("source_external_id") @db.VarChar(128)
  sourceLeagueExternalId String?                  @map("source_league_external_id") @db.VarChar(128)
  sourceLeagueName       String?                  @map("source_league_name") @db.VarChar(128)
  nameZh                 String?                  @map("name_zh") @db.VarChar(64)
  nameEn                 String?                  @map("name_en") @db.VarChar(64)
  nameJa                 String?                  @map("name_ja") @db.VarChar(64)
  shortName              String                   @map("short_name") @db.VarChar(24)
  remoteLogoUrl          String?                  @map("remote_logo_url") @db.VarChar(2048)
  storedLogoUrl          String?                  @map("stored_logo_url") @db.VarChar(2048)
  logoChecksum           String?                  @map("logo_checksum") @db.Char(64)
  sourceChecksum         String?                  @map("source_checksum") @db.Char(64)
  status                 TeamCatalogStatus        @default(ACTIVE)
  sourceUpdatedAt        DateTime?                @map("source_updated_at")
  lastSyncedAt           DateTime?                @map("last_synced_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  leagueTeams            LeagueTeam[]
  historyFrom            LeagueTeamShellHistory[] @relation("ShellHistoryFromCatalog")
  historyTo              LeagueTeamShellHistory[] @relation("ShellHistoryToCatalog")
  syncItems              TeamCatalogSyncItem[]    @relation("TeamCatalogSyncCurrentItem")

  @@unique([sourceType, sourceExternalId], map: "team_catalog_source_external_unique")
  @@index([status, sourceLeagueName, nameZh], map: "team_catalog_browse_idx")
  @@map("team_catalog_items")
}

model LeagueTeamShellHistory {
  id                  String              @id @default(uuid()) @db.Char(36)
  leagueId            String              @map("league_id") @db.Char(36)
  leagueTeamId        String              @map("league_team_id") @db.Char(36)
  relatedLeagueTeamId String?             @map("related_league_team_id") @db.Char(36)
  changeType          TeamShellChangeType @map("change_type")
  fromCatalogTeamId   String?             @map("from_catalog_team_id") @db.Char(36)
  toCatalogTeamId     String              @map("to_catalog_team_id") @db.Char(36)
  actorAdminId        String              @map("actor_admin_id") @db.Char(36)
  reason              String?             @db.VarChar(512)
  createdAt           DateTime            @default(now()) @map("created_at")
  league              League              @relation(fields: [leagueId], references: [id], onDelete: Restrict)
