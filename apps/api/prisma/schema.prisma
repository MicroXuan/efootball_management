generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GamePlatform {
  MOBILE
  PLAYSTATION
  XBOX
  STEAM
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ScopeType {
  PLATFORM
  ORGANIZATION
  COMPETITION
  TEAM
}

enum ImportSourceType {
  MANUAL
  API
}

enum PlayerPosition {
  GK
  CB
  LB
  RB
  DMF
  CMF
  LMF
  RMF
  AMF
  LWF
  RWF
  SS
  CF
}

enum PlayerCardType {
  STANDARD
  FEATURED
  TRENDING
  HIGHLIGHT
  EPIC
  BIG_TIME
  OTHER
}

enum PlayerCardStatus {
  ACTIVE
  INACTIVE
}

enum ImportFormat {
  CSV
  JSON
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  READY
  PUBLISHED
  FAILED
  CANCELLED
}

enum ImportDiffType {
  CREATE
  UPDATE
  UNCHANGED
  INVALID
}

enum ExternalSyncMode {
  SAMPLE
  FULL
  INCREMENTAL
}

enum ExternalSyncStatus {
  PENDING
  RUNNING
  READY
  PAUSED
  FAILED
}

enum ExternalSyncItemStatus {
  PENDING
  FETCHED
  SKIPPED
  FAILED
}

model User {
  id               String            @id @default(uuid()) @db.Char(36)
  wechatOpenId     String            @unique @map("wechat_open_id") @db.VarChar(128)
  wechatUnionId    String?           @unique @map("wechat_union_id") @db.VarChar(128)
  displayName      String            @map("display_name") @db.VarChar(32)
  avatarUrl        String?           @map("avatar_url") @db.VarChar(2048)
  region           String?           @db.VarChar(64)
  status           UserStatus        @default(ACTIVE)
  agreementVersion String?           @map("agreement_version") @db.VarChar(32)
  privacyConsentAt DateTime?         @map("privacy_consent_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  gameAccounts     GameAccount[]
  refreshSessions  RefreshSession[]
  roleBindings     UserRoleBinding[]

  @@map("users")
}

model GameAccount {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @map("user_id") @db.Char(36)
  platform           GamePlatform
  serverRegion       String             @map("server_region") @db.VarChar(32)
  gamerTag           String             @map("gamer_tag") @db.VarChar(64)
  gameUid            String?            @map("game_uid") @db.VarChar(64)
  isDefault          Boolean            @default(false) @map("is_default")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([platform, serverRegion, gameUid], map: "game_accounts_identity_unique")
  @@index([userId], map: "game_accounts_user_id_idx")
  @@map("game_accounts")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Char(36)
  userId              String    @map("user_id") @db.Char(36)
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  familyId            String    @map("family_id") @db.Char(36)
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Char(36)
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  userAgent           String?   @map("user_agent") @db.VarChar(512)
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_sessions_user_id_idx")
  @@index([familyId], map: "refresh_sessions_family_id_idx")
  @@map("refresh_sessions")
}

model Role {
  id          String            @id @default(uuid()) @db.Char(36)
  code        String            @unique @db.VarChar(64)
  name        String            @db.VarChar(64)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  permissions RolePermission[]
  bindings    UserRoleBinding[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid()) @db.Char(36)
  code      String           @unique @db.VarChar(128)
  name      String           @db.VarChar(128)
  createdAt DateTime         @default(now()) @map("created_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleBinding {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  roleId      String    @map("role_id") @db.Char(36)
  scopeType   ScopeType @map("scope_type")
  scopeId     String?   @map("scope_id") @db.Char(36)
  startsAt    DateTime  @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  grantedById String?   @map("granted_by_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, scopeType, scopeId], map: "role_bindings_scope_idx")
  @@map("user_role_bindings")
}

model DataSource {
  id        String                 @id @default(uuid()) @db.Char(36)
  code      String                 @unique @db.VarChar(64)
  name      String                 @db.VarChar(128)
  type      ImportSourceType       @default(MANUAL)
  isEnabled Boolean                @default(true) @map("is_enabled")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  batches   ImportBatch[]
  cards     PlayerCard[]
  packs     CardPack[]
  players   FootballPlayerSource[]
  syncRuns  ExternalSyncRun[]

  @@map("data_sources")
}

model FootballPlayer {
  id                           String                 @id @default(uuid()) @db.Char(36)
  nameZh                       String?                @map("name_zh") @db.VarChar(128)
  nameEn                       String?                @map("name_en") @db.VarChar(128)
  normalizedNameZh             String?                @map("normalized_name_zh") @db.VarChar(128)
  normalizedNameEn             String?                @map("normalized_name_en") @db.VarChar(128)
  shortName                    String?                @map("short_name") @db.VarChar(64)
  nationality                  String?                @db.VarChar(64)
  club                         String?                @db.VarChar(128)
  publishedAt                  DateTime?              @map("published_at")
  lastPublishedReleaseSequence Int?                   @map("last_published_release_sequence")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")
  sources                      FootballPlayerSource[]
  cards                        PlayerCard[]
  importRecords                ImportRecord[]

  @@index([normalizedNameZh], map: "football_players_name_zh_idx")
  @@index([normalizedNameEn], map: "football_players_name_en_idx")
  @@index([publishedAt], map: "football_players_published_at_idx")
  @@map("football_players")
}

model FootballPlayerSource {
  id              String         @id @default(uuid()) @db.Char(36)
  playerId        String         @map("player_id") @db.Char(36)
  sourceId        String         @map("source_id") @db.Char(36)
  externalId      String         @map("external_id") @db.VarChar(128)
  sourceUpdatedAt DateTime?      @map("source_updated_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  player          FootballPlayer @relation(fields: [playerId], references: [id], onDelete: Restrict)
  source          DataSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId], map: "football_player_sources_identity_unique")
  @@index([playerId], map: "football_player_sources_player_idx")
  @@map("football_player_sources")
}

model CardPack {
  id                           String           @id @default(uuid()) @db.Char(36)
  sourceId                     String           @map("source_id") @db.Char(36)
  externalId                   String           @map("external_id") @db.VarChar(128)
  nameZh                       String?          @map("name_zh") @db.VarChar(128)
  nameEn                       String?          @map("name_en") @db.VarChar(128)
  season                       String?          @db.VarChar(32)
  releaseDate                  DateTime?        @map("release_date") @db.Date
  coverUrl                     String?          @map("cover_url") @db.VarChar(2048)
  status                       PlayerCardStatus @default(ACTIVE)
  publishedAt                  DateTime?        @map("published_at")
  lastPublishedReleaseSequence Int?             @map("last_published_release_sequence")
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @updatedAt @map("updated_at")
  source                       DataSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  cards                        PlayerCard[]

  @@unique([sourceId, externalId], map: "card_packs_identity_unique")
  @@index([publishedAt, status], map: "card_packs_published_status_idx")
  @@map("card_packs")
}

model PlayerCard {
  id                           String               @id @default(uuid()) @db.Char(36)
  sourceId                     String               @map("source_id") @db.Char(36)
  externalId                   String               @map("external_id") @db.VarChar(128)
  playerId                     String               @map("player_id") @db.Char(36)
  cardPackId                   String?              @map("card_pack_id") @db.Char(36)
  cardName                     String               @map("card_name") @db.VarChar(128)
  position                     PlayerPosition
  overallRating                Int                  @map("overall_rating") @db.UnsignedTinyInt
  cardType                     PlayerCardType       @map("card_type")
  playStyle                    String?              @map("play_style") @db.VarChar(128)
  status                       PlayerCardStatus     @default(ACTIVE)
  imageUrl                     String?              @map("image_url") @db.VarChar(2048)
  sourceUpdatedAt              DateTime?            @map("source_updated_at")
  publishedAt                  DateTime?            @map("published_at")
  lastPublishedReleaseSequence Int?                 @map("last_published_release_sequence")
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")
  source                       DataSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  player                       FootballPlayer       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  cardPack                     CardPack?            @relation(fields: [cardPackId], references: [id], onDelete: SetNull)
  attributes                   PlayerCardAttribute?
  skills                       PlayerCardSkill[]
  versions                     PlayerCardVersion[]
  importRecords                ImportRecord[]

  @@unique([sourceId, externalId], map: "player_cards_identity_unique")
  @@index([position, cardType, overallRating], map: "player_cards_filter_idx")
  @@index([cardPackId], map: "player_cards_pack_idx")
  @@index([publishedAt, status], map: "player_cards_published_status_idx")
  @@map("player_cards")
}

model PlayerCardAttribute {
  id             String     @id @default(uuid()) @db.Char(36)
  playerCardId   String     @unique @map("player_card_id") @db.Char(36)
  attributesJson Json       @map("attributes_json")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  playerCard     PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)

  @@map("player_card_attributes")
}

model Skill {
  id        String            @id @default(uuid()) @db.Char(36)
  code      String            @unique @db.VarChar(128)
  nameZh    String?           @map("name_zh") @db.VarChar(128)
  nameEn    String?           @map("name_en") @db.VarChar(128)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  cards     PlayerCardSkill[]

  @@map("skills")
}

model PlayerCardSkill {
  playerCardId String     @map("player_card_id") @db.Char(36)
  skillId      String     @map("skill_id") @db.Char(36)
  playerCard   PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([playerCardId, skillId])
  @@map("player_card_skills")
}

model ImportBatch {
  id             String                 @id @default(uuid()) @db.Char(36)
  sourceId       String                 @map("source_id") @db.Char(36)
  fileName       String                 @map("file_name") @db.VarChar(255)
  format         ImportFormat
  checksum       String                 @db.Char(64)
  status         ImportBatchStatus      @default(UPLOADED)
  totalCount     Int                    @default(0) @map("total_count")
  createCount    Int                    @default(0) @map("create_count")
  updateCount    Int                    @default(0) @map("update_count")
  unchangedCount Int                    @default(0) @map("unchanged_count")
  invalidCount   Int                    @default(0) @map("invalid_count")
  failureReason  String?                @map("failure_reason") @db.VarChar(512)
  createdBy      String                 @map("created_by") @db.Char(36)
  publishedAt    DateTime?              @map("published_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  source         DataSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  records        ImportRecord[]
  release        CatalogRelease?
  syncRunLinks   ExternalSyncRunBatch[]

  @@unique([sourceId, checksum], map: "import_batches_source_checksum_unique")
  @@index([status, createdAt], map: "import_batches_status_created_idx")
  @@map("import_batches")
}

model ExternalSyncRun {
  id             String                 @id @default(uuid()) @db.Char(36)
  sourceId       String                 @map("source_id") @db.Char(36)
  actorId        String                 @map("actor_id") @db.Char(36)
  mode           ExternalSyncMode
  status         ExternalSyncStatus     @default(PENDING)
  activeLeaseKey String?                @unique @map("active_lease_key") @db.VarChar(64)
  requestedLimit Int?                   @map("requested_limit") @db.UnsignedInt
  sourceTotal    Int?                   @map("source_total") @db.UnsignedInt
  scannedCount   Int                    @default(0) @map("scanned_count") @db.UnsignedInt
  fetchedCount   Int                    @default(0) @map("fetched_count") @db.UnsignedInt
  skippedCount   Int                    @default(0) @map("skipped_count") @db.UnsignedInt
  failedCount    Int                    @default(0) @map("failed_count") @db.UnsignedInt
  currentOffset  Int                    @default(0) @map("current_offset") @db.UnsignedInt
  errorCode      String?                @map("error_code") @db.VarChar(64)
  errorMessage   String?                @map("error_message") @db.VarChar(512)
  startedAt      DateTime?              @map("started_at")
  finishedAt     DateTime?              @map("finished_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  source         DataSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  items          ExternalSyncItem[]
  batchLinks     ExternalSyncRunBatch[]

  @@index([sourceId, status, createdAt], map: "external_sync_runs_source_status_idx")
  @@index([actorId], map: "external_sync_runs_actor_idx")
  @@map("external_sync_runs")
}

model ExternalSyncItem {
  id              String                 @id @default(uuid()) @db.Char(36)
  runId           String                 @map("run_id") @db.Char(36)
  externalId      String                 @map("external_id") @db.VarChar(128)
  summaryChecksum String                 @map("summary_checksum") @db.Char(64)
  detailChecksum  String?                @map("detail_checksum") @db.Char(64)
  status          ExternalSyncItemStatus @default(PENDING)
  rawDetail       Json?                  @map("raw_detail")
  normalizedJson  Json?                  @map("normalized_json")
  attempts        Int                    @default(0) @db.UnsignedSmallInt
  lastError       String?                @map("last_error") @db.VarChar(512)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  run             ExternalSyncRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, externalId], map: "external_sync_items_run_external_unique")
  @@index([runId, status], map: "external_sync_items_run_status_idx")
  @@index([externalId, updatedAt], map: "external_sync_items_external_updated_idx")
  @@map("external_sync_items")
}

model ExternalSyncRunBatch {
  runId      String          @map("run_id") @db.Char(36)
  batchId    String          @map("batch_id") @db.Char(36)
  chunkIndex Int             @map("chunk_index") @db.UnsignedInt
  createdAt  DateTime        @default(now()) @map("created_at")
  run        ExternalSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  batch      ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([runId, batchId])
  @@unique([runId, chunkIndex], map: "external_sync_run_batches_chunk_unique")
  @@index([batchId], map: "external_sync_run_batches_batch_idx")
  @@map("external_sync_run_batches")
}

model ImportRecord {
  id               String          @id @default(uuid()) @db.Char(36)
  batchId          String          @map("batch_id") @db.Char(36)
  rowNumber        Int             @map("row_number")
  externalId       String?         @map("external_id") @db.VarChar(128)
  contentChecksum  String?         @map("content_checksum") @db.Char(64)
  rawJson          Json            @map("raw_json")
  normalizedJson   Json?           @map("normalized_json")
  diffType         ImportDiffType  @map("diff_type")
  fieldDiff        Json            @map("field_diff")
  validationErrors Json            @map("validation_errors")
  targetPlayerId   String?         @map("target_player_id") @db.Char(36)
  targetCardId     String?         @map("target_card_id") @db.Char(36)
  createdAt        DateTime        @default(now()) @map("created_at")
  batch            ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  targetPlayer     FootballPlayer? @relation(fields: [targetPlayerId], references: [id], onDelete: SetNull)
  targetCard       PlayerCard?     @relation(fields: [targetCardId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber], map: "import_records_batch_row_unique")
  @@index([batchId, diffType], map: "import_records_batch_diff_idx")
  @@index([targetPlayerId], map: "import_records_target_player_idx")
  @@index([targetCardId], map: "import_records_target_card_idx")
  @@map("import_records")
}

model CatalogRelease {
  id             String              @id @default(uuid()) @db.Char(36)
  sequence       Int                 @unique @default(autoincrement())
  batchId        String              @unique @map("batch_id") @db.Char(36)
  publishedBy    String              @map("published_by") @db.Char(36)
  createdCount   Int                 @map("created_count")
  updatedCount   Int                 @map("updated_count")
  unchangedCount Int                 @map("unchanged_count")
  publishedAt    DateTime            @default(now()) @map("published_at")
  batch          ImportBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  cardVersions   PlayerCardVersion[]

  @@map("catalog_releases")
}

model PlayerCardVersion {
  id               String           @id @default(uuid()) @db.Char(36)
  playerCardId     String           @map("player_card_id") @db.Char(36)
  releaseSequence  Int              @map("release_sequence")
  playerId         String           @map("player_id") @db.Char(36)
  playerNameZh     String?          @map("player_name_zh") @db.VarChar(128)
  playerNameEn     String?          @map("player_name_en") @db.VarChar(128)
  normalizedNameZh String?          @map("normalized_name_zh") @db.VarChar(128)
  normalizedNameEn String?          @map("normalized_name_en") @db.VarChar(128)
  playerShortName  String?          @map("player_short_name") @db.VarChar(64)
  nationality      String?          @db.VarChar(64)
  club             String?          @db.VarChar(128)
  cardPackId       String?          @map("card_pack_id") @db.Char(36)
  packNameZh       String?          @map("pack_name_zh") @db.VarChar(128)
  packNameEn       String?          @map("pack_name_en") @db.VarChar(128)
  packSeason       String?          @map("pack_season") @db.VarChar(32)
  packReleaseDate  DateTime?        @map("pack_release_date") @db.Date
  packCoverUrl     String?          @map("pack_cover_url") @db.VarChar(2048)
  cardName         String           @map("card_name") @db.VarChar(128)
  position         PlayerPosition
  overallRating    Int              @map("overall_rating") @db.UnsignedTinyInt
  cardType         PlayerCardType   @map("card_type")
  playStyle        String?          @map("play_style") @db.VarChar(128)
  status           PlayerCardStatus
  imageUrl         String?          @map("image_url") @db.VarChar(2048)
  sourceUpdatedAt  DateTime?        @map("source_updated_at")
  skillsJson       Json             @map("skills_json")
  attributesJson   Json             @map("attributes_json")
  publishedAt      DateTime         @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  playerCard       PlayerCard       @relation(fields: [playerCardId], references: [id], onDelete: Cascade)
  release          CatalogRelease   @relation(fields: [releaseSequence], references: [sequence], onDelete: Restrict)

  @@unique([playerCardId, releaseSequence], map: "player_card_versions_card_release_unique")
  @@index([releaseSequence, status], map: "player_card_versions_release_status_idx")
  @@index([position, cardType, overallRating], map: "player_card_versions_filter_idx")
  @@index([normalizedNameZh], map: "player_card_versions_name_zh_idx")
  @@index([normalizedNameEn], map: "player_card_versions_name_en_idx")
  @@map("player_card_versions")
}
