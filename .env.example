NODE_ENV=development
PORT=3000
# 本地 Docker MySQL；生产环境请替换为 CloudBase MySQL 内网连接串。
DATABASE_URL=mysql://efm:efm_local@127.0.0.1:3307/efootball_management
# 分别执行 `openssl rand -hex 32` 生成，两个值必须不同且不可提交。
JWT_ACCESS_SECRET=replace-with-a-random-64-character-hex-value
REFRESH_TOKEN_PEPPER=replace-with-another-random-64-character-hex-value
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
# 本地使用 fake；预发和生产必须使用 http。
WECHAT_GATEWAY_MODE=fake
